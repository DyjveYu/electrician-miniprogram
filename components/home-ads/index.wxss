.home-ads { box-sizing: border-box; width: 100%; padding: 8rpx 44rpx 16rpx; background: #fff; }
.ad-label { margin-bottom: 20rpx; color: #687a71; font-size: 22rpx; line-height: 1.5; }
.icons { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 32rpx; }
.icon-ad { flex: 1 1 0; min-width: 0; max-width: 150rpx; height: 150rpx; border-radius: 24rpx; background: #eff7f1; overflow: hidden; }
.icon-ad image { display: block; width: 100%; height: 100%; border-radius: 24rpx; }
.banner { width: 100%; background: #eff7f1; border-radius: 26rpx; overflow: hidden; }
.banner image { display: block; width: 100%; height: auto; border-radius: 26rpx; }
.error { color: #b74434; text-align: center; padding: 16rpx; font-size: 24rpx; }
