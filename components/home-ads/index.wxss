.home-ads { box-sizing: border-box; width: 100%; padding: 8rpx 44rpx 16rpx; background: #fff; }
.icons { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; margin-bottom: 24rpx; }
.icon-ad { min-width: 0; aspect-ratio: 1; border-radius: 24rpx; background: #eff7f1; overflow: hidden; }
.icon-ad image { display: block; width: 100%; height: 100%; border-radius: 24rpx; }
.banner { width: 100%; height: 265rpx; background: #eff7f1; border-radius: 26rpx; overflow: hidden; }
.banner image { display: block; width: 100%; height: 100%; }
.error { color: #b74434; text-align: center; padding: 16rpx; font-size: 24rpx; }
