.home-ads { box-sizing: border-box; width: 100%; padding: 24rpx 30rpx; }
.icons { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.icon-ad { width: 150rpx; height: 150rpx; flex-shrink: 0; }
.icon-ad image { width: 100%; height: 100%; border-radius: 16rpx; }
.banner { width: 100%; }
.banner image { display: block; width: 100%; height: auto; border-radius: 16rpx; }
.error { color: #666; text-align: center; padding: 16rpx; font-size: 24rpx; }
