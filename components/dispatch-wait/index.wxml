<view wx:if="{{order.dispatch_wait && (!order.dispatch_wait.finishedReason || reasonLabel || refundLabel)}}" class="{{detailCard ? 'card wait-detail-card' : 'wait-card'}}">
  <view wx:if="{{detailCard}}" class="section-title">等待接单与退款</view>
  <view wx:if="{{reasonLabel}}" class="wait-copy">{{reasonLabel}}</view>
  <block wx:else>
    <view class="wait-copy">当前推荐范围：{{order.dispatch_wait.region}}</view>
    <view wx:if="{{order.dispatch_wait.choiceStage}}" class="wait-copy">已等待{{order.dispatch_wait.choiceStage}}分钟，暂未有电工接单，系统会继续推荐。</view>
    <view wx:if="{{deadline}}" class="wait-copy">若到 {{deadline}} 仍无人接单，系统将取消并发起原路退款。</view>
  </block>
  <view wx:if="{{refundLabel}}" class="wait-copy">{{refundLabel}} · ¥{{order.dispatch_wait.amount}}</view>
</view>
