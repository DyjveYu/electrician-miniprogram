.content-entry-shell { box-sizing: border-box; background: #fff; padding: 0 44rpx; }
.content-entry { box-sizing: border-box; display: flex; align-items: center; gap: 24rpx; min-height: 140rpx; padding: 32rpx 0; background: #fff; color: #172d25; }
.entry-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #eff7f1; border-radius: 24rpx; }
.entry-icon image { width: 36rpx; height: 36rpx; }
.entry-copy { flex: 1; min-width: 0; font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.entry-arrow { flex-shrink: 0; color: #687a71; font-size: 34rpx; font-weight: 400; }
.content-entry-shell { border-bottom: 18rpx solid #f5f7f5; }
