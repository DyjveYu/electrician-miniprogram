@import "../../styles/order-detail-cards.wxss";
.card { margin: 0 0 20rpx; padding: 28rpx; background: white; border-radius: 18rpx; line-height: 1.7; }
.head { font-size: 32rpx; font-weight: 600; }
textarea, input { margin: 18rpx 0; padding: 12rpx; background: #f5f7f6; }
button { margin-top: 16rpx; color: #16835c; }
.owner-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 16rpx; }
.owner-fee { box-sizing: border-box; width: 100%; margin: 0; padding: 12rpx; background: #f5f7f6; }
