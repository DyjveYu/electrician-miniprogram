<view class="notice-board">
  <view class="heading">信息栏</view>
  <view class="notice-viewport">
    <view class="notice-track {{transitioning ? 'is-moving' : ''}}">
      <view class="notice-group">
        <view wx:for="{{group}}" wx:key="id" class="notice-title" bindtap="openNotice" data-id="{{item.id}}">{{item.title}}</view>
      </view>
      <view class="notice-group" aria-hidden="true">
        <view wx:for="{{nextGroup}}" wx:key="id" class="notice-title">{{item.title}}</view>
      </view>
    </view>
    <view wx:if="{{!group.length}}" class="state">{{loading ? '加载中...' : (error ? '' : '暂无通知')}}</view>
  </view>
  <view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 点击重试</view>
</view>
