@import "./styles/clean-page.wxss";
/**app.wxss**/
/* 全局样式 */

/* 重置样式 * {
  box-sizing: border-box;
}*/


page {
  background: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'Segoe UI', Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #172d25;
}

/* 容器样式 */
.container {
  padding: 32rpx 44rpx 48rpx;
}

.page-container {
  min-height: 100vh;
  background-color: #fff;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 16rpx;
}

.card-content {
  color: #687a71;
  line-height: 1.5;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: none;
}

.btn-primary {
  background: #16835c;
  color: #ffffff;
}

.btn-primary:hover {
  filter: brightness(1.06);
}

.btn-secondary {
  background-color: #f5f7f5;
  color: #687a71;
  border: 1rpx solid #e9efeb;
}

.btn-secondary:hover {
  background-color: #e9efeb;
}

.btn-success {
  background: #16835c;
  color: #ffffff;
}

.btn-warning {
  background-color: #faf4e9;
  color: #172d25;
}

.btn-danger {
  background-color: #faf0ed;
  color: #172d25;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.btn-large {
  padding: 28rpx 40rpx;
  font-size: 32rpx;
}

.btn-block {
  width: 100%;
  display: block;
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 表单样式 */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #172d25;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid #e9efeb;
  border-radius: 22rpx;
  font-size: 28rpx;
  background-color: #fff;
}

.form-input:focus {
  border-color: #16835c;
  outline: none;
}

.form-textarea {
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid #e9efeb;
  border-radius: 22rpx;
  font-size: 28rpx;
  background-color: #fff;
  min-height: 120rpx;
  resize: vertical;
}

.form-error {
  color: #b74434;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 列表样式 */
.list {
  background-color: #fff;
  border-radius: 22rpx;
  overflow: hidden;
}

.list-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #e9efeb;
  display: flex;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  color: #172d25;
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 26rpx;
  color: #687a71;
}

.list-item-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 16rpx;
}

/* 状态样式 */
.status {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-pending {
  background-color: #faf4e9;
  color: #956321;
}

.status-accepted {
  background-color: #eff7f1;
  color: #16835c;
}

.status-in_progress {
  background-color: #eff7f1;
  color: #16835c;
}

.status-completed {
  background-color: #eff7f1;
  color: #16835c;
}

.status-cancelled {
  background-color: #faf0ed;
  color: #b74434;
}

/* 展示层状态（派生） */
.status-prepay_pending { background-color: #eff7f1; color: #16835c; }
.status-waiting_accept { background-color: #faf4e9; color: #956321; }
.status-repair_pay_pending { background-color: #eff7f1; color: #16835c; }
.status-pending_review { background-color: #faf4e9; color: #956321; }
.status-closed { background-color: #faf0ed; color: #b74434; }
.status-cancel_pending { background-color: #faf0ed; color: #b74434; }

/* 工具类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: #16835c;
}

/* 毛玻璃效果容器（用于自定义底部栏或浮层）*/
.glass {
  background-color: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(8px);
}

.text-success {
  color: #16835c;
}

.text-warning {
  color: #956321;
}

.text-danger {
  color: #b74434;
}

.text-muted {
  color: #687a71;
}

.text-small {
  font-size: 24rpx;
}

.text-large {
  font-size: 32rpx;
}

.font-bold {
  font-weight: 600;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

.pt-10 { padding-top: 10rpx; }
.pt-20 { padding-top: 20rpx; }
.pb-10 { padding-bottom: 10rpx; }
.pb-20 { padding-bottom: 20rpx; }
.pl-10 { padding-left: 10rpx; }
.pl-20 { padding-left: 20rpx; }
.pr-10 { padding-right: 10rpx; }
.pr-20 { padding-right: 20rpx; }

/* 布局 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-around {
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.align-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

/* 隐藏/显示 */
.hidden {
  display: none;
}

.visible {
  display: block;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #687a71;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #687a71;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #e9efeb;
  margin: 20rpx 0;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
}

.avatar-small {
  width: 60rpx;
  height: 60rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background-color: #f5f7f5;
  color: #687a71;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-primary {
  background-color: #eff7f1;
  color: #16835c;
}

.tag-success {
  background-color: #eff7f1;
  color: #16835c;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: #16835c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  z-index: 1000;
}

.fab-icon {
  width: 48rpx;
  height: 48rpx;
}
