@import "./clean-surfaces.wxss";
/* pages/order/detail/detail.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.content-wrapper {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  border-radius: 22rpx;
  box-shadow: none;
  margin-bottom: 20rpx;
}

/* 订单状态 */
.status-section {
  background-color: #fff;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 30rpx;
}

.status-icon.pending {
  background-color: #faf4e9;
}

.status-icon.in_progress {
  background-color: #eff7f1;
}

.status-icon.pending_payment {
  background-color: #faf0ed;
}

.status-icon.completed {
  background-color: #eff7f1;
}

.status-text {
  flex: 1;
}

.status-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #687a71;
}

.status-electrician {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 24rpx;
  color: #687a71;
}
.status-electrician-label {
  font-size: 24rpx;
  color: #172d25;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.status-electrician-name {
  font-size: 26rpx;
  color: #172d25;
}

/* 通用section */
.section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e9efeb;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #687a71;
  width: 200rpx;
  flex-shrink: 0;
}

.value {
  color: #172d25;
  flex: 1;
}

.value.amount {
  color: #16835c;
  font-weight: 600;
  font-size: 32rpx;
}

/* 问题描述 */
.description {
  font-size: 28rpx;
  color: #172d25;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 图片相关 */
.images, .work-images-display {
  margin-top: 20rpx;
}

.image-title {
  font-size: 26rpx;
  color: #687a71;
  margin-bottom: 15rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 22rpx;
  overflow: hidden;
}

/* 地址信息 */
.address-info {
  padding: 20rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.contact-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
  margin-right: 30rpx;
}

.contact-phone {
  font-size: 28rpx;
  color: #16835c;
}

.address-detail {
  font-size: 26rpx;
  color: #687a71;
  line-height: 1.4;
}

/* 电工信息 */
.electrician-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
}

.electrician-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}

.electrician-avatar image {
  width: 100%;
  height: 100%;
}

.electrician-details {
  flex: 1;
}

.electrician-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 10rpx;
}

.electrician-phone {
  font-size: 26rpx;
  color: #16835c;
  margin-bottom: 10rpx;
}

.electrician-rating {
  font-size: 24rpx;
  color: #687a71;
}

/* 维修内容表单 */
.work-form {
  border-top: 2rpx solid #e9efeb;
  padding-top: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #172d25;
  margin-bottom: 15rpx;
}

.form-value {
  font-size: 28rpx;
  color: #172d25;
  line-height: 1.6;
  white-space: pre-line;
}

.work-content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e9efeb;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background-color: #f5f7f5;
  box-sizing: border-box; /* 关键：让padding和border包含在宽度内 */
}

.work-images {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.work-image-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 22rpx;
  overflow: hidden;
}

.work-image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.add-work-image-btn {
  width: 150rpx;
  height: auto;
  border: 2rpx dashed #e9efeb;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f7f5;
}

.add-icon {
  font-size: 40rpx;
  color: #687a71;
}

.amount-input {
  flex: 1;
  padding: 15rpx 20rpx;
  border: 2rpx solid #e9efeb;
  border-radius: 22rpx;
  font-size: 28rpx;
  background-color: #f5f7f5;
  margin-right: 10rpx;
}

.amount-unit {
  font-size: 28rpx;
  color: #687a71;
}

/* 维修内容显示 */
.work-content {
  padding: 20rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
}

.work-text {
  font-size: 28rpx;
  color: #172d25;
  line-height: 1.6;
}

.no-work-content {
  text-align: center;
  padding: 40rpx 0;
  color: #687a71;
  font-size: 26rpx;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: #e9efeb;
}

.timeline-item {
  position: relative;
  margin-bottom: 30rpx;
}

.timeline-dot {
  position: absolute;
  left: -25rpx;
  top: 5rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: #16835c;
  border-radius: 50%;
}

.timeline-content {
  padding-left: 20rpx;
}

.timeline-title {
  font-size: 28rpx;
  color: #172d25;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #687a71;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #e9efeb;
  z-index: 1001;
  padding-bottom: env(safe-area-inset-bottom);
}

.bottom-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  flex-wrap: nowrap;
}

/* 客服按钮 */
.service-btn {
  min-width: 120rpx;
  height: auto;
  border-radius: 22rpx;
  font-size: 30rpx;
  border: none; /* 去掉真实边框 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 24rpx;
  margin-left: auto;
  margin-right: 32rpx;
  background: transparent;
  box-shadow: none; /* 用阴影模拟边框 */
}

.service-btn::after {
  border: none;
}

.service-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
  line-height: 1;
}

.service-text {
  font-size: 22rpx;
  color: #687a71;
}

.electrician-bottom-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-size: 24rpx;
  color: #172d25;
  margin-left: 16rpx;
}
.electrician-label {
  font-size: 24rpx;
  color: #687a71;
}
.electrician-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #172d25;
}

.review-section .section-title {
  margin-bottom: 20rpx;
}

.rating-stars {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.star {
  font-size: 55rpx;
  color: #687a71;
}

.star.active {
  color: #956321;
}

.review-input {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e9efeb;
  border-radius: 22rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #172d25;
  box-sizing: border-box;
  background-color: #fff;
}

.review-display {
  padding: 20rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  margin-top: 24rpx;
}

.review-label {
  font-size: 28rpx;
  color: #172d25;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.rating-stars.display-only .star {
  cursor: default;
}

.review-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #172d25;
  line-height: 1.6;
}

.electrician-section {
  margin-top: 20rpx;
}

.electrician-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.electrician-contact-btn {
  min-width: 160rpx;
  height: auto;
  border-radius: 22rpx;
  font-size: 30rpx;
  border: none; /* 去掉真实边框 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 24rpx;
  margin-left: auto;
  margin-right: 32rpx;
  background: transparent;
  box-shadow: none; /* 用阴影模拟边框 */
}
.electrician-contact-text {
  white-space: nowrap;
  font-size: 22rpx;
  color: #687a71;
}
/* 操作按钮区域 */
.action-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: flex-end;
}

/* 主要操作按钮 */
.main-action-btn {
  min-width: 180rpx;
  height: auto;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 400;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 24rpx;
  margin-left: auto; /* 添加这个 */
  margin-right: 32rpx; /* 右侧留出空隙 */
}

.main-action-btn::after {
  border: none;
}

.main-action-btn.primary {
  background: #16835c;
  color: #fff;
  box-shadow: none;
}

.main-action-btn.secondary {
  background-color: #f5f7f5;
  color: #687a71;
}

.main-action-btn.pay {
  background: #16835c;
  color: #fff;
  box-shadow: none;
}

.main-action-btn.disabled {
  background: #cccccc !important;
  color: #687a71 !important;
  box-shadow: none !important;
}

/* 取消订单链接 */
.cancel-order-link {
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #687a71;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #687a71;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #687a71;
}

/* 多日工程：已招募电工列表 */
.electrician-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e9efeb;
}

.electrician-item:last-child {
  border-bottom: none;
}

.electrician-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.electrician-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #172d25;
}

.electrician-workno {
  font-size: 24rpx;
  color: #687a71;
}

.electrician-phone-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #eff7f1;
  border-radius: 50%;
}

.phone-icon {
  font-size: 36rpx;
}

/* 多日工程：企业端招募中静态提示 */
.recruiting-hint {
  margin: 0 20rpx 20rpx 20rpx;
  padding: 24rpx 32rpx;
  background-color: #faf4e9;
  border-left: 6rpx solid #956321;
  border-radius: 22rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #956321;
  line-height: 1.6;
}

/* 退单按钮（危险操作） */
.main-action-btn.danger {
  background-color: #b74434;
  color: #fff;
}

.main-action-btn.danger:active {
  background-color: #b74434;
}

/* UI1.1：共用详情卡片与底部操作，业务模板分别保留。 */
.container { padding: 0 0 calc(220rpx + env(safe-area-inset-bottom)); }
.content-wrapper { padding: 32rpx 44rpx 16rpx; }
.card, .section { padding: 28rpx 24rpx; border: 2rpx solid #e9efeb; border-radius: 24rpx; margin: 0 0 24rpx; box-shadow: none; }
.status-section { background: #eff7f1; border-color: #eff7f1; }
.status-title { font-size: 36rpx; color: #172d25; }
.status-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.status-text, .electrician-info, .electrician-info-row, .value { min-width: 0; }
.status-desc { color: #687a71; line-height: 1.8; }
.info-row, .contact-row { align-items: flex-start; flex-wrap: wrap; gap: 12rpx; }
.info-row .label { width: 150rpx; color: #687a71; }
.info-row .value { word-break: break-all; }
.image-item { width: 160rpx; height: 160rpx; border-radius: 20rpx; }
.address-info, .review-display, .electrician-info { background: #f5f7f5; border-radius: 20rpx; }
.bottom-content { padding: 20rpx 32rpx; flex-wrap: wrap; gap: 16rpx; }
.action-area { flex: 1; min-width: 240rpx; gap: 16rpx; }
.service-btn, .electrician-contact-btn, .main-action-btn { box-sizing: border-box; min-height: 88rpx; height: auto; margin: 0; padding: 20rpx 24rpx; line-height: 1.6; border-radius: 22rpx; font-size: 28rpx; box-shadow: none; }
.service-btn, .electrician-contact-btn, .refresh-btn { background: #eff7f1; color: #16835c; border: 2rpx solid #16835c; }
.service-text, .electrician-contact-text { color: #16835c; font-size: 24rpx; white-space: normal; }
.main-action-btn { min-width: 160rpx; flex: 1; }
.main-action-btn.primary, .main-action-btn.pay { background: #16835c; color: #fff; }
.main-action-btn.danger { background: #faf0ed; color: #b74434; border: 2rpx solid #e7b9af; }
.main-action-btn.disabled { background: #16835c !important; color: #fff !important; opacity: .5; }
.amount-input { min-width: 0; width: 0; }
.refresh-btn { flex-shrink: 0; padding: 16rpx 20rpx; border-radius: 22rpx; font-size: 26rpx; }
.recruiting-hint { margin: 0 0 24rpx; background: #faf4e9; border-color: #956321; }
.hint-text { color: #956321; }
.rating-stars { flex-wrap: wrap; gap: 8rpx; }
.star { font-size: 48rpx; }
.main-action-btn.danger:active { background: #b74434; color: #fff; }
