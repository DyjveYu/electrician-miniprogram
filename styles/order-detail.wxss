/* 订单详情与落地详情共用的后续版式。 */
@import "./order-detail-actions.wxss";
.amount-input {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  padding: 15rpx 20rpx;
  border: 2rpx solid #e9efeb;
  border-radius: 22rpx;
  font-size: 28rpx;
  background-color: #f5f7f5;
}

.container.with-project-billing-actions { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
.with-project-billing-actions .bottom-content,
.with-project-billing-actions .action-area { flex-wrap: wrap; }

.bottom-bar.rounded-actions .service-btn,
.bottom-bar.rounded-actions .main-action-btn { border-radius: 22rpx; }
