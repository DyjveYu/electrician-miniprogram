@import "../../../styles/clean-page.wxss";
.container { box-sizing: border-box; min-height: 100vh; background: #fff; padding: 32rpx 44rpx; }
.tab-container { display: flex; gap: 12rpx; padding: 8rpx; border-radius: 24rpx; background: var(--clean-soft); }
.tab-item { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8rpx; padding: 20rpx 8rpx; border-radius: 18rpx; font-size: 28rpx; color: var(--clean-muted); }
.tab-item.active { background: #fff; color: var(--clean-green); font-weight: 600; }
.badge { box-sizing: border-box; min-width: 30rpx; padding: 0 8rpx; border-radius: 18rpx; font-size: 20rpx; background: var(--clean-danger); color: #fff; text-align: center; }
.message-list { margin-top: 20rpx; }
.message-item { display: flex; align-items: flex-start; gap: 20rpx; padding: 32rpx 0; border-bottom: 2rpx solid var(--clean-line); }
.message-icon { flex-shrink: 0; }
.message-content { flex: 1; min-width: 0; }
.message-header { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 12rpx; }
.message-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; word-break: break-all; }
.new-badge { flex-shrink: 0; color: var(--clean-danger); background: #faf0ed; font-size: 22rpx; border-radius: 8rpx; padding: 0 8rpx; }
.message-desc { font-size: 26rpx; color: var(--clean-muted); line-height: 1.8; margin-bottom: 12rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; word-break: break-all; }
.message-time { font-size: 22rpx; color: var(--clean-muted); }
.message-arrow { color: var(--clean-muted); align-self: center; font-size: 32rpx; flex-shrink: 0; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 12rpx; gap: 24rpx; color: var(--clean-muted); }
.empty-text { font-size: 28rpx; }
.loading-state, .no-more { text-align: center; color: var(--clean-muted); font-size: 24rpx; padding: 40rpx 12rpx; }
