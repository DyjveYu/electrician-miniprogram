@import "../../../styles/clean-surfaces.wxss";
/* pages/enterprise/certification/certification.wxss */
.container {
  padding: 32rpx 44rpx 48rpx;
  background-color: #fff;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #687a71;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-tag.approved {
  background-color: #16835c;
}

.status-tag.pending {
  background-color: #956321;
  color: #172d25;
}

.form-container {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: none;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #172d25;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.required {
  color: #b74434;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #172d25;
  box-sizing: border-box;
}

.placeholder {
  color: #687a71;
}

.region-input {
  display: flex;
  align-items: center;
}

/* 营业执照上传 */
.upload-section {
  margin-bottom: 30rpx;
}

.upload-title {
  font-size: 28rpx;
  color: #172d25;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.license-upload {
  width: 100%;
  height: 200rpx;
  background-color: #f5f7f5;
  border: 2rpx dashed #e9efeb;
  border-radius: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #687a71;
}

.license-preview {
  width: 100%;
  height: 300rpx;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background-color: #f5f7f5;
}

.license-img {
  width: 100%;
  height: 100%;
}

.preview-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 10rpx;
}

/* 温馨提示 */
.tips {
  background-color: #eff7f1;
  padding: 20rpx;
  border-radius: 22rpx;
  margin-bottom: 40rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #16835c;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tips-content {
  font-size: 24rpx;
  color: #687a71;
}

.tips-content text {
  display: block;
  margin-bottom: 6rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
  font-weight: 500;
}

.submit-btn.disabled {
  background: #16835c;
  color: #fff;
  opacity: .5;
}

/* 状态展示容器 */
.pending-container {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 60rpx 30rpx;
  box-shadow: none;
  text-align: center;
}

.pending-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.pending-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

.pending-desc {
  font-size: 28rpx;
  color: #687a71;
  margin-bottom: 30rpx;
}


/* UI1.1：页面布局及状态精调。 */
.container { padding: 32rpx 44rpx 48rpx; } .form-container, .reject-reason { border: none; padding: 0; box-shadow: none; } .form-group { margin-bottom: 28rpx; } .header { text-align: left; margin-bottom: 32rpx; } .region-input { height: auto; min-height: 96rpx; padding: 20rpx 24rpx; } .location-wrapper { align-items: stretch; gap: 16rpx; } .location-wrapper picker { flex: 1; min-width: 0; } .location-btn { width: 88rpx; min-height: 96rpx; height: auto; margin: 0; border-radius: 22rpx; background: #eff7f1; flex-shrink: 0; } .location-icon.ui-icon { width: 36rpx; height: 36rpx; } .checkbox-group, .cert-type-group { flex-wrap: wrap; gap: 16rpx 24rpx; } .cert-type-gap { display: none; } .cert-upload-item, .license-upload { box-sizing: border-box; border: 2rpx solid #e9efeb; border-radius: 22rpx; } .cert-info { flex-wrap: wrap; gap: 8rpx; min-width: 0; } .cert-name { margin: 0; font-size: 28rpx; } .tips { border-radius: 22rpx; background: #f5f7f5; } .tips-title { color: #172d25; } .submit-btn, .reapply-btn { height: auto; min-height: 96rpx; padding: 20rpx 24rpx; line-height: 1.6; font-size: 30rpx; border-radius: 22rpx; background: #16835c; color: #fff; } .submit-btn.disabled, .reapply-btn.disabled { background: #16835c; opacity: .5; } .upload-icon.ui-icon { width: 56rpx; height: 56rpx; margin: 0 auto 16rpx; }

.continuation-panel { padding: 24rpx; margin-top: 24rpx; background: var(--clean-soft); border: 2rpx solid var(--clean-line); border-radius: 22rpx; color: var(--clean-muted); word-break: break-all; }
.continuation-panel button { width: 100%; margin-top: 16rpx; white-space: normal; background: var(--clean-green); color: #fff; }
.continuation-panel button:last-child { background: var(--clean-mint); color: var(--clean-green); border-color: var(--clean-green); }
