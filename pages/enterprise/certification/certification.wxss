/* pages/enterprise/certification/certification.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-tag.approved {
  background-color: #07c160;
}

.status-tag.pending {
  background-color: #ffc300;
  color: #333;
}

.form-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.required {
  color: #fa5151;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.placeholder {
  color: #999;
}

.region-input {
  display: flex;
  align-items: center;
}

/* 营业执照上传 */
.upload-section {
  margin-bottom: 30rpx;
}

.upload-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.license-upload {
  width: 100%;
  height: 200rpx;
  background-color: #f5f7fa;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.license-preview {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background-color: #f5f7fa;
}

.license-img {
  width: 100%;
  height: 100%;
}

.preview-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 10rpx;
}

/* 温馨提示 */
.tips {
  background-color: #f0f9ff;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #1890ff;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tips-content {
  font-size: 24rpx;
  color: #666;
}

.tips-content text {
  display: block;
  margin-bottom: 6rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(to right, #1890ff, #0076e4);
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
  font-weight: 500;
}

.submit-btn.disabled {
  background: linear-gradient(to right, #ccc, #999);
  color: #fff;
}

/* 状态展示容器 */
.pending-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 60rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.pending-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.pending-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.pending-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}
