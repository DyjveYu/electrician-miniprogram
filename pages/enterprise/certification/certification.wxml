<!--pages/enterprise/certification/certification.wxml-->
<view class="container">
  <!-- 认证结果置顶，保留图标及状态标题 -->
  <view class="certification-result" wx:if="{{mode === 'view' && certStatus === 'approved'}}">
    <image class="pending-icon ui-icon" src="/images/content-ui/check-circle.svg" mode="aspectFit" aria-hidden="true" />
    <view class="pending-title">认证已通过</view>
  </view>
  <view class="application-tip" wx:if="{{mode === 'apply' && (!restrictedCertification || certificationReady)}}">
    {{restrictedCertification && certStatus === 'pending' ? '已载入此前填写的资料，请核对后重新提交认证' : '请填写真实企业信息，提交成功即通过认证'}}
  </view>

  <view class="returned-notice" wx:if="{{certStatus === 'returned'}}">
    <view class="returned-title">企业资料已打回</view>
    <view class="returned-reason">打回原因：{{returnReason}}</view>
    <view>请核对资料后重新提交；也可原样重提。通过前不能新下单，已有订单仍可处理。</view>
  </view>

  <!-- 认证表单 -->
  <view class="form-container" wx:if="{{(!restrictedCertification || certificationReady) && (mode === 'apply' || mode === 'view')}}">
    <!-- 企业名称 -->
    <view class="form-group">
      <view class="form-label">企业名称 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入企业名称" value="{{formData.companyName}}" data-field="companyName" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved' && certStatus !== 'returned'}}" maxlength="100" />
    </view>

    <!-- 统一社会信用代码 -->
    <view class="form-group">
      <view class="form-label">统一社会信用代码 <text class="required">*</text></view>
      <input class="form-input" type="text" placeholder="请输入18位统一社会信用代码" value="{{formData.creditCode}}" data-field="creditCode" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved' && certStatus !== 'returned'}}" maxlength="18" />
    </view>

    <!-- 企业地址（省市区三级联动） -->
    <view class="form-group">
      <view class="form-label">实际经营地址（省市区） <text class="required">*</text></view>
      <picker mode="region" value="{{region}}" custom-item="{{customItem}}" bindchange="bindRegionChange" disabled="{{mode === 'view' && certStatus !== 'approved' && certStatus !== 'returned'}}">
        <view class="form-input region-input {{region[0] && region[1] && region[2] ? '' : 'placeholder'}}">
          {{region[0] && region[1] && region[2] ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-group">
      <view class="form-label">实际经营地址（详细地址） <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入详细地址（街道、门牌号等）" value="{{formData.addressDetail}}" data-field="addressDetail" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved' && certStatus !== 'returned'}}" maxlength="200" />
    </view>

    <!-- 联系人 -->
    <view class="form-group">
      <view class="form-label">联系人 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入联系人姓名" value="{{formData.contactName}}" data-field="contactName" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved' && certStatus !== 'returned'}}" maxlength="50" />
    </view>

    <!-- 手机号码（自动带出，只读） -->
    <view class="form-group">
      <view class="form-label">手机号码</view>
      <input class="form-input" type="number" maxlength="11" value="{{formData.contactPhone}}" disabled />
    </view>

    <!-- 营业执照副本上传 -->
    <view class="upload-section">
      <view class="upload-title">营业执照副本 <text class="required">*</text></view>
      <view class="license-upload" bindtap="chooseLicenseImage" wx:if="{{!licenseImagePath}}">
        <view class="upload-placeholder">
          <image class="upload-icon ui-icon" src="/images/content-ui/camera.svg" mode="aspectFit" aria-hidden="true" />
          <text class="upload-text">点击上传营业执照副本</text>
        </view>
      </view>
      <view class="license-preview" wx:if="{{licenseImagePath}}" bindtap="previewLicenseImage">
        <image class="license-img" src="{{licenseImageUrl}}" mode="aspectFill" />
        <view class="preview-tip">点击查看大图</view>
      </view>
    </view>

    <button class="change-license-btn" bindtap="chooseLicenseImage" wx:if="{{licenseImagePath && (restrictedCertification || certStatus === 'approved' || certStatus === 'returned')}}" disabled="{{submitting}}">更换营业执照图片</button>

    <view class="tips" wx:if="{{restrictedCertification}}">
      <view class="tips-title">企业信息保护指引</view>
      <view class="tips-content protection-guidance">
        <text>感谢您使用着安</text>
        <text>我们非常重视个人信息和隐私保护，依据法律法规要求，您对所填信息真实性负责。</text>
        <text>我们会基于您的授权来为您提供更好的服务，这些授权包括定位(为您精确推荐电工)、设备信息(为实现信息推送，保障账户和交易安全，获取必要的设备识别符)、存储权限(更改头像、发送订单动态、保存图片到本地等)，您有权拒绝或取消这些授权。</text>
      </view>
    </view>
    <view class="tips" wx:else>
      <view class="tips-title">温馨提示</view>
      <view class="tips-content">
        <text>1. 请确保填写的信息真实有效</text>
        <text>2. 统一社会信用代码需与营业执照一致</text>
        <text>3. 资料提交成功即通过认证</text>
        <text>4. 认证即通过并可下单</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="application-tip" wx:if="{{submitHint && !submitting && (mode === 'apply' || certStatus === 'approved' || certStatus === 'returned')}}">{{submitHint}}</view>
    <button class="submit-btn {{submitDisabled ? 'disabled' : ''}}" bindtap="submitCertification" disabled="{{submitDisabled || submitting || (restrictedCertification && checkingContinuation)}}" wx:if="{{mode === 'apply' || certStatus === 'approved' || certStatus === 'returned'}}">{{submitting ? '保存中...' : ((certStatus === 'returned' || (restrictedCertification && certStatus === 'pending')) ? '重新提交认证' : (mode === 'apply' ? '提交认证' : '保存修改'))}}</button>
  </view>

  <!-- 认证中状态 -->
  <view class="pending-container" wx:if="{{!restrictedCertification && mode === 'view' && certStatus === 'pending'}}">
    <image class="pending-icon ui-icon" src="/images/content-ui/clock.svg" mode="aspectFit" aria-hidden="true" />
    <view class="pending-title">认证审核中</view>
    <view class="pending-desc">您的企业认证申请已提交，请等待认证结果</view>
  </view>

  <view class="certification-actions" wx:if="{{restrictedCertification}}">
    <view class="certification-status" wx:if="{{checkingContinuation && !certificationReady}}">正在加载企业认证资料…</view>
    <view class="certification-status" wx:elif="{{continuationMessage}}">{{continuationMessage}}</view>
    <button class="cancel-certification-btn" bindtap="cancelCertification">取消认证</button>
  </view>
  <view class="continuation-panel" wx:elif="{{continuingOrder}}">
    <text>{{continuationMessage || '请完善资料，通过后继续下单'}}</text>
    <button bindtap="retryContinuation" loading="{{checkingContinuation}}" disabled="{{checkingContinuation || submitting}}">重新查询</button>
    <button bindtap="cancelContinuation">取消继续下单</button>
  </view>
</view>
