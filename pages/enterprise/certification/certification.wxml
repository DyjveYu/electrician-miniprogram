<!--pages/enterprise/certification/certification.wxml-->
<view class="container">
  <view class="header">
    <view class="title">企业认证</view>
    <view class="subtitle" wx:if="{{mode === 'apply'}}">请填写真实企业信息，提交后自动审核通过</view>
    <view class="subtitle" wx:if="{{mode === 'view'}}">
      <text class="status-tag {{certStatus === 'approved' ? 'approved' : 'pending'}}">
        {{certStatus === 'approved' ? '已认证' : '认证中'}}
      </text>
    </view>
  </view>

  <!-- 认证表单 -->
  <view class="form-container" wx:if="{{mode === 'apply' || mode === 'view'}}">
    <!-- 企业名称 -->
    <view class="form-group">
      <view class="form-label">企业名称 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入企业名称" value="{{formData.companyName}}" data-field="companyName" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved'}}" maxlength="100" />
    </view>

    <!-- 统一社会信用代码 -->
    <view class="form-group">
      <view class="form-label">统一社会信用代码 <text class="required">*</text></view>
      <input class="form-input" type="text" placeholder="请输入18位统一社会信用代码" value="{{formData.creditCode}}" data-field="creditCode" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved'}}" maxlength="18" />
    </view>

    <!-- 企业地址（省市区三级联动） -->
    <view class="form-group">
      <view class="form-label">企业地址 <text class="required">*</text></view>
      <picker mode="region" value="{{region}}" custom-item="{{customItem}}" bindchange="bindRegionChange" disabled="{{mode === 'view' && certStatus !== 'approved'}}">
        <view class="form-input region-input {{region[0] && region[1] && region[2] ? '' : 'placeholder'}}">
          {{region[0] && region[1] && region[2] ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-group">
      <view class="form-label">详细地址 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入详细地址（街道、门牌号等）" value="{{formData.addressDetail}}" data-field="addressDetail" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved'}}" maxlength="200" />
    </view>

    <!-- 联系人 -->
    <view class="form-group">
      <view class="form-label">联系人 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入联系人姓名" value="{{formData.contactName}}" data-field="contactName" bindinput="onInputChange" disabled="{{mode === 'view' && certStatus !== 'approved'}}" maxlength="50" />
    </view>

    <!-- 手机号码（自动带出，只读） -->
    <view class="form-group">
      <view class="form-label">手机号码</view>
      <input class="form-input" type="number" maxlength="11" value="{{formData.contactPhone}}" disabled />
    </view>

    <!-- 营业执照副本上传 -->
    <view class="upload-section">
      <view class="upload-title">营业执照副本 <text class="required">*</text></view>
      <view class="license-upload" bindtap="chooseLicenseImage" wx:if="{{!licenseImagePath}}">
        <view class="upload-placeholder">
          <text class="upload-icon">📷</text>
          <text class="upload-text">点击上传营业执照副本</text>
        </view>
      </view>
      <view class="license-preview" wx:if="{{licenseImagePath}}" bindtap="previewLicenseImage">
        <image class="license-img" src="{{licenseImagePath}}" mode="aspectFill" />
        <view class="preview-tip">点击查看大图</view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips">
      <view class="tips-title">温馨提示</view>
      <view class="tips-content">
        <text>1. 请确保填写的信息真实有效</text>
        <text>2. 统一社会信用代码需与营业执照一致</text>
        <text>3. 提交后系统将自动审核，约1-2秒完成</text>
        <text>4. 认证即通过并可下单</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button class="submit-btn {{submitDisabled ? 'disabled' : ''}}" bindtap="submitCertification" disabled="{{submitDisabled}}" wx:if="{{mode === 'apply'}}">{{submitting ? '提交中...' : '提交认证'}}</button>
  </view>

  <!-- 认证中状态 -->
  <view class="pending-container" wx:if="{{mode === 'view' && certStatus === 'pending'}}">
    <view class="pending-icon">⏳</view>
    <view class="pending-title">认证审核中</view>
    <view class="pending-desc">您的企业认证申请已提交，系统将自动审核，请稍候片刻</view>
  </view>

  <!-- 已认证状态 -->
  <view class="pending-container" wx:if="{{mode === 'view' && certStatus === 'approved'}}">
    <view class="pending-icon">✅</view>
    <view class="pending-title" style="color:#07c160;">认证已通过</view>
    <view class="pending-desc">您的企业已通过认证，可以使用全部企业功能</view>
  </view>
</view>
