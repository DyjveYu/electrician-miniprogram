@import "../../../styles/clean-surfaces.wxss";
/* pages/enterprise/project-review/project-review.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.content-wrapper {
  padding: 20rpx;
}

/* 工单状态条 */
.status-bar {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.status-label {
  font-size: 28rpx;
  color: #687a71;
}

.status-value {
  font-size: 28rpx;
  color: #956321;
  font-weight: 600;
}

/* 电工卡片 */
.electrician-card {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
  color: #172d25;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e9efeb;
}

.electrician-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
}

.workno {
  font-size: 24rpx;
  color: #687a71;
}

/* 状态标签 */
.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-tag.pending_review {
  background-color: #faf4e9;
  color: #956321;
}

.status-tag.pending_second_review {
  background-color: #faf0ed;
  color: #b74434;
}

.status-tag.completed_settled {
  background-color: #eff7f1;
  color: #16835c;
}

.status-tag.completed_unsettle {
  background-color: #f5f7f5;
  color: #687a71;
}

/* 评价表单 */
.review-form {
  padding-top: 10rpx;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #172d25;
  margin-right: 16rpx;
}

.rating-stars {
  display: flex;
}

.star {
  font-size: 48rpx;
  color: #e9efeb;
  margin-right: 6rpx;
  transition: color 0.2s;
}

.star.active {
  color: #956321;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  background-color: #16835c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 22rpx;
  height: auto;
  line-height: 1.6;
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* 已评价结果 */
.review-done {
  padding: 16rpx 0;
  text-align: center;
}

.done-text {
  font-size: 28rpx;
  color: #687a71;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #687a71;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  font-size: 28rpx;
  color: #687a71;
}
