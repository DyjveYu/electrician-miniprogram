/* pages/enterprise/electrician-review/electrician-review.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx;
}

.review-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 50rpx;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.rating-label {
  font-size: 30rpx;
  color: #333;
  margin-right: 30rpx;
}

.rating-stars {
  display: flex;
  gap: 12rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd;
  transition: color 0.2s;
}

.star.active {
  color: #ff9800;
}

.comment-section {
  margin-bottom: 50rpx;
}

.comment-label {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}

.submit-btn.disabled {
  opacity: 0.6;
}
