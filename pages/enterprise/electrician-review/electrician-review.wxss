@import "../../../styles/clean-surfaces.wxss";
/* pages/enterprise/electrician-review/electrician-review.wxss */
.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 32rpx 44rpx 48rpx;
}

.review-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 40rpx 30rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  text-align: center;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #687a71;
  text-align: center;
  margin-bottom: 50rpx;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.rating-label {
  font-size: 30rpx;
  color: #172d25;
  margin-right: 30rpx;
}

.rating-stars {
  display: flex;
  gap: 12rpx;
}

.star {
  font-size: 48rpx;
  color: #e9efeb;
  transition: color 0.2s;
}

.star.active {
  color: #956321;
}

.comment-section {
  margin-bottom: 50rpx;
}

.comment-label {
  font-size: 30rpx;
  color: #172d25;
  display: block;
  margin-bottom: 16rpx;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  background: #f5f7f5;
  border-radius: 22rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: auto;
  line-height: 1.6;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 22rpx;
  border: none;
  text-align: center;
}

.submit-btn.disabled {
  opacity: 0.6;
}
