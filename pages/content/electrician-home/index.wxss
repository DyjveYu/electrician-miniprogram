page { background:#f5f5f5; }
.page { padding:32rpx; } .intro { font-size:36rpx; font-weight:bold; margin:12rpx 0 32rpx; }
.article { background:#fff; padding:30rpx; border-radius:12rpx; margin-bottom:20rpx; }
.title { font-size:32rpx; line-height:1.6; word-break:break-all; } .meta { color:#888; font-size:24rpx; margin-top:16rpx; }
.state { color:#777; padding:80rpx 0; text-align:center; } .state button { display:block; margin:24rpx auto; }
.pagination { display:flex; justify-content:space-between; align-items:center; font-size:26rpx; margin:32rpx 0; gap:16rpx; } .pagination button { margin:0; }
