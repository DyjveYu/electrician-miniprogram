@import "../../../styles/clean-surfaces.wxss";
page { background:#fff; }
.page { padding:32rpx; } .intro { font-size:36rpx; font-weight:600; margin:12rpx 0 32rpx; }
.article { background:#fff; padding:30rpx; border-radius:22rpx; margin-bottom:20rpx; }
.title { font-size:32rpx; line-height:1.6; word-break:break-all; } .meta { color:#687a71; font-size:24rpx; margin-top:16rpx; }
.state { color:#687a71; padding:80rpx 0; text-align:center; } .state button { display:block; margin:24rpx auto; }
.pagination { display:flex; justify-content:space-between; align-items:center; font-size:26rpx; margin:32rpx 0; gap:16rpx; } .pagination button { margin:0; }


/* UI1.1：页面布局及状态精调。 */
