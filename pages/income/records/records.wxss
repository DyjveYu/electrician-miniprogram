@import "../../../styles/clean-surfaces.wxss";

page {
  background-color: #fff;
}

.container {
  padding: 32rpx 44rpx 48rpx;
}

.list {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
}

.record-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #e9efeb;
}

.record-item:last-child {
  border-bottom: none;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
}

.record-status {
  font-size: 26rpx;
  padding: 4rpx 16rpx;
  border-radius: 22rpx;
}

.status-success {
  color: #16835c;
  background: #eff7f1;
}

.status-processing {
  color: #956321;
  background: #faf4e9;
}

.status-pending {
  color: #687a71;
  background: #f5f7f5;
}

.status-failed {
  color: #b74434;
  background: #faf0ed;
}

.status-cancelled {
  color: #687a71;
  background: #f5f7f5;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-time {
  font-size: 24rpx;
  color: #687a71;
}

.record-fail {
  font-size: 24rpx;
  color: #b74434;
  margin-top: 4rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #687a71;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #687a71;
  font-size: 26rpx;
}
