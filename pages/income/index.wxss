page {
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(135deg, #0F9D58, #0B7A44);
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  position: relative;
  color: #fff;
}

.role-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.balance-amount {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.amount-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.amount-value {
  font-size: 64rpx;
  font-weight: bold;
}

.balance-action {
  display: flex;
  justify-content: center;
}

.withdraw-btn {
  background: #fff;
  color: #0F9D58;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.withdraw-btn[disabled] {
  opacity: 0.5;
  color: #999;
}

.offline-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计概览 */
.stats-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 功能入口 */
.menu-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
  display: block;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: #ccc;
}
