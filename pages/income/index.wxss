@import "../../styles/clean-surfaces.wxss";

page {
  background-color: #fff;
}

.container {
  padding: 32rpx 44rpx 48rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #687a71;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #172d25;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #687a71;
}

/* 余额卡片 */
.balance-card {
  background: #eff7f1;
  border-radius: 22rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  position: relative;
  color: #fff;
  color: #172d25;
  color: #172d25;
}

.role-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.balance-amount {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.amount-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.amount-value {
  font-size: 64rpx;
  font-weight: 600;
}

.balance-action {
  display: flex;
  justify-content: center;
}

.withdraw-btn {
  background: #fff;
  color: #16835c;
  border: none;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.withdraw-btn[disabled] {
  opacity: 0.5;
  color: #687a71;
}

.offline-tip {
  font-size: 26rpx;
  color: #687a71;
}

/* 统计概览 */
.stats-section {
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 6rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #687a71;
}

/* 功能入口 */
.menu-section {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e9efeb;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  color: #172d25;
  display: block;
}

.menu-desc {
  font-size: 24rpx;
  color: #687a71;
  display: block;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: #687a71;
}


/* UI1.1：页面布局及状态精调。 */
.balance-card { background: #eff7f1; color: #172d25; padding: 32rpx 28rpx; border-radius: 26rpx; } .amount, .amount-value { color: #16835c; font-size: 52rpx; word-break: break-all; } .amount-label, .stat-label, .offline-tip { color: #687a71; opacity: 1; } .stats-row { border-color: #d9e8dd; flex-wrap: wrap; gap: 24rpx; } .role-tag { color: #16835c; background: #fff; position: static; display: inline-block; margin-bottom: 20rpx; } .stat-item { min-width: 0; } .stat-value { word-break: break-all; } .withdraw-btn { border-radius: 22rpx; background: #16835c; color: #fff; } .input-group { gap: 12rpx; flex-wrap: wrap; } .amount-input { min-width: 0; width: 0; height: 88rpx; } .currency { margin-right: 0; } .all-btn { color: #16835c; } .menu-section { border: 2rpx solid #e9efeb; } .menu-content { min-width: 0; } .menu-item { gap: 20rpx; } .menu-icon.ui-icon { margin-right: 0; }
