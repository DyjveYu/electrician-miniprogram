<view class="container">
  <!-- 加载提示 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="content" wx:else>
    <!-- 不是推荐达人/合作伙伴 -->
    <view class="empty-state" wx:if="{{!balance.is_referrer}}">
      <text class="empty-icon">💰</text>
      <text class="empty-text">暂无收入数据</text>
      <text class="empty-desc">成为推荐达人后可查看收入</text>
    </view>

    <!-- 收入概览卡片 -->
    <view class="balance-card" wx:if="{{balance.is_referrer}}">
      <view class="role-tag">{{getRoleName(balance.referrer_type)}}</view>
      <view class="balance-amount">
        <text class="amount-label">可用余额</text>
        <text class="amount-value">¥{{balance.available_balance.toFixed(2)}}</text>
      </view>
      <!-- 合作伙伴不显示提现按钮（线下结算） -->
      <view class="balance-action" wx:if="{{balance.referrer_type !== 'partner'}}">
        <button class="withdraw-btn" bindtap="navigateToWithdraw" disabled="{{balance.available_balance < 1}}">
          申请提现
        </button>
      </view>
      <view class="balance-action" wx:else>
        <text class="offline-tip">佣金由线下结算</text>
      </view>
    </view>

    <!-- 统计概览 -->
    <view class="stats-section" wx:if="{{balance.is_referrer}}">
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-value">¥{{balance.total_commission.toFixed(2)}}</text>
          <text class="stat-label">累计佣金</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">¥{{balance.withdrawn.toFixed(2)}}</text>
          <text class="stat-label">已提现</text>
        </view>
      </view>
      <view class="stat-row">
        <view class="stat-item" wx:if="{{balance.referrer_type !== 'partner'}}">
          <text class="stat-value">¥{{balance.locked_amount.toFixed(2)}}</text>
          <text class="stat-label">锁定中</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">¥{{balance.available_balance.toFixed(2)}}</text>
          <text class="stat-label">可用余额</text>
        </view>
      </view>
    </view>

    <!-- 功能入口（合作伙伴不显示提现记录） -->
    <view class="menu-section" wx:if="{{balance.is_referrer && balance.referrer_type !== 'partner'}}">
      <view class="menu-item" bindtap="navigateToRecords">
        <text class="menu-icon">📋</text>
        <view class="menu-content">
          <text class="menu-title">提现记录</text>
          <text class="menu-desc">查看所有提现申请记录</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
