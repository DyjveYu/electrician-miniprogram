@import "../../../styles/clean-surfaces.wxss";

page {
  background-color: #fff;
}

.container {
  padding: 32rpx 44rpx 48rpx;
}

.balance-info {
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #687a71;
  display: block;
  margin-bottom: 10rpx;
}

.amount {
  font-size: 56rpx;
  font-weight: 600;
  color: #16835c;
}

.withdraw-form {
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 30rpx;
  color: #172d25;
  display: block;
  margin-bottom: 16rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e9efeb;
  padding-bottom: 16rpx;
}

.currency {
  font-size: 40rpx;
  color: #172d25;
  margin-right: 10rpx;
  font-weight: 600;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.quick-actions {
  margin-bottom: 20rpx;
}

.all-btn {
  background: #eff7f1;
  color: #16835c;
  border: none;
  border-radius: 22rpx;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  width: auto;
  display: inline-block;
}

.tips {
  margin-bottom: 40rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #687a71;
  margin-bottom: 8rpx;
}

.submit-btn {
  background: #ccc;
  color: #fff;
  border: none;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
}

.submit-btn.active {
  background: #16835c;
}


/* UI1.1：页面布局及状态精调。 */
.balance-info { border-radius: 26rpx; padding: 32rpx 28rpx; background: #eff7f1; margin-bottom: 28rpx; } .balance-info .label { color: #687a71; } .balance-info .amount { font-size: 52rpx; color: #16835c; word-break: break-all; } .withdraw-form { padding: 28rpx 24rpx; } .input-wrapper { gap: 12rpx; } .amount-input { min-width: 0; width: 0; } .all-btn { background: #eff7f1; color: #16835c; border-radius: 18rpx; }

.input-wrapper { box-sizing: border-box; padding: 20rpx; border: 2rpx solid #e9efeb; border-radius: 22rpx; background: #f5f7f5; } .amount-input { font-size: 32rpx; }
