@import "../../../styles/clean-surfaces.wxss";
/* pages/electrician/list/list.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
}

/* 电工列表 */
.electrician-list {
  padding: 20rpx;
}

.electrician-item {
  background-color: #fff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: none;
  transition: background-color 0.3s;
}

.electrician-item:active {
  background-color: #f5f7f5;
}

.electrician-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.electrician-avatar image {
  width: 100%;
  height: 100%;
}

.electrician-info {
  flex: 1;
}

.electrician-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.electrician-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
}

.electrician-rating {
  background-color: #faf4e9;
  color: #956321;
  padding: 4rpx 8rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
}

.rating-text {
  font-weight: 600;
}

.electrician-details {
  display: flex;
  margin-bottom: 15rpx;
}

.detail-item {
  font-size: 24rpx;
  color: #687a71;
  margin-right: 30rpx;
}

.electrician-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.skill-tag {
  background-color: #eff7f1;
  color: #16835c;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.electrician-location {
  font-size: 24rpx;
  color: #687a71;
}

.location-text {
  display: flex;
  align-items: center;
}

/* 操作按钮 */
.electrician-actions {
  margin-left: 20rpx;
}

.action-btn {
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  border: none;
  min-width: 80rpx;
}

.action-btn::after {
  border: none;
}

.contact-btn {
  background-color: #16835c;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #687a71;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #687a71;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #687a71;
}

/* UI1.1：页面布局及状态精调。 */
.electrician-list { padding: 0; } .electrician-item { padding: 28rpx 24rpx; border: 2rpx solid #e9efeb; border-radius: 24rpx; flex-wrap: wrap; gap: 16rpx; } .electrician-avatar { margin-right: 0; } .electrician-info { min-width: 200rpx; } .electrician-header, .electrician-details { flex-wrap: wrap; gap: 8rpx 16rpx; } .electrician-actions { width: 100%; } .contact-btn { box-sizing: border-box; min-height: 88rpx; padding: 20rpx; }
