@import "../../../styles/clean-surfaces.wxss";
/* pages/electrician/detail/detail.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 电工卡片 */
.electrician-card {
  background: #eff7f1;
  margin: 20rpx;
  border-radius: 22rpx;
  padding: 40rpx 30rpx;
  color: #fff;
  box-shadow: none;
  color: #172d25;
  color: #172d25;
}

.electrician-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-section {
  margin-right: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.electrician-info {
  flex: 1;
}

.electrician-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.electrician-phone {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.electrician-rating {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 6rpx 12rpx;
  border-radius: 22rpx;
  display: inline-block;
}

.rating-text {
  font-size: 24rpx;
}

/* 统计数据 */
.stats-section {
  display: flex;
  justify-content: space-around;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 22rpx;
  padding: 30rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 通用section */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 22rpx;
  padding: 30rpx;
  box-shadow: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e9efeb;
}

/* 技能列表 */
.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.skill-tag {
  background-color: #eff7f1;
  color: #16835c;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 服务介绍 */
.description-text {
  font-size: 28rpx;
  color: #172d25;
  line-height: 1.6;
}

/* 认证信息 */
.cert-info {
  /* 认证信息样式 */
}

.cert-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.cert-item:last-child {
  margin-bottom: 0;
}

.cert-label {
  color: #687a71;
  width: 180rpx;
  flex-shrink: 0;
}

.cert-value {
  color: #172d25;
  flex: 1;
}

/* 联系按钮 */
.contact-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #fff;
  border-top: 2rpx solid #e9efeb;
}

.contact-btn {
  width: 100%;
  height: auto;
  background-color: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #687a71;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #687a71;
}

/* UI1.1：页面布局及状态精调。 */
.container { padding: 32rpx 44rpx calc(180rpx + env(safe-area-inset-bottom)); } .electrician-card, .section { margin: 0 0 24rpx; padding: 28rpx 24rpx; border-radius: 24rpx; } .electrician-card { color: #172d25; background: #eff7f1; } .electrician-info, .cert-value { min-width: 0; word-break: break-all; } .electrician-header { gap: 20rpx; } .avatar-section { margin: 0; } .cert-label { width: 140rpx; } .cert-item { align-items: flex-start; } .contact-section { padding: 20rpx 44rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); } .contact-btn { background: #16835c; color: #fff; } .stats-section { gap: 12rpx; } .stats-item { flex: 1; min-width: 0; text-align: center; } .stats-value { word-break: break-all; }
