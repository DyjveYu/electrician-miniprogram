@import "../order/create/create.wxss";
.landing-container { box-sizing: border-box; min-height: 100vh; background: #fff; }
.loading-box { text-align: center; padding: 120rpx 32rpx; color: #687a71; font-size: 28rpx; }
.login-error { background: #faf0ed; color: #b74434; padding: 24rpx; border-radius: 22rpx; margin: 32rpx 44rpx; }
.success-section { margin: 48rpx 44rpx; padding: 48rpx 28rpx; text-align: center; background: #eff7f1; border-radius: 26rpx; }
.success-icon.ui-icon { width: 80rpx; height: 80rpx; margin: 0 auto 24rpx; }
.success-title { color: #172d25; font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.success-desc { color: #687a71; font-size: 28rpx; line-height: 1.8; margin-bottom: 20rpx; }
.success-info { color: #687a71; font-size: 24rpx; word-break: break-all; }
.close-btn { background: #16835c; color: #fff; border-radius: 22rpx; }
