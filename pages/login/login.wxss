/* M1.5：清爽实用；原Logo图片、280rpx尺寸和顶部安全区保持。 */
page { background: #fff; }
.page-container { min-height: 100vh; background: #fff; color: #172d25; display: flex; flex-direction: column; }
.header { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; padding: 96rpx 40rpx 32rpx; padding-top: calc(96rpx + constant(safe-area-inset-top)); padding-top: calc(96rpx + env(safe-area-inset-top)); }
.brand-logo-wrap { display: flex; align-items: center; justify-content: center; }
.brand-logo { display: block; width: 280rpx; height: auto; }
.brand-slogan { box-sizing: border-box; width: 100%; margin-top: 32rpx; padding: 16rpx 24rpx; background: #eff7f1; border-radius: 18rpx; color: #172d25; font-size: 36rpx; line-height: 1.5; text-align: center; letter-spacing: 4rpx; font-weight: 500; }
.login-entries { display: flex; gap: 24rpx; padding: 8rpx 44rpx 44rpx; }
.entry-button { box-sizing: border-box; flex: 1; min-width: 0; min-height: 96rpx; margin: 0; padding: 24rpx 8rpx; border: 2rpx solid #16835c; border-radius: 22rpx; background: #eff7f1; color: #16835c; font-size: 32rpx; line-height: 1.5; font-weight: 600; }
.entry-button-primary { background: #16835c; color: #fff; }
.entry-button::after, .login-actions button::after, .send-code-btn::after, .close-login::after, .welcome-btn::after { border: none; }
.footer { padding: 40rpx 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); text-align: center; background: #fff; }
.footer-brand { display: block; color: #687a71; font-size: 22rpx; }
.version-text { display: block; color: #687a71; font-size: 20rpx; margin-top: 6rpx; }
/* 表单层低于协议确认及协议详情。固定视窗允许大字体和键盘下滚动。 */
.login-overlay, .modal, .welcome-modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; }
.login-overlay { z-index: 1900; }
.login-mask, .welcome-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(7, 29, 23, .65); }
.login-dialog { position: relative; box-sizing: border-box; width: calc(100% - 64rpx); height: 1060rpx; max-height: 80vh; background: #fff; border-radius: 40rpx; overflow: hidden; }
.login-form { box-sizing: border-box; padding: 44rpx 40rpx 24rpx; color: #172d25; }
.login-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; margin-bottom: 24rpx; }
.form-title { flex: 1; min-width: 0; padding-top: 10rpx; font-size: 36rpx; font-weight: 600; line-height: 1.5; color: #172d25; }
.close-login { box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; min-width: 76rpx; margin: 0; padding: 0; border: none; border-radius: 50%; background: #f5f7f5; color: #687a71; font-size: 44rpx; font-weight: 400; line-height: 1; }
.close-login[disabled] { opacity: .5; }
.login-description { color: #687a71; font-size: 24rpx; line-height: 1.8; margin-bottom: 32rpx; }
.link { color: #16835c; }
.form-group { margin: 28rpx 0; }
.input-label { display: block; font-size: 24rpx; color: #687a71; margin-bottom: 12rpx; }
.input-group { box-sizing: border-box; display: flex; align-items: center; height: 96rpx; min-width: 0; padding: 0 24rpx; background: #f5f7f5; border: 2rpx solid #e9efeb; border-radius: 20rpx; }
.form-input { flex: 1; min-width: 0; width: 0; color: #172d25; font-size: 30rpx; background: transparent; border: none; }
.code-group { display: flex; align-items: stretch; gap: 16rpx; }
.code-input-group { flex: 1; }
.send-code-btn { box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 96rpx; margin: 0; padding: 16rpx; border: 2rpx solid #e9efeb; border-radius: 20rpx; background: #fff; color: #16835c; font-size: 24rpx; line-height: 1.5; white-space: nowrap; }
.send-code-btn.disabled { color: #687a71; opacity: .65; background: #fff; }
.error-text { display: block; font-size: 24rpx; line-height: 1.5; color: #b74434; margin-top: 10rpx; }
.order-role-selector { display: flex; gap: 16rpx; margin: 32rpx 0; }
.order-role { box-sizing: border-box; flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 88rpx; padding: 18rpx 8rpx; border: 2rpx solid #e9efeb; border-radius: 20rpx; background: #fff; color: #172d25; font-size: 26rpx; }
.order-role.active { color: #16835c; border-color: #16835c; background: #eff7f1; }
.role-check { box-sizing: border-box; flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 26rpx; height: 26rpx; border: 2rpx solid #687a71; border-radius: 50%; color: #16835c; font-size: 14rpx; line-height: 1; }
.order-role.active .role-check { border-color: #16835c; }
.login-actions { display: flex; flex-direction: column; gap: 0; margin-top: 32rpx; }
.login-actions button { box-sizing: border-box; width: 100%; min-width: 0; min-height: 96rpx; margin: 0; padding: 24rpx 12rpx; border: none; border-radius: 22rpx; line-height: 1.5; font-size: 30rpx; }
.login-btn { color: #fff; background: #16835c; font-weight: 500; }
.login-btn.disabled { background: #16835c; color: #fff; opacity: .5; }
.cancel-login { background: transparent; color: #687a71; font-size: 26rpx; }
/* 真实协议继续使用现有内容与确认行为。 */
.modal { z-index: 2100; background: rgba(7, 29, 23, .65); }
.modal-content { box-sizing: border-box; width: calc(100% - 64rpx); max-height: 80vh; background: #fff; border-radius: 40rpx; overflow: hidden; }
.modal-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 32rpx 32rpx 16rpx; }
.modal-title { flex: 1; color: #172d25; font-size: 34rpx; font-weight: 600; }
.modal-body { box-sizing: border-box; height: 50vh; padding: 0 36rpx; }
.modal-text { font-size: 26rpx; color: #687a71; line-height: 1.8; }
.modal-footer { padding: 24rpx 36rpx 32rpx; }
.modal-btn { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 22rpx; background: #16835c; color: #fff; font-size: 30rpx; }
.welcome-modal { z-index: 2000; }
.welcome-dialog { box-sizing: border-box; position: relative; width: calc(100% - 64rpx); max-height: 80vh; overflow-y: auto; background: #fff; border-radius: 40rpx; padding: 40rpx; }
.welcome-title { color: #172d25; font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }
.welcome-content { color: #687a71; font-size: 26rpx; line-height: 1.8; margin-bottom: 32rpx; }
.welcome-buttons { display: flex; gap: 16rpx; }
.welcome-btn { box-sizing: border-box; flex: 1; min-width: 0; min-height: 88rpx; margin: 0; padding: 20rpx 8rpx; border-radius: 22rpx; font-size: 28rpx; line-height: 1.5; }
.welcome-btn.cancel { background: #f5f7f5; color: #687a71; }
.welcome-btn.agree { background: #16835c; color: #fff; }
