<!--pages/login/login.wxml-->
<view class="page-container">

  <!-- V1.1.3: 欢迎弹窗 -->
  <view class="welcome-modal" wx:if="{{showWelcomeModal}}">
    <view class="welcome-mask"></view>
    <view class="welcome-dialog">
      <view class="welcome-title">欢迎使用着安</view>
      <view class="welcome-content">
        感谢您使用本应用，您使用本应用前应当阅读并同意
        <text class="link" bindtap="showPrivacyPolicy">《隐私政策》</text>和<text class="link" bindtap="showUserAgreement">《用户协议》</text>
        。当您点击同意并开始使用产品服务时，即表示你已理解并同意该条款内容。
      </view>
      <view class="welcome-buttons">
        <button class="welcome-btn cancel" bindtap="onCancel">取消</button>
        <button class="welcome-btn agree" bindtap="onAgree">同意</button>
      </view>
    </view>
  </view>

  <!-- 头部区域 -->
  <view class="header">
    <view class="brand-logo-wrap">
      <image class="brand-logo" src="/images/icons/logo.png" mode="widthFix"></image>
    </view>
    <view class="brand-slogan">找电工 上着安</view>
  </view>

  <!-- 图1：首页只展示两个入口，输入表单在点击后打开 -->
  <view class="login-entries">
    <button class="entry-button entry-button-primary" bindtap="openLoginForm" data-role="user">我要找电工</button>
    <button class="entry-button" bindtap="openLoginForm" data-role="electrician">我要去接单</button>
  </view>

  <electrician-home-entry />
  <safety-knowledge-entry />
  <notice-board />
  <home-ads />

  <view class="footer">
    <text class="footer-brand">着安电工服务平台</text>
    <text class="version-text">{{version}}</text>
  </view>
</view>

<!-- 图2／3：两个入口复用原登录流程 -->
<view class="login-overlay" wx:if="{{showLoginForm}}">
  <view class="login-mask" bindtap="closeLoginForm" catchtouchmove="preventTouchMove"></view>
  <scroll-view class="login-dialog" scroll-y>
    <view class="login-form" id="login-form">
      <view class="login-heading">
        <view class="form-title">{{selectedRole === 'electrician' ? '欢迎注册着安电工' : '欢迎使用着安订单登录'}}</view>
        <button class="close-login" bindtap="closeLoginForm" disabled="{{isLogging}}" aria-label="关闭登录弹层">×</button>
      </view>
      <view class="login-description">
        欢迎您使用着安，您使用本应用前应当阅读并同意
        <text class="link" bindtap="showPrivacyPolicy">《隐私政策》</text>和<text class="link" bindtap="showUserAgreement">《用户协议》</text>。
        当您点击同意并开始使用产品服务时，即表示您已理解并同意该条款内容。
      </view>
      <view class="form-group">
        <text class="input-label">手机号</text>
        <view class="input-group">
          <input class="form-input" type="number" placeholder="请输入手机号码" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" disabled="{{isLogging}}" />
        </view>
        <text class="error-text" wx:if="{{phoneError}}">{{phoneError}}</text>
      </view>
      <view class="form-group">
        <text class="input-label">验证码</text>
        <view class="code-group">
          <view class="input-group code-input-group">
            <input class="form-input code-input" type="number" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6" disabled="{{isLogging}}" />
          </view>
          <button class="send-code-btn {{!canSendCode || countdown > 0 || isLogging ? 'disabled' : ''}}" bindtap="sendCode" disabled="{{!canSendCode || countdown > 0 || isLogging}}">{{codeButtonText}}</button>
        </view>
        <text class="error-text" wx:if="{{codeError}}">{{codeError}}</text>
      </view>
      <view class="order-role-selector" wx:if="{{selectedRole !== 'electrician'}}">
        <view class="order-role {{selectedRole === 'user' ? 'active' : ''}}" bindtap="selectRole" data-role="user" role="radio" aria-checked="{{selectedRole === 'user'}}">
          <text class="role-check">{{selectedRole === 'user' ? '●' : ''}}</text><text>个人订单</text>
        </view>
        <view class="order-role {{selectedRole === 'enterprise' ? 'active' : ''}}" bindtap="selectRole" data-role="enterprise" role="radio" aria-checked="{{selectedRole === 'enterprise'}}">
          <text class="role-check">{{selectedRole === 'enterprise' ? '●' : ''}}</text><text>企业订单</text>
        </view>
      </view>
      <view class="login-actions">
        <button class="login-btn {{!canLogin || isLogging ? 'disabled' : ''}}" bindtap="login" disabled="{{!canLogin || isLogging}}">{{isLogging ? '登录中...' : (selectedRole === 'electrician' ? '去注册' : '我要找电工')}}</button>
        <button class="cancel-login" bindtap="closeLoginForm" disabled="{{isLogging}}">取消</button>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 协议弹窗 -->
<view class="modal" wx:if="{{showModal}}" bindtap="hideModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">{{modalTitle}}</text>
      <button class="close-login" bindtap="hideModal" aria-label="关闭协议详情">×</button>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <text class="modal-text">{{modalContent}}</text>
    </scroll-view>
    <view class="modal-footer">
      <view class="modal-btn" bindtap="hideModal">我知道了</view>
    </view>
  </view>
</view>
