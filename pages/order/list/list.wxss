@import "../../../styles/clean-page.wxss";
.container { box-sizing: border-box; min-height: 100vh; padding: 32rpx 44rpx; background: #fff; }
.order-list { padding: 0; }
.order-item { padding: 28rpx 24rpx; margin-bottom: 24rpx; background: #fff; border: 2rpx solid var(--clean-line); border-radius: 24rpx; }
.order-item:active { background: var(--clean-soft); }
.order-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding-bottom: 24rpx; margin-bottom: 24rpx; border-bottom: 2rpx solid var(--clean-line); }
.order-status-title { flex: 1; min-width: 0; color: var(--clean-green); font-size: 30rpx; font-weight: 600; }
.order-status-title.status-pending { color: var(--clean-warn); }
.order-status-title.status-cancelled, .order-status-title.status-closed { color: var(--clean-muted); }
.detail-link { flex-shrink: 0; font-size: 24rpx; color: var(--clean-muted); padding-top: 4rpx; }
.order-info-list { display: flex; flex-direction: column; gap: 18rpx; }
.info-item { display: flex; gap: 16rpx; align-items: flex-start; font-size: 26rpx; line-height: 1.7; }
.info-label { color: var(--clean-muted); flex-shrink: 0; width: 142rpx; }
.info-value { flex: 1; min-width: 0; word-break: break-all; }
.info-value.description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.info-value.price { color: var(--clean-green); font-weight: 600; font-size: 28rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 20rpx; color: var(--clean-muted); }
.empty-icon { margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; }
.loading-state, .no-more { text-align: center; padding: 40rpx 12rpx; color: var(--clean-muted); font-size: 24rpx; }
