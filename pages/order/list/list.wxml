<!--pages/order/list/list.wxml-->
<view class="container">

  <!-- 订单列表 -->
  <view class="order-list">
    <view 
      class="order-item"
      wx:for="{{orders}}"
      wx:key="id"
      bindtap="viewOrderDetail"
      data-id="{{item.id}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-status-title">{{item.statusText}}</view>
        <view class="detail-link">详情 ›</view>
      </view>

      <!-- 订单信息 -->
      <view class="order-info-list">
        <view class="info-item">
          <text class="info-label">订单编号:</text>
          <text class="info-value">{{item.orderNumber || item.order_no}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">服务类型:</text>
          <text class="info-value">{{item.title || item.serviceTypeName || item.serviceType.name}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">用电类型:</text>
          <text class="info-value">{{item.electricityTypeName || '低压订单'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">故障描述:</text>
          <text class="info-value description">{{item.description}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">下单时间:</text>
          <text class="info-value">{{item.createTime || item.created_at}}</text>
        </view>
        <view class="info-item" wx:if="{{item.has_paid_prepay && item.status !== 'cancelled' && item.status !== 'closed'}}">
          <text class="info-label">预付款:</text>
          <text class="info-value price">{{item.prepay_amount}}元</text>
        </view>
        <view class="info-item" wx:if="{{item.has_paid_repair}}">
          <text class="info-label">维修款:</text>
          <text class="info-value price">{{item.final_amount}}元</text>
        </view>
      </view>

    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无订单</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
      <text>没有更多订单了</text>
    </view>
  </view>
</view>