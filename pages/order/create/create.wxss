.page-container {
  padding: 20rpx;
  padding-bottom: 260rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form-section {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.service-list {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  padding: 16rpx 26rpx;
  margin: 10rpx;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fff;
}

.service-item.active {
  background-color: #0F9D58;
  color: #fff;
  border-color: #0F9D58;
}

/* 问题描述 textarea */
.desc-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1px solid #eee;
  border-radius: 8rpx;
  padding: 10rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 语音输入按钮：白底长方形 */
.voice-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 16rpx 0;
  background: #fff;
  border: 1px solid #0F9D58;
  border-radius: 8rpx;
  gap: 10rpx;
}

.voice-btn-recording {
  background: #fff8f8;
  border-color: #e74c3c;
}

.voice-btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.voice-btn-text {
  font-size: 28rpx;
  color: #0F9D58;
}

.voice-btn-recording .voice-btn-text {
  color: #e74c3c;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.uploaded-image {
  width: 120rpx;
  height: 120rpx;
  margin: 10rpx;
  border-radius: 8rpx;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  margin: 10rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  text-align: center;
  line-height: 160rpx;
  font-size: 60rpx;
  color: #999;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid #f2f2f2;
  white-space: nowrap;
}

.label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  text-align: left;
  color: #333;
  font-size: 28rpx;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.placeholder {
  color: #999;
}

.submit-section {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
}

/* 底部提交预约条 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0,0,0,0.06);
}

.prepay-text {
  color: #0F9D58;
  font-weight: 600;
  font-size: 30rpx;
}

.booking-btn {
  min-width: 260rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  border-radius: 80rpx;
  font-size: 28rpx;
  border: none;
  margin-left: auto;
  display: block;
  margin-right: 32rpx;
}

.booking-btn[disabled] {
  opacity: 0.6;
}

/* 底部弹层通用样式 */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 998;
}

.action-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  z-index: 999;
  max-height: 70vh;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.close-icon {
  font-size: 40rpx;
  line-height: 40rpx;
}

.sheet-body {
  height: 48vh;
}

.address-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1px solid #f2f2f2;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.addr-title {
  font-size: 28rpx;
  color: #333;
}

.addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.terms-row {
  padding-top: 12rpx;
}

.terms-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.terms-text {
  flex: 1;
  color: #666;
  font-size: 26rpx;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.mini-btn {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  color: #333;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 24rpx 0;
}

.sheet-footer {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx 24rpx 24rpx;
}

.footer-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 60rpx;
  font-size: 28rpx;
  border: none;
}

.footer-btn.primary { background: #0F9D58; color: #fff; }
.footer-btn.secondary { background: #e9f5ee; color: #0F9D58; }

/* 用电类型单选组样式 */
.electricity-type-group {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.electricity-type-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.electricity-type-item radio {
  margin-right: 8rpx;
}

.electricity-type-gap {
  width: 60rpx;
}

/* 定向下单 */
.directed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.directed-label {
  font-size: 28rpx;
  color: #333;
}

.directed-detail {
  margin-top: 16rpx;
}

.workno-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.workno-input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  height: 60rpx;
}

.electrician-card {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f0f9f4;
  border-radius: 8rpx;
  border-left: 6rpx solid #0F9D58;
}

.electrician-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.electrician-wn {
  font-size: 26rpx;
  color: #666;
  margin-top: 4rpx;
  display: block;
}

.search-empty {
  margin-top: 12rpx;
  padding: 16rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.directed-hint {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #b8860b;
}

/* ── 语音录音弹出层 ─────────────────────────── */

.record-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.record-panel {
  width: 100%;
  background: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 顶部：标题 + 关闭 */
.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.record-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #999;
  line-height: 1;
}

/* 波形 */
.wave-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 80rpx;
}

.wave-bar {
  width: 8rpx;
  border-radius: 4rpx;
  background: #0F9D58;
  transition: height 0.1s;
  min-height: 8rpx;
}

/* 实时文字区域 */
.record-result-box {
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
}

.record-result-text {
  font-size: 30rpx;
  color: #222;
  line-height: 1.7;
  white-space: normal;
  word-break: break-all;
}

.record-result-placeholder {
  font-size: 28rpx;
  color: #bbb;
}

/* 底部按钮区 */
.record-actions {
  display: flex;
  gap: 20rpx;
}

.record-cancel-btn {
  flex: 1;
  padding: 22rpx 0;
  background: #f5f5f5;
  color: #666;
  border-radius: 60rpx;
  font-size: 28rpx;
  border: none;
}

.record-confirm-btn {
  flex: 2;
  padding: 22rpx 0;
  background: #0F9D58;
  color: #fff;
  border-radius: 60rpx;
  font-size: 28rpx;
  border: none;
}

/* ─── 企业下单模式选择 ──────────────────────────── */
.mode-selector {
  display: flex;
  gap: 20rpx;
}

.mode-option {
  flex: 1;
  padding: 30rpx 20rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.2s;
}

.mode-option.active {
  border-color: #0F9D58;
  background: #f0fdf6;
}

.mode-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.mode-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.mode-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* ─── 多日工程表单 ──────────────────────────── */
.time-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time-item {
  flex: 1;
}

.time-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.time-sep {
  font-size: 28rpx;
  color: #999;
  padding-top: 30rpx;
}

.cert-radio {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #333;
}

.amount-input-box {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e8e8e8;
  padding: 10rpx 0;
}

.amount-currency {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.fee-hint {
  font-size: 24rpx;
  color: #0F9D58;
  margin-top: 10rpx;
}

.fee-num {
  font-weight: 600;
  color: #e74c3c;
}

.picker-display {
  padding: 24rpx 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.picker-display.placeholder {
  color: #999;
}

.form-input {
  width: 100%;
  padding: 24rpx 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  min-height: 80rpx;
  line-height: 1.5;
}
