.page-container {
  padding: 20rpx;
  padding-bottom: 260rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form-section {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.service-list {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  padding: 16rpx 26rpx;
  margin: 10rpx;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fff;
}

.service-item.active {
  background-color: #0F9D58;
  color: #fff;
  border-color: #0F9D58;
}

/* 问题描述 textarea */
.desc-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1px solid #eee;
  border-radius: 8rpx;
  padding: 10rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 语音输入按钮：白底长方形 */
.voice-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 16rpx 0;
  background: #fff;
  border: 1px solid #0F9D58;
  border-radius: 8rpx;
  gap: 10rpx;
}

.voice-btn-recording {
  background: #fff8f8;
  border-color: #e74c3c;
}

.voice-btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.voice-btn-text {
  font-size: 28rpx;
  color: #0F9D58;
}

.voice-btn-recording .voice-btn-text {
  color: #e74c3c;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.uploaded-image {
  width: 120rpx;
  height: 120rpx;
  margin: 10rpx;
  border-radius: 8rpx;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  margin: 10rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  text-align: center;
  line-height: 160rpx;
  font-size: 60rpx;
  color: #999;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid #f2f2f2;
  white-space: nowrap;
}

.label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  text-align: left;
  color: #333;
  font-size: 28rpx;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.placeholder {
  color: #999;
}

.submit-section {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
}

/* 底部提交预约条 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0,0,0,0.06);
}

.offsite-submit-bar {
  z-index: 100;
  padding-left: 44rpx;
  padding-right: 44rpx;
  border-top: 2rpx solid var(--clean-line);
  box-shadow: none;
}

.offsite-submit-bar .booking-btn {
  box-sizing: border-box;
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: 20rpx 16rpx;
  background: var(--clean-green);
  border-radius: 22rpx;
  line-height: 1.6;
  font-weight: 500;
}

.offsite-submit-bar .booking-btn::after { border: 0; }

.prepay-text {
  color: #0F9D58;
  font-weight: 600;
  font-size: 30rpx;
}

.booking-btn {
  min-width: 260rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  border-radius: 80rpx;
  font-size: 28rpx;
  border: none;
  margin-left: auto;
  display: block;
  margin-right: 32rpx;
}

.booking-btn[disabled] {
  opacity: 0.6;
}

/* 底部弹层通用样式 */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 998;
}

.action-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #f5f5f5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 999;
  max-height: 70vh;
  overflow-x: hidden;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.sheet-header-spacer {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.sheet-header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;

  color: #1a1a1a;
}

.close-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 40rpx;
  color: #999;
  flex-shrink: 0;
}

.sheet-body {
  height: 48vh;
  padding: 0 24rpx;
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

/* 地址卡片 */
.address-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  width: 100%;
  box-sizing: border-box;
}

.address-card-default {
  border-color: #0F9D58;
}

/* 默认角标——右上角绿色三角 */
.default-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 65rpx 65rpx 0;
  border-color: transparent #0F9D58 transparent transparent;
}

.default-badge-text {
  position: absolute;
  top: 9rpx;
  right: -60rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
  transform: rotate(45deg);
  white-space: nowrap;
}

.address-card-main {
  flex: 1;
  min-width: 0;
}

.addr-title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.addr-phone {
  font-size: 26rpx;
  color: #888;
}

.addr-detail {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  line-height: 1.5;
}

.terms-row {
  padding-top: 12rpx;
}

.terms-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.terms-text {
  flex: 1;
  color: #666;
  font-size: 26rpx;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.terms-link {
  color: #e74c3c;
}

.terms-tip {
  margin-top: 8rpx;
  padding-left: 48rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.4;
}

/* 编辑按钮——方框内铅笔图标 */
.addr-edit-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  align-self: flex-end;  /* ← 从 center 改成 flex-end */
}

.addr-edit-btn:active {
  background: #f5f5f5;
}

.edit-icon {
  font-size: 28rpx;
  color: #666;
  line-height: 1;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 48rpx;
}

.sheet-footer {
  padding: 16rpx 24rpx 40rpx;
}

/* 底部添加按钮——圆角胶囊大按钮 */
.footer-btn-add {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  border-radius: 46rpx;
  font-size: 30rpx;

  border: none;
  text-align: center;
  padding: 0;
}

.footer-btn-add::after {
  border: none;
}

.footer-btn.primary { background: #0F9D58; color: #fff; }
.footer-btn.secondary { background: #e9f5ee; color: #0F9D58; }

/* 用电类型单选组样式 */
.electricity-type-group {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.electricity-type-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.electricity-type-item radio {
  margin-right: 8rpx;
}

.electricity-type-gap {
  width: 60rpx;
}

/* 定向下单 */
.directed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.directed-label {
  font-size: 28rpx;
  color: #333;
}

.directed-detail {
  margin-top: 16rpx;
}

.workno-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.workno-input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  height: 60rpx;
}

.electrician-card {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f0f9f4;
  border-radius: 8rpx;
  border-left: 6rpx solid #0F9D58;
}

.electrician-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.electrician-wn {
  font-size: 26rpx;
  color: #666;
  margin-top: 4rpx;
  display: block;
}

.search-empty {
  margin-top: 12rpx;
  padding: 16rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.directed-hint {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #b8860b;
}

/* ── 语音录音弹出层 ─────────────────────────── */

.record-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.record-panel {
  width: 100%;
  background: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 顶部：标题 + 关闭 */
.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.record-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #999;
  line-height: 1;
}

/* 波形 */
.wave-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 80rpx;
}

.wave-bar {
  width: 8rpx;
  border-radius: 4rpx;
  background: #0F9D58;
  transition: height 0.1s;
  min-height: 8rpx;
}

/* 实时文字区域 */
.record-result-box {
  min-height: 160rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
}

.record-result-text {
  font-size: 30rpx;
  color: #222;
  line-height: 1.7;
  white-space: normal;
  word-break: break-all;
}

.record-result-placeholder {
  font-size: 28rpx;
  color: #bbb;
}

/* 底部按钮区 */
.record-actions {
  display: flex;
  gap: 20rpx;
}

.record-cancel-btn {
  flex: 1;
  padding: 22rpx 0;
  background: #f5f5f5;
  color: #666;
  border-radius: 60rpx;
  font-size: 28rpx;
  border: none;
}

.record-confirm-btn {
  flex: 2;
  padding: 22rpx 0;
  background: #0F9D58;
  color: #fff;
  border-radius: 60rpx;
  font-size: 28rpx;
  border: none;
}

/* ─── 企业下单模式选择 ──────────────────────────── */
.mode-selector {
  display: flex;
  gap: 20rpx;
}

.mode-option {
  flex: 1;
  padding: 30rpx 20rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.2s;
}

.mode-option.active {
  border-color: #0F9D58;
  background: #f0fdf6;
}

.mode-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.mode-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.mode-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* ─── 多日工程表单 ──────────────────────────── */
.time-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time-item {
  flex: 1;
}

.time-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.time-sep {
  font-size: 28rpx;
  color: #999;
  padding-top: 30rpx;
}

.cert-radio {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #333;
}

.amount-input-box {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e8e8e8;
  padding: 10rpx 0;
}

.amount-currency {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.fee-hint {
  font-size: 24rpx;
  color: #0F9D58;
  margin-top: 10rpx;
}

.fee-num {
  font-weight: 600;
  color: #e74c3c;
}

.picker-display {
  padding: 24rpx 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.picker-display.placeholder {
  color: #999;
}

.form-input {
  width: 100%;
  padding: 24rpx 20rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  min-height: 80rpx;
  line-height: 1.5;
}

/* ─── 协议弹层（z-index ≥2100，参考 V1.1.3 T03） ─── */
.agreement-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2100;
}

.agreement-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 2101;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.agreement-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.agreement-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.agreement-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 40rpx;
  color: #999;
  flex-shrink: 0;
}

.agreement-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 55vh;
  overflow-x: hidden;
  box-sizing: border-box;
}

.agreement-content {
  padding-bottom: 20rpx;
}

.agreement-article {
  margin-top: 20rpx;
}

.agreement-p {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.agreement-date {
  margin-top: 40rpx;
  text-align: right;
}

.agreement-footer {
  padding: 20rpx 32rpx 40rpx;
  flex-shrink: 0;
}

.agreement-close-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0F9D58;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  text-align: center;
}

.agreement-close-btn::after {
  border: none;
}

.address-error { padding: 20rpx; color: #b45309; background: #fff7ed; }

.create-navigation {
  position: sticky;
  top: 0;
  z-index: 110;
  padding-top: 20px;
  padding-top: max(20px, env(safe-area-inset-top));
  padding-bottom: 8rpx;
  background: #fff;
}
.create-navigation-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
}
.create-navigation-action {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  min-height: 0;
  padding: 0 14rpx;
  background: transparent;
  color: var(--clean-text);
  font-size: 28rpx;
}
.create-navigation-icon { width: 36rpx; height: 36rpx; }
.create-navigation-back { transform: rotate(180deg); }
.create-navigation-title {
  box-sizing: border-box;
  width: 100%;
  padding: 0 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.enterprise-service-options { display: flex; gap: 16rpx; }
.enterprise-service-card { box-sizing: border-box; flex: 1; min-width: 0; position: relative; padding: 20rpx 16rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; text-align: center; font-size: 28rpx; color: var(--clean-text); background: #fff; }
.enterprise-service-card.selected { background: var(--clean-mint); border-color: var(--clean-green); color: var(--clean-green); }
.enterprise-service-card .service-radio { position: absolute; opacity: 0; width: 1rpx; height: 1rpx; }
.service-caption { display: block; font-size: 25rpx; margin-top: 4rpx; }
.enterprise-cert-options { display: flex; flex-wrap: wrap; gap: 8rpx; }
.enterprise-cert-options .cert-radio { flex: 1; min-width: 160rpx; margin-right: 0; white-space: nowrap; font-size: 26rpx; }
.enterprise-cert-options checkbox { transform: scale(.8); transform-origin: left center; margin-right: -8rpx; }
.enterprise-count-row { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; }
.enterprise-count-control { flex: 1; display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; white-space: nowrap; }
.enterprise-count { box-sizing: border-box; min-width: 100rpx; padding: 18rpx 16rpx; text-align: center; border: 2rpx solid var(--clean-line); border-radius: 22rpx; background: var(--clean-soft); color: var(--clean-text); }
.multi-date-btn { margin: 0; padding: 20rpx 16rpx; font-size: 28rpx; background: var(--clean-mint); border-color: var(--clean-green); color: var(--clean-green); }
.multi-date-btn[disabled] { background: var(--clean-soft); color: var(--clean-muted); border-color: var(--clean-line); }
.project-date-summary { width: 100%; color: var(--clean-green); font-size: 26rpx; }
.project-date-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1100; background: rgba(7,29,23,.65); display: flex; align-items: flex-end; }
.project-date-dialog { width: 100%; box-sizing: border-box; max-height: 90vh; overflow-y: auto; padding: 18rpx 14rpx calc(34rpx + env(safe-area-inset-bottom)); background: #fff; color: #171717; }
.project-date-title { margin-bottom: 20rpx; text-align: center; font-size: 34rpx; font-weight: 600; line-height: 1.5; }
.project-date-count { display: block; margin: 0 0 10rpx 4rpx; color: #37765b; font-size: 26rpx; }
.project-date-range { border: 4rpx solid #d3d5d5; padding: 8rpx 12rpx 14rpx; }
.project-date-range .section-title { margin-bottom: 20rpx; font-weight: 500; }
.project-date-columns { display: flex; gap: 16rpx; font-size: 28rpx; }
.project-date-columns > view { flex: 1; min-width: 0; }
.project-date-columns .picker-display { display: flex; align-items: center; box-sizing: border-box; min-height: 100rpx; margin-top: 12rpx; padding: 14rpx 22rpx; border: 0; border-radius: 8rpx; background: #f5f6f9; font-size: 28rpx; }
.project-date-columns .picker-display.placeholder { color: #92979c; }
.project-date-actions { display: flex; gap: 24rpx; margin: 36rpx 54rpx 0; }
.project-date-actions button { flex: 1; display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 82rpx; margin: 0; padding: 12rpx; border: 2rpx solid #d5d5d5; border-radius: 12rpx; line-height: 1.4; font-size: 28rpx; background: #f2f2f4; color: #717780; }
.project-date-actions button::after { border: 0; }
.project-date-actions .confirm-dates { border-color: transparent; background: linear-gradient(90deg, #0c9556, #7ec47f); color: #fff; }
.project-date-error { display: block; margin-top: 16rpx; color: var(--clean-danger); font-size: 26rpx; }

/* 个人和企业创建订单共用样式。 */
.order-create-navigation { background: #10974b; color: #fff; }
.order-create-navigation .create-navigation-title { font-size: 36rpx; }
.order-create-navigation .create-navigation-action {
  top: 50%;
  bottom: auto;
  height: 76rpx;
  margin: 0;
  color: #fff;
  transform: translateY(-50%);
}
.order-create-navigation .create-navigation-action::after { border: 0; }
.personal-create-back {
  box-sizing: border-box;
  width: 20rpx;
  height: 20rpx;
  border: solid currentColor;
  border-width: 0 0 3rpx 3rpx;
  transform: rotate(45deg);
}

.order-create-form { padding: 16rpx 16rpx calc(152rpx + env(safe-area-inset-bottom)); background: #f4f5f5; }
.order-create-form > .form-section { margin-bottom: 14rpx; padding: 14rpx 18rpx; }
.order-create-form .service-type-section .section-title { padding-bottom: 12rpx; border-bottom: 1rpx solid #aecac2; }
.order-create-form .enterprise-service-options { justify-content: space-between; padding: 0 10rpx 6rpx; }
.order-create-form .enterprise-service-card {
  flex: 0 1 38%;
  padding: 6rpx 14rpx;
  border-color: #dedede;
  border-radius: 8rpx;
  color: #171717;
  line-height: 1.35;
  text-align: left;
}
.order-create-form .enterprise-service-card.selected { background: #06c9aa; border-color: #06c9aa; }
.order-create-form .service-caption { margin-top: 0; font-size: 26rpx; }
.order-create-form .desc-textarea { min-height: 212rpx; }
.order-create-form .voice-btn { margin-top: 10rpx; gap: 32rpx; }

.order-create-form .submit-bar {
  z-index: 100;
  justify-content: flex-end;
  padding: 8rpx 44rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #ededed;
  box-shadow: none;
}
.order-create-form .booking-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;
  width: 348rpx;
  min-width: 0;
  min-height: 98rpx;
  margin: 0;
  padding: 16rpx 12rpx;
  border-radius: 8rpx;
  background: #10974b;
  font-size: 40rpx;
  line-height: 1.4;
}
.order-create-form .booking-btn[disabled] { background: #767b80; color: #fff; opacity: 1; }
.order-create-form .booking-btn::after { border: 0; }

.order-create-navigation .create-navigation-icon { filter: brightness(0) invert(1); }
.order-create-form .multi-date-btn:not([disabled]) {
  background: #f7a423;
  border-color: #f7a423;
  color: #3b260a;
}
