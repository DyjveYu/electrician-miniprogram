@import "../../../styles/clean-page.wxss";
.page-container { box-sizing: border-box; padding: 12rpx 44rpx 0; padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: #fff; }
.form-section { padding: 28rpx 0 32rpx; border-bottom: 2rpx solid var(--clean-line); }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.service-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.service-item { box-sizing: border-box; padding: 18rpx 24rpx; min-height: 80rpx; border: 2rpx solid var(--clean-line); border-radius: 20rpx; font-size: 28rpx; color: var(--clean-text); background: #fff; }
.service-item.active { background: var(--clean-mint); border-color: var(--clean-green); color: var(--clean-green); }
.desc-textarea { box-sizing: border-box; width: 100%; height: 240rpx; padding: 24rpx; background: var(--clean-soft); border: 2rpx solid var(--clean-line); border-radius: 22rpx; font-size: 30rpx; line-height: 1.8; color: var(--clean-text); }
.voice-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 88rpx; margin-top: 16rpx; border: 2rpx solid var(--clean-green); border-radius: 22rpx; color: var(--clean-green); background: var(--clean-mint); }
.voice-btn-text { font-size: 28rpx; }
.voice-btn-recording { border-color: var(--clean-danger); background: #faf0ed; color: var(--clean-danger); }
.voice-btn-icon { width: 32rpx; height: 32rpx; }
.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.uploaded-image, .add-image { box-sizing: border-box; width: 132rpx; height: 132rpx; border-radius: 20rpx; }
.add-image { display: flex; align-items: center; justify-content: center; border: 2rpx dashed #b4c7ba; color: var(--clean-muted); background: var(--clean-soft); font-size: 48rpx; }
.form-item { display: flex; align-items: center; min-height: 88rpx; padding: 20rpx 24rpx; box-sizing: border-box; border-radius: 22rpx; background: var(--clean-soft); border: 2rpx solid var(--clean-line); }
.value { flex: 1; min-width: 0; color: var(--clean-text); font-size: 28rpx; word-break: break-all; }
.placeholder { color: var(--clean-muted); }
.submit-btn, .booking-btn, .footer-btn-add, .record-confirm-btn, .agreement-close-btn, .workno-search button { background: var(--clean-green); color: #fff; }
.submit-btn { width: 100%; white-space: normal; }
.submit-btn.disabled { opacity: .5; }
.submit-bar { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; padding: 20rpx 44rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid var(--clean-line); }
.prepay-text { flex: 1; min-width: 150rpx; font-size: 30rpx; color: var(--clean-green); font-weight: 600; word-break: break-all; }
.booking-btn { flex: 1; min-width: 260rpx; margin: 0; padding: 20rpx 16rpx; }
.sheet-mask, .agreement-mask, .record-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(7,29,23,.65); }
.sheet-mask { z-index: 998; }
.action-sheet { position: fixed; z-index: 999; left: 0; right: 0; bottom: 0; max-height: 80vh; overflow: hidden; background: #fff; border-radius: 40rpx 40rpx 0 0; }
.sheet-header, .record-header, .agreement-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.sheet-header { padding: 28rpx 32rpx 20rpx; }
.sheet-header-spacer { display: none; }
.sheet-header-title, .record-title, .agreement-title { flex: 1; min-width: 0; color: var(--clean-text); font-size: 32rpx; font-weight: 600; }
.close-icon, .record-close, .agreement-close { width: 80rpx; height: 80rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--clean-soft); border-radius: 50%; color: var(--clean-muted); font-size: 44rpx; line-height: 1; }
.sheet-body { height: 44vh; width: 100%; padding: 0 32rpx; box-sizing: border-box; overflow-x: hidden; }
.address-card { position: relative; box-sizing: border-box; width: 100%; display: flex; align-items: center; gap: 16rpx; border: 2rpx solid var(--clean-line); border-radius: 24rpx; padding: 28rpx 24rpx; margin-bottom: 20rpx; background: #fff; }
.address-card-default { border-color: var(--clean-green); background: var(--clean-mint); padding-top: 56rpx; }
.default-badge { position: absolute; left: 24rpx; top: 12rpx; font-size: 22rpx; color: var(--clean-green); }
.default-badge-text { font-size: 22rpx; }
.address-card-main { flex: 1; min-width: 0; }
.addr-title-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx 16rpx; }
.addr-name { font-size: 28rpx; font-weight: 500; word-break: break-all; }
.addr-phone { font-size: 24rpx; color: var(--clean-muted); }
.addr-detail { margin-top: 10rpx; font-size: 26rpx; color: var(--clean-muted); line-height: 1.8; word-break: break-all; }
.addr-edit-btn { width: 80rpx; height: 80rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #fff; border: 2rpx solid var(--clean-line); border-radius: 20rpx; color: var(--clean-green); }
.edit-icon { font-size: 36rpx; }
.empty-tip, .search-empty { text-align: center; padding: 32rpx 16rpx; font-size: 26rpx; color: var(--clean-muted); }
.sheet-footer { padding: 20rpx 32rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.footer-btn-add { width: 100%; }
.terms-label { display: flex; align-items: flex-start; gap: 12rpx; }
.terms-text { flex: 1; min-width: 0; color: var(--clean-muted); font-size: 26rpx; line-height: 1.9; }
.terms-link { color: var(--clean-green); }
.terms-tip { font-size: 24rpx; color: var(--clean-muted); margin-top: 12rpx; }
.electricity-type-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.electricity-type-item { box-sizing: border-box; flex: 1; min-width: 240rpx; display: flex; align-items: center; gap: 10rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; padding: 20rpx 16rpx; font-size: 28rpx; }
.electricity-type-item.selected { border-color: var(--clean-green); color: var(--clean-green); background: var(--clean-mint); }
.electricity-type-gap { display: none; }
.directed-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.directed-label { font-size: 30rpx; font-weight: 600; }
.directed-detail { margin-top: 24rpx; }
.workno-search { display: flex; gap: 16rpx; align-items: center; flex-wrap: wrap; }
.workno-input { flex: 1; min-width: 260rpx; height: 88rpx; box-sizing: border-box; padding: 20rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; background: var(--clean-soft); font-size: 28rpx; }
.workno-search button { min-height: 88rpx; font-size: 28rpx; margin: 0; }
.electrician-card, .directed-hint { padding: 24rpx; background: var(--clean-mint); border-radius: 22rpx; margin-top: 20rpx; }
.electrician-name { display: block; font-size: 30rpx; font-weight: 500; }
.electrician-wn { display: block; font-size: 24rpx; color: var(--clean-muted); margin-top: 8rpx; }
.directed-hint { font-size: 24rpx; color: var(--clean-green); line-height: 1.8; }
.record-mask { z-index: 1000; display: flex; align-items: flex-end; }
.record-panel { box-sizing: border-box; width: 100%; max-height: 85vh; overflow-y: auto; background: #fff; border-radius: 40rpx 40rpx 0 0; padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.wave-box { display: flex; align-items: center; justify-content: center; gap: 6rpx; height: 100rpx; margin: 24rpx 0; }
.wave-bar { width: 8rpx; min-height: 8rpx; border-radius: 4rpx; background: var(--clean-green); transition: height .1s; }
.record-result-box { min-height: 160rpx; padding: 24rpx; border-radius: 22rpx; background: var(--clean-soft); margin-bottom: 28rpx; }
.record-result-text { font-size: 30rpx; line-height: 1.8; word-break: break-all; }
.record-result-placeholder { font-size: 28rpx; color: var(--clean-muted); }
.record-actions { display: flex; gap: 16rpx; flex-wrap: wrap; }
.record-cancel-btn { flex: 1; min-width: 120rpx; border-color: var(--clean-green); color: var(--clean-green); background: var(--clean-mint); }
.record-confirm-btn { flex: 2; min-width: 260rpx; }
.mode-selector { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mode-option { flex: 1; min-width: 220rpx; padding: 24rpx 16rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; text-align: center; }
.mode-option.active { border-color: var(--clean-green); background: var(--clean-mint); }
.mode-label { display: block; color: var(--clean-text); font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.mode-option.active .mode-label { color: var(--clean-green); }
.mode-desc { display: block; font-size: 24rpx; color: var(--clean-muted); }
.time-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.time-item { flex: 1; min-width: 240rpx; }
.time-label { display: block; font-size: 24rpx; color: var(--clean-muted); margin-bottom: 12rpx; }
.cert-radio { display: inline-flex; align-items: center; font-size: 28rpx; padding: 12rpx 0; margin-right: 24rpx; }
.amount-input-box { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; background: var(--clean-soft); }
.amount-currency { font-size: 36rpx; color: var(--clean-green); }
.amount-input { flex: 1; min-width: 0; width: 0; font-size: 32rpx; color: var(--clean-text); }
.fee-hint { display: block; margin-top: 16rpx; font-size: 24rpx; color: var(--clean-muted); line-height: 1.8; }
.fee-num { color: var(--clean-green); font-weight: 500; }
.picker-display { box-sizing: border-box; display: flex; align-items: center; min-height: 88rpx; padding: 20rpx 24rpx; border: 2rpx solid var(--clean-line); background: var(--clean-soft); border-radius: 22rpx; color: var(--clean-text); font-size: 28rpx; word-break: break-all; }
.picker-display.placeholder { color: var(--clean-muted); }
.form-input { box-sizing: border-box; width: 100%; min-height: 96rpx; height: 96rpx; padding: 20rpx 24rpx; margin-top: 16rpx; border: 2rpx solid var(--clean-line); background: var(--clean-soft); border-radius: 22rpx; color: var(--clean-text); font-size: 30rpx; }
.agreement-mask { z-index: 2100; }
.agreement-sheet { position: fixed; z-index: 2101; left: 0; right: 0; bottom: 0; max-height: 85vh; display: flex; flex-direction: column; background: #fff; border-radius: 40rpx 40rpx 0 0; }
.agreement-header { padding: 28rpx 32rpx 20rpx; border-bottom: 2rpx solid var(--clean-line); flex-shrink: 0; }
.agreement-body { flex: 1; height: 48vh; padding: 24rpx 32rpx; box-sizing: border-box; overflow-x: hidden; }
.agreement-content { padding-bottom: 20rpx; }
.agreement-article { margin-top: 24rpx; }
.agreement-p { font-size: 28rpx; line-height: 1.9; word-break: break-all; }
.agreement-date { text-align: right; margin-top: 32rpx; }
.agreement-footer { flex-shrink: 0; padding: 20rpx 32rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.agreement-close-btn { width: 100%; }

.address-error { padding: 20rpx 24rpx; margin: 16rpx 0; color: var(--clean-warn); background: #fff7ed; border-radius: 22rpx; word-break: break-all; }
.address-error button { width: 100%; margin-top: 16rpx; white-space: normal; background: var(--clean-mint); color: var(--clean-green); border-color: var(--clean-green); }
