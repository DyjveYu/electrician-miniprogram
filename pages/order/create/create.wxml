<wxs module="workNumber" src="../../../utils/workNo.wxs" />
<view class="create-navigation" style="{{navigationTop > 0 ? 'padding-top:' + navigationTop + 'px;' : ''}}">
  <view class="create-navigation-row" style="{{navigationHeight > 0 ? 'height:' + navigationHeight + 'px;' : ''}}">
    <button wx:if="{{fromEnterpriseCertification || showCreateBack || showCreateHome}}" class="create-navigation-action" bindtap="goBack" aria-label="{{showCreateHome && !fromEnterpriseCertification ? '首页' : '返回'}}">
      <text wx:if="{{fromEnterpriseCertification}}" decode="{{true}}">&lt; 返回</text>
      <image wx:elif="{{showCreateHome}}" class="create-navigation-icon" src="/images/tab/home.png" mode="aspectFit" aria-hidden="true" />
      <image wx:else class="create-navigation-icon create-navigation-back" src="/images/content-ui/arrow-right.svg" mode="aspectFit" aria-hidden="true" />
    </button>
    <text class="create-navigation-title">{{userType === 'enterprise' ? '创建企业订单' : '创建订单'}}</text>
  </view>
</view>
<view class="page-container {{userType === 'enterprise' ? 'enterprise-create' : ''}}">
  <view class="address-error" wx:if="{{submissionUncertain}}"><text>提交结果未确认，请先查看我的订单，避免重复下单</text><button bindtap="viewOrders">查看我的订单</button></view>
  <!-- 单日快修 / 个人用户表单 -->

  <view class="form-section">
    <view class="section-title">选择服务类型</view>
    <radio-group class="enterprise-service-options" bindchange="onServiceModeChange">
      <label class="enterprise-service-card {{serviceMode === 'on_site' ? 'selected' : ''}}"><radio class="service-radio" value="on_site" checked="{{serviceMode === 'on_site'}}" /><text>上门服务</text><text class="service-caption">维修维护与安装</text></label>
      <label class="enterprise-service-card {{serviceMode === 'off_site' ? 'selected' : ''}}"><radio class="service-radio" value="off_site" checked="{{serviceMode === 'off_site'}}" /><text>不上门服务</text><text class="service-caption">技术服务与加工</text></label>
    </radio-group>
    <text class="fee-hint" wx:if="{{serviceMode === 'off_site'}}">{{orderMode === 'project' ? '付款时选择每人200元押金或整单一口价' : '付款时选择200元订单押金或一口价全额工费'}}</text>
  </view>
  <!-- 问题描述 -->
  <view class="form-section">
    <view class="section-title">{{descriptionTitle}}</view>
    <textarea placeholder="请填写服务内容..."
              value="{{description}}"
              bindinput="onDescriptionInput"
              maxlength="150"
              class="desc-textarea"/>
    <!-- 语音输入按钮：白底长方形 -->
    <view class="voice-btn {{isRecording ? 'voice-btn-recording' : ''}}" catchtap="onMicTap">
      <image class="voice-btn-icon ui-icon" src="/images/content-ui/mic.svg" mode="aspectFit" aria-hidden="true" />
      <text class="voice-btn-text">{{isRecording ? '录音中…' : '订单语音描述'}}</text>
    </view>
  </view>

  <!-- 上传图片 -->
  <view class="form-section">
    <view class="section-title">上传图片（非必填）</view>
    <view class="image-list">
      <block wx:for="{{images}}" wx:key="index">
        <image src="{{item}}" class="uploaded-image" mode="aspectFill" />
      </block>
      <view class="add-image" bindtap="chooseImage" wx:if="{{images.length < 5}}">+</view>
    </view>
  </view>

  <!-- 个人保留用电类型，企业单人仅选择资质 -->
  <view class="form-section" wx:if="{{userType === 'user'}}">
    <view class="section-title">用电类型 <text class="required">*</text></view>
    <radio-group class="electricity-type-group" bindchange="onElectricityTypeChange">
      <label class="electricity-type-item {{electricityType === 'residential' ? 'selected' : ''}}">
        <radio value="residential" checked="{{electricityType === 'residential'}}"  color="#16835c"/>
        <text>居民用电</text>
      </label>
      <view class="electricity-type-gap"></view>
      <label class="electricity-type-item {{electricityType === 'industrial' ? 'selected' : ''}}">
        <radio value="industrial" checked="{{electricityType === 'industrial'}}"  color="#16835c"/>
        <text>工商业用电</text>
      </label>
    </radio-group>
  </view>

  <view class="form-section">
    <view class="section-title">{{userType === 'enterprise' ? '电工需要' : '所需资质'}} <text class="required">*</text></view>
    <checkbox-group wx:if="{{userType === 'enterprise'}}" class="enterprise-cert-options" bindchange="onEnterpriseCertChange">
      <label class="cert-radio"><checkbox value="low_voltage" checked="{{enterpriseLowChecked}}" color="#16835c" />低压电工</label>
      <label class="cert-radio"><checkbox value="high_voltage" checked="{{enterpriseHighChecked}}" color="#16835c" />高压电工</label>
      <label class="cert-radio"><checkbox value="construction" checked="{{enterpriseConstructionChecked}}" color="#16835c" />建筑电工</label>
    </checkbox-group>
    <radio-group wx:else bindchange="onRequiredCertChange">
      <label class="cert-radio"><radio value="low_voltage" checked="{{requiredCertType === 'low_voltage'}}" color="#16835c" />低压电工</label>
      <label class="cert-radio"><radio value="high_voltage" checked="{{requiredCertType === 'high_voltage'}}" color="#16835c" />高压电工</label>
      <label class="cert-radio"><radio value="construction" checked="{{requiredCertType === 'construction'}}" color="#16835c" />建筑电工</label>
    </radio-group>
  </view>
  <block wx:if="{{userType === 'enterprise'}}">
    <view class="form-section enterprise-count-row">
      <view class="enterprise-count-control"><text>需要</text><picker mode="selector" range="{{enterpriseCountRange}}" value="{{enterpriseCount - 1}}" bindchange="onEnterpriseCountChange" disabled="{{submitting || submissionUncertain || showPrepay}}"><view class="enterprise-count">{{enterpriseCount}}⌄</view></picker><text>名着安电工</text></view>
      <button class="multi-date-btn" disabled="{{enterpriseCount === 1 || submitting || submissionUncertain}}" bindtap="openProjectDates">多日期订单</button>
      <text class="project-date-summary" wx:if="{{projectDateConfirmed}}">{{projectDateSummary}}</text>
    </view>
    <view class="form-section" wx:if="{{enterpriseCount > 1 && serviceMode === 'on_site'}}">
      <view class="section-title">工程总费用 <text class="required">*</text></view>
      <view class="amount-input-box"><text class="amount-currency">¥</text><input class="amount-input" type="digit" value="{{projTotalAmount}}" bindinput="onProjAmountInput" placeholder="请输入整个工程的总费用" /></view>
      <text class="fee-hint">含15%平台使用费，整个日期区间只支付一次</text>
      <text class="fee-hint" wx:if="{{projElectricianFee}}">每位电工应得 ¥{{projElectricianFee}}</text>
    </view>
  </block>
  <!-- 服务地址（非定向时展示） -->
  <view class="form-section" wx:if="{{!isDirected}}">
    <view class="section-title">服务地址</view>
    <text class="fee-hint" wx:if="{{enterpriseCount > 1 && selectedAddress && selectedAddress.district !== enterpriseCertDistrict}}">多人工程请选择与企业认证区县一致的服务地址</text>
    <view class="form-item" bindtap="openAddressSheet">
      <view class="value">
        <text wx:if="{{selectedAddressStr}}">{{selectedAddressStr}}</text>
        <text wx:else class="placeholder">点击选择地址</text>
      </view>
    </view>
  </view>

  <!-- 底部提交预约条 -->
  <view class="submit-bar">
    <button class="booking-btn" bindtap="submitOrder" loading="{{submitting}}" disabled="{{!canSubmit}}">
      {{submitting ? '正在创建订单' : '立即生成订单'}}
    </button>
  </view>

  <!-- 地址选择弹层 -->
  <view wx:if="{{showAddressSheet}}" class="sheet-mask" bindtap="closeAddressSheet"></view>
  <view wx:if="{{showAddressSheet}}" class="action-sheet" catchtouchmove="true">
    <view class="sheet-header">
      <view class="sheet-header-spacer"></view>
      <text class="sheet-header-title">选择服务地址</text>
      <view class="close-icon" bindtap="closeAddressSheet">×</view>
    </view>
    <scroll-view scroll-y="true" class="sheet-body">
      <view class="address-card {{item.isDefault ? 'address-card-default' : ''}}" wx:for="{{addresses}}" wx:key="id">
        <view class="default-badge" wx:if="{{item.isDefault}}">
          <text class="default-badge-text">默认</text>
        </view>
        <view class="address-card-main" bindtap="selectAddress" data-address="{{item}}">
          <view class="addr-title-row">
            <text class="addr-name">{{item.contactName}}</text>
            <text class="addr-phone">{{item.contactPhone}}</text>
          </view>
          <view class="addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
        </view>
        <view class="addr-edit-btn" data-id="{{item.id}}" bindtap="editAddress">
          <text class="edit-icon">✎</text>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{!loadingAddresses && !addressError && addresses.length === 0}}">暂无地址，请新增</view>
    </scroll-view>
    <view class="sheet-footer">
      <button class="footer-btn-add" bindtap="addAddress">添加服务地址</button>
    </view>
  </view>


  <view wx:if="{{showProjectDates}}" class="project-date-mask" bindtap="cancelProjectDates" catchtouchmove="noop">
    <view class="project-date-dialog" catchtap="noop">
      <view class="project-date-title">企业多日期订单</view>
      <text class="project-date-count">已选择需要{{enterpriseCount}}名着安电工</text>
      <view class="project-date-range">
        <view class="section-title">订单起止日期</view>
        <view class="project-date-columns">
          <view><text>开始日期</text><picker mode="date" start="{{minProjectDate}}" value="{{draftStartDate}}" data-field="draftStartDate" bindchange="onProjectDraftDate"><view class="picker-display">{{draftStartLabel || '请选择日期'}}</view></picker></view>
          <view><text>结束日期</text><picker mode="date" start="{{draftStartDate || minProjectDate}}" value="{{draftEndDate}}" data-field="draftEndDate" bindchange="onProjectDraftDate"><view class="picker-display">{{draftEndLabel || '请选择日期'}}</view></picker></view>
        </view>
      </view>
      <text class="fee-hint">包含开始和结束日，共2至29天</text>
      <text class="project-date-error" wx:if="{{projectDateError}}">{{projectDateError}}</text>
      <view class="project-date-actions"><button bindtap="cancelProjectDates">取消</button><button class="confirm-dates" bindtap="confirmProjectDates">确定</button></view>
    </view>
  </view>

  <!-- 语音录音弹出层（单日快修 & 多日工程共用） -->
  <view class="record-mask" wx:if="{{showRecordPanel}}" catchtap="noop">
    <view class="record-panel" catchtouchmove="true">

      <!-- 顶部：标题 + 关闭按钮 -->
      <view class="record-header">
        <text class="record-title">语音输入</text>
        <view class="record-close" catchtap="onRecordClose">×</view>
      </view>

      <!-- 波形动画 -->
      <view class="wave-box">
        <view class="wave-bar"
              wx:for="{{waveBars}}"
              wx:key="index"
              style="height: {{item}}rpx;"></view>
      </view>

      <!-- 实时识别文字展示区 -->
      <view class="record-result-box">
        <text class="record-result-text" wx:if="{{realtimeText}}">{{realtimeText}}</text>
        <text class="record-result-placeholder" wx:else>正在识别，请说话…</text>
      </view>

      <!-- 底部按钮 -->
      <view class="record-actions">
        <button class="record-cancel-btn" catchtap="onRecordClose">取消</button>
        <button class="record-confirm-btn" catchtap="onRecordConfirm">结束并输入文字</button>
      </view>

    </view>
  </view>

</view>

<order-prepay enterprise-onsite="{{createdEnterpriseOnsite}}" pricing-mode="{{createdPricingMode}}" project-price="{{createdProjectPrice}}" visible="{{showPrepay}}" project="{{createdIsProject}}" order-id="{{createdOrderId}}" offsite="{{createdIsOffsite}}" amount="{{createdPrepayAmount}}" bind:confirm="confirmPersonalPrepay" bind:close="closePersonalPrepay" />
