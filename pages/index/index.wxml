<view class="home-viewport">
  <view class="home-navigation {{currentRole === 'electrician' ? 'home-navigation-electrician' : (currentRole === 'user' || currentRole === 'enterprise' ? 'home-navigation-order' : '')}}" style="padding-top: {{navTop}}px;">
    <view class="home-navigation-body" style="height: {{navHeight}}px; padding: 0 {{navInset}}px;">
      <text class="home-navigation-title">找电工 上着安</text>
    </view>
  </view>
  <view class="home-fixed" wx:if="{{currentRole === 'user' || currentRole === 'enterprise'}}">
    <!-- 主要服务卡片 -->
    <view class="service-card" bindtap="createOrder">
      <image class="service-icon" src="/images/content-ui/zap.svg" mode="aspectFit" aria-hidden="true" />
      <view class="service-info">
        <text class="service-title">立即下单</text>
        <text class="service-desc">持证电工为您服务</text>
      </view>
      <view class="service-arrow">></view>
    </view>

    <!-- 服务范围说明 -->
    <view class="service-scope">
      <view class="scope-title">居民商业工业用电设备安装维修维护技术服务</view>
      <view class="scope-body">电机与水泵、配电箱与配电柜、线路与控制。新能源与光伏、充电桩、监控与弱电。电取暖与电热器、灯具与照明、制冷与空调。PLC与变频控制、电气设备、变压器。智能家居、巡检维护、技术服务、远程协作。</view>
    </view>

  </view>
  <view class="order-tabs" wx:elif="{{currentRole === 'electrician'}}">
    <button class="order-tab {{orderTab === 'onsite' ? 'order-tab-active' : ''}}" data-tab="onsite" bindtap="selectOrderTab">上门订单</button>
    <button class="order-tab {{orderTab === 'offsite' ? 'order-tab-active' : ''}}" data-tab="offsite" bindtap="selectOrderTab">不上门订单</button>
  </view>
  <scroll-view class="home-scroll {{currentRole === 'user' || currentRole === 'enterprise' ? 'home-scroll-order' : ''}}" scroll-y refresher-enabled refresher-triggered="{{homeRefreshing}}"
    bindrefresherrefresh="onPullDownRefresh" bindscrolltolower="onOrderScrollLower">
    <view class="home-order-heading" wx:if="{{currentRole === 'user' || currentRole === 'enterprise'}}">
      <text class="section-title">我的订单</text>
      <text class="section-more" bindtap="viewAllOrders">查看全部</text>
    </view>
    <view class="electrician-orders" wx:elif="{{currentRole === 'electrician'}}">
      <view class="electrician-order-card" wx:for="{{orderTab === 'onsite' ? nearbyOrders : nationalOrders}}" wx:key="id">
        <view class="electrician-order-main">
          <image class="electrician-order-image" src="{{item.cardImage || defaultOrderImage}}" mode="aspectFill"
            data-tab="{{orderTab}}" data-index="{{index}}" data-source="{{item.cardImage}}" binderror="onOrderImageError" />
          <view class="electrician-order-info" data-id="{{item.id}}" bindtap="viewOrderDetail">
            <text class="electrician-order-description">{{item.cardDescription}}</text>
            <text wx:if="{{item.cardAddress}}" class="electrician-order-address">{{item.cardAddress}}</text>
            <view wx:if="{{item.cardDeadline}}" class="electrician-order-deadline">
              <text class="electrician-order-deadline-label">截止时间：</text>
              <text class="electrician-order-deadline-value">{{item.cardDeadline}}</text>
            </view>
          </view>
          <view class="electrician-order-action">
            <view wx:if="{{item.cardFee}}" class="electrician-order-fee">{{item.cardFeeLabel}} <text>¥{{item.cardFee}}</text></view>
            <button class="electrician-take-order" data-id="{{item.id}}" bindtap="takeOrder">接单</button>
          </view>
        </view>
      </view>
      <block wx:if="{{orderTab === 'onsite'}}">
        <view wx:if="{{loading}}" class="empty-state">正在读取上门订单…</view>
        <view wx:elif="{{nearbyError}}" class="empty-state" bindtap="retryNearbyOrders">{{nearbyError}}（点击重试）</view>
        <view wx:elif="{{!nearbyOrders.length}}" class="empty-state">暂无可接的上门订单</view>
      </block>
      <block wx:else>
        <view wx:if="{{nationalLoading}}" class="empty-state">正在读取全国订单…</view>
        <view wx:elif="{{nationalError}}" class="empty-state" bindtap="retryNationalOrders">{{nationalError}}（点击重试）</view>
        <view wx:elif="{{!nationalOrders.length}}" class="empty-state">暂无符合当前资质的全国不上门订单</view>
        <view wx:elif="{{!nationalHasMore}}" class="national-end">已显示全部可接订单</view>
        <view wx:if="{{nationalPage && nationalHasMore && !nationalError}}" class="national-pagination-sentinel"></view>
        <view wx:if="{{nationalOrders.length}}" class="section-more" bindtap="viewNationalOrders">查看更多</view>
      </block>
      <view wx:if="{{orderSubscriptionEnabled}}" class="order-subscription">
        <view class="order-subscription-copy">
          <text class="order-subscription-title">微信新订单提醒</text>
          <text class="order-subscription-note">每次订阅可接收一条符合接单条件的新订单通知</text>
        </view>
        <button class="order-subscription-button" bindtap="subscribeNewOrders" loading="{{orderSubscriptionBusy}}" disabled="{{orderSubscriptionBusy}}">订阅提醒</button>
      </view>
    </view>
    <view class="home-public-content" wx:if="{{currentRole !== 'electrician'}}">
      <electrician-home-entry in-order-card="{{currentRole === 'user' || currentRole === 'enterprise'}}" />
      <safety-knowledge-entry in-order-card="{{currentRole === 'user' || currentRole === 'enterprise'}}" />
      <notice-board />
      <home-ads />
      <view class="home-brand-footer">着安电工服务平台</view>
    </view>
    <home-ads wx:else />
  </scroll-view>
</view>
