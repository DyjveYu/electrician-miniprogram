/* pages/index/index.wxss */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部位置栏 */
.location-bar {
  background: linear-gradient(135deg, #0F9D58 0%, #81C784 100%);
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: white;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.location-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.location-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.location-text {
  font-size: 32rpx;
  font-weight: 500;
  text-align: left;
}

.location-arrow {
  font-size: 28rpx;
  opacity: 0.8;
  margin-left: 20rpx;
}

/* 用户角色界面 */
.user-content {
  padding: 0 30rpx;
}

/* 主要服务卡片 */
.service-card {
  background: linear-gradient(135deg, #0F9D58 0%, #81C784 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 157, 88, 0.28);
  margin: 20rpx 0 40rpx;
  display: flex;
  align-items: center;
}

.service-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.service-info {
  flex: 1;
}

.service-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 10rpx;
}

.service-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.service-arrow {
  font-size: 32rpx;
  color: white;
  opacity: 0.8;
}

/* 电工角色界面 */
.electrician-content {
  padding: 0 30rpx;
}

/* 电工工作台 */
.electrician-dashboard {
  display: flex;
  gap: 20rpx;
  margin: -20rpx 0 40rpx;
}

.dashboard-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-top: 20rpx;
}

.dashboard-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
}

.dashboard-title {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

/* 通用区域样式 */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f2937;
}

.section-subtitle {
  font-size: 26rpx;
  color: #6b7280;
}

.section-more {
  color: #6366f1;
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #6b7280;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #9ca3af;
  margin-bottom: 15rpx;
  display: block;
}

.empty-desc {
  font-size: 26rpx;
  color: #d1d5db;
  display: block;
}

/* 用户订单列表 */
.order-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.order-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-item:last-child {
  border-bottom: none;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-completed {
  background: #dcfce7;
  color: #16a34a;
}

.status-pending {
  background: #fef3c7;
  color: #d97706;
}

.status-in_progress {
  background: #dbeafe;
  color: #2563eb;
}

.order-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.order-electrician {
  font-size: 26rpx;
  color: #6b7280;
}

.order-time {
  font-size: 26rpx;
  color: #6b7280;
}

.order-rating {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.rating-text {
  font-size: 26rpx;
  color: #f59e0b;
}

/* 服务范围说明框 */
.service-scope {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.scope-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.scope-body {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.8;
}

.price-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #6366f1;
}

/* 电工附近订单列表 */
.nearby-order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nearby-order-item {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.order-card {
  padding: 30rpx;
}

.order-details {
  margin: 20rpx 0;
}

.detail-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.detail-label {
  font-size: 26rpx;
  color: #6b7280;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #374151;
  flex: 1;
}

.detail-value.price {
  color: #f59e0b;
  font-weight: 600;
}

.order-description {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0;
}

.description-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
}

.order-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.detail-btn {
  flex: 1;
  background: #f3f4f6;
  color: #374151;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

.take-order-btn {
  flex: 1;
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.3);
}

/* 抢单报价弹窗 */
/* 报价弹窗样式已移除 */


/* M1.5：三入口共用的清爽实用公共区，订单区保持原样。 */
.home-public-content { background: #fff; }
.home-brand-footer { background: #fff; color: #687a71; font-size: 22rpx; line-height: 1.5; padding: 40rpx 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); text-align: center; }

.home-viewport { --order-home-background: #f3f3f3; display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fff; }
.home-navigation { flex: 0 0 auto; background: #fff; color: #000; }
.home-navigation-electrician { background: #009988; color: #fff; }
.home-navigation-order { background: #10974b; color: #fff; }
.home-navigation-order .home-navigation-title { letter-spacing: 3rpx; }
.home-navigation-body { box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.home-navigation-title { flex-shrink: 0; font-size: 17px; line-height: 1.25; font-weight: 600; white-space: nowrap; }
.home-navigation-electrician .home-navigation-title { font-size: 18px; }
.home-fixed { flex: 0 0 auto; box-sizing: border-box; padding: 40rpx 44rpx 0; background: var(--order-home-background); }
.home-fixed .service-card { min-height: 220rpx; box-sizing: border-box; gap: 26rpx; margin: 0 0 38rpx; padding: 32rpx 34rpx; background: linear-gradient(115deg, #139653, #76c585); }
.home-fixed .service-icon { flex-shrink: 0; width: 80rpx; height: 80rpx; margin: 0; filter: brightness(0) saturate(100%) invert(77%) sepia(57%) saturate(1077%) hue-rotate(76deg) brightness(108%); }
.home-fixed .service-info { min-width: 0; }
.home-fixed .service-title { font-size: 38rpx; }
.home-fixed .service-desc { font-size: 34rpx; }
.home-fixed .service-scope { margin-bottom: 0; }
.home-scroll { flex: 1 1 0; height: 0; min-height: 0; overflow: hidden; }
.home-scroll-order { background: var(--order-home-background); }
.home-scroll-order .home-public-content {
  margin: 0 44rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, .05);
}
.home-order-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx 44rpx 30rpx; background: var(--order-home-background); }
.nearby-bounded { height: 26vh; }
.national-order-row { padding: 22rpx 0; border-bottom: 1rpx solid var(--clean-line); color: var(--clean-text); }
.national-order-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.national-order-meta { color: var(--clean-muted); font-size: 24rpx; line-height: 1.5; }
.national-order-summary { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 26rpx; line-height: 1.5; word-break: break-word; }
.national-end { padding: 20rpx 0; text-align: center; }
@media (max-height: 550px) {
  .home-fixed { padding-top: 12rpx; }
  .home-fixed .service-card { min-height: 0; padding-top: 16rpx; padding-bottom: 16rpx; margin-bottom: 12rpx; }
  .home-fixed .scope-body { line-height: 1.5; }
}
.order-subscription { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; margin-bottom: 32rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; }
.order-subscription-copy { flex: 1; min-width: 0; }
.order-subscription-title { display: block; font-size: 28rpx; font-weight: 500; }
.order-subscription-note { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--clean-muted); line-height: 1.6; }
.order-subscription-button { flex-shrink: 0; margin: 0; padding: 0 20rpx; font-size: 24rpx; line-height: 2.8; color: var(--clean-green); background: var(--clean-mint); border-radius: 16rpx; }
.order-subscription-button::after { border: none; }
.order-tabs {
  box-sizing: border-box; display: flex; flex: 0 0 auto; gap: 6px;
  padding: 5px 6px 0; background: #c7f8c7;
}
.order-tab {
  position: relative; flex: 1; min-width: 0; margin: 0; padding: 10px 0 12px;
  border-radius: 8px 8px 0 0; background: #c7f8c7; color: #666; font-size: 17px; line-height: 1.3;
}
.order-tab::after, .electrician-take-order::after { border: 0; }
.order-tab-active { background: #fff; color: #222; font-weight: 600; }
.order-tab-active::before {
  position: absolute; bottom: 3px; left: 50%; width: 26px; height: 3px;
  transform: translateX(-50%); border-radius: 2px; background: #ff7a00; content: '';
}
.electrician-orders { background: #edf0f3; padding: 10px 12px 12px; }
.electrician-order-card {
  padding: 10px; margin-bottom: 8px; background: #fff; border-radius: 8px;
}
.electrician-order-main { display: flex; align-items: flex-start; gap: 10px; }
.electrician-order-image { width: 16vw; max-width: 72px; height: 16vw; max-height: 72px; flex: 0 0 auto; border-radius: 8px; background: #eff7f1; }
.electrician-order-info { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.electrician-order-description, .electrician-order-address {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; color: #222; line-height: 1.3;
}
.electrician-order-description { font-size: 17px; font-weight: 600; }
.electrician-order-address { margin-top: 4px; font-size: 15px; }
.electrician-order-deadline { display: flex; flex-wrap: wrap; margin-top: 6px; color: #666; font-size: 14px; line-height: 1.35; }
.electrician-order-deadline-label { white-space: nowrap; }
.electrician-order-deadline-value { min-width: 0; overflow-wrap: anywhere; }
.electrician-order-action { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; max-width: 31%; }
.electrician-order-fee { color: #666; font-size: 15px; text-align: right; overflow-wrap: anywhere; }
.electrician-order-fee text { color: #ff5500; font-size: 18px; font-weight: 600; }
.electrician-take-order {
  box-sizing: border-box; display: flex; align-items: center; justify-content: center;
  width: 76px; height: 23px; min-height: 0; margin: 0; padding: 0; border: 0; color: #fff;
  font-size: 16px; font-weight: 600; line-height: 1; background: #087958; border-radius: 5px;
}
.electrician-orders .national-end { color: #666; font-size: 13px; }
.national-pagination-sentinel { height: 1px; }
