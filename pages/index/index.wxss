@import "../../styles/clean-page.wxss";
.home-viewport { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fff; }
.home-navigation { flex: 0 0 auto; background: #fff; color: #000; }
.home-navigation-electrician { background: #009988; color: #fff; }
.home-navigation-body { box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.home-navigation-title { flex-shrink: 0; font-size: 17px; line-height: 1.25; font-weight: 600; white-space: nowrap; }
.home-navigation-electrician .home-navigation-title { font-size: 18px; }
.home-fixed { flex: 0 0 auto; box-sizing: border-box; padding: 24rpx 44rpx 0; background: #fff; }
.home-scroll { flex: 1 1 0; height: 0; min-height: 0; overflow: hidden; }
.nearby-bounded { height: 26vh; }
.national-order-row { padding: 22rpx 0; border-bottom: 1rpx solid var(--clean-line); color: var(--clean-text); }
.national-order-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.national-order-meta { color: var(--clean-muted); font-size: 24rpx; line-height: 1.5; }
.national-order-summary { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 26rpx; line-height: 1.5; word-break: break-word; }
.national-end { padding: 20rpx 0; text-align: center; }
@media (max-height: 550px) {
  .home-fixed { padding-top: 12rpx; }
  .home-fixed .service-card { padding-top: 16rpx; padding-bottom: 16rpx; margin-bottom: 12rpx; }
  .home-fixed .scope-body { line-height: 1.5; }
}
.container { box-sizing: border-box; padding: 32rpx 44rpx 0; background: #fff; }
.user-content, .electrician-content { padding: 0; }
.service-card { display: flex; align-items: center; gap: 24rpx; padding: 36rpx 28rpx; border-radius: 26rpx; background: var(--clean-mint); color: var(--clean-text); margin-bottom: 32rpx; }
.service-icon { background: #fff; }
.service-info { flex: 1; min-width: 0; }
.service-title { display: block; margin-bottom: 8rpx; font-size: 38rpx; font-weight: 600; }
.service-desc { display: block; font-size: 26rpx; color: var(--clean-muted); }
.service-arrow { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 56rpx; height: 56rpx; background: var(--clean-green); color: #fff; border-radius: 18rpx; font-size: 32rpx; }
.service-scope { padding: 0 0 32rpx; margin-bottom: 32rpx; border-bottom: 2rpx solid var(--clean-line); }
.scope-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.scope-body { font-size: 26rpx; line-height: 1.9; color: var(--clean-muted); }
.order-subscription { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; margin-bottom: 32rpx; border: 2rpx solid var(--clean-line); border-radius: 22rpx; }
.order-subscription-copy { flex: 1; min-width: 0; }
.order-subscription-title { display: block; font-size: 28rpx; font-weight: 500; }
.order-subscription-note { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--clean-muted); line-height: 1.6; }
.order-subscription-button { flex-shrink: 0; margin: 0; padding: 0 20rpx; font-size: 24rpx; line-height: 2.8; color: var(--clean-green); background: var(--clean-mint); border-radius: 16rpx; }
.order-subscription-button::after { border: none; }
.section { margin-bottom: 36rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; }
.section-more { color: var(--clean-green); font-size: 26rpx; padding: 12rpx 0 12rpx 16rpx; }
.section-subtitle { color: var(--clean-muted); font-size: 24rpx; }
.order-list { background: var(--clean-soft); border-radius: 24rpx; padding: 0 24rpx; }
.order-item { padding: 28rpx 0; border-bottom: 2rpx solid var(--clean-line); }
.order-item:last-child { border-bottom: none; }
.order-header { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 20rpx; }
.order-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; overflow-wrap: break-word; word-break: break-all; }
.order-status { flex-shrink: 0; max-width: 45%; padding: 4rpx 12rpx; border-radius: 10rpx; font-size: 22rpx; background: var(--clean-mint); color: var(--clean-green); }
.status-pending { background: #faf4e9; color: var(--clean-warn); }
.status-cancelled, .status-closed { background: var(--clean-line); color: var(--clean-muted); }
.order-info, .order-rating { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 20rpx; }
.order-info { font-size: 24rpx; color: var(--clean-muted); }
.order-rating { margin-top: 16rpx; align-items: center; }
.rating-text { color: var(--clean-warn); font-size: 24rpx; }
.price-text { color: var(--clean-green); font-size: 30rpx; font-weight: 600; }
.nearby-order-list { display: flex; flex-direction: column; gap: 24rpx; }
.nearby-order-item { background: #fff; border: 2rpx solid var(--clean-line); border-radius: 24rpx; overflow: hidden; }
.order-card { padding: 28rpx 24rpx; }
.detail-row { display: flex; align-items: flex-start; gap: 12rpx; margin: 12rpx 0; font-size: 26rpx; }
.detail-label { flex-shrink: 0; color: var(--clean-muted); }
.detail-value { flex: 1; min-width: 0; word-break: break-all; }
.detail-value.price { color: var(--clean-green); font-weight: 500; }
.order-description { background: var(--clean-soft); border-radius: 16rpx; padding: 20rpx; margin-top: 24rpx; }
.description-text { font-size: 26rpx; overflow-wrap: break-word; }
.order-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.detail-btn, .take-order-btn { flex: 1; min-width: 0; }
.detail-btn { border-color: var(--clean-green); background: var(--clean-mint); color: var(--clean-green); }
.take-order-btn { background: var(--clean-green); color: #fff; }
.loading, .empty-state { text-align: center; padding: 56rpx 24rpx; background: var(--clean-soft); border-radius: 24rpx; color: var(--clean-muted); }
.empty-text { display: block; font-size: 28rpx; }
.empty-desc { display: block; margin-top: 12rpx; font-size: 24rpx; }
.home-public-content { background: #fff; }
.home-brand-footer { color: var(--clean-muted); font-size: 22rpx; padding: 40rpx 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); text-align: center; }
.order-tabs {
  box-sizing: border-box; display: flex; flex: 0 0 auto; gap: 6px;
  padding: 5px 6px 0; background: #c7f8c7;
}
.order-tab {
  position: relative; flex: 1; min-width: 0; margin: 0; padding: 10px 0 12px;
  border-radius: 8px 8px 0 0; background: #c7f8c7; color: #666; font-size: 17px; line-height: 1.3;
}
.order-tab::after, .electrician-take-order::after { border: 0; }
.order-tab-active { background: #fff; color: #222; font-weight: 600; }
.order-tab-active::before {
  position: absolute; bottom: 3px; left: 50%; width: 26px; height: 3px;
  transform: translateX(-50%); border-radius: 2px; background: #ff7a00; content: '';
}
.electrician-orders { background: #edf0f3; padding: 10px 12px 12px; }
.electrician-order-card {
  padding: 10px; margin-bottom: 8px; background: #fff; border-radius: 8px;
}
.electrician-order-main { display: flex; align-items: flex-start; gap: 10px; }
.electrician-order-image { width: 16vw; max-width: 72px; height: 16vw; max-height: 72px; flex: 0 0 auto; border-radius: 8px; background: #eff7f1; }
.electrician-order-info { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.electrician-order-description, .electrician-order-address {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; color: #222; line-height: 1.3;
}
.electrician-order-description { font-size: 17px; font-weight: 600; }
.electrician-order-address { margin-top: 4px; font-size: 15px; }
.electrician-order-deadline { display: flex; flex-wrap: wrap; margin-top: 6px; color: #666; font-size: 14px; line-height: 1.35; }
.electrician-order-deadline-label { white-space: nowrap; }
.electrician-order-deadline-value { min-width: 0; overflow-wrap: anywhere; }
.electrician-order-action { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; max-width: 31%; }
.electrician-order-fee { color: #666; font-size: 15px; text-align: right; overflow-wrap: anywhere; }
.electrician-order-fee text { color: #ff5500; font-size: 18px; font-weight: 600; }
.electrician-take-order {
  box-sizing: border-box; display: flex; align-items: center; justify-content: center;
  width: 76px; height: 23px; min-height: 0; margin: 0; padding: 0; border: 0; color: #fff;
  font-size: 16px; font-weight: 600; line-height: 1; background: #087958; border-radius: 5px;
}
.electrician-orders .national-end { color: #666; font-size: 13px; }
.national-pagination-sentinel { height: 1px; }
