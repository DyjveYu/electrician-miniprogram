@import "../../styles/clean-page.wxss";
.container { box-sizing: border-box; padding: 32rpx 44rpx 0; background: #fff; }
.user-content, .electrician-content { padding: 0; }
.service-card { display: flex; align-items: center; gap: 24rpx; padding: 36rpx 28rpx; border-radius: 26rpx; background: var(--clean-mint); color: var(--clean-text); margin-bottom: 32rpx; }
.service-icon { background: #fff; }
.service-info { flex: 1; min-width: 0; }
.service-title { display: block; margin-bottom: 8rpx; font-size: 38rpx; font-weight: 600; }
.service-desc { display: block; font-size: 26rpx; color: var(--clean-muted); }
.service-arrow { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 56rpx; height: 56rpx; background: var(--clean-green); color: #fff; border-radius: 18rpx; font-size: 32rpx; }
.service-scope { padding: 0 0 32rpx; margin-bottom: 32rpx; border-bottom: 2rpx solid var(--clean-line); }
.scope-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.scope-body { font-size: 26rpx; line-height: 1.9; color: var(--clean-muted); }
.electrician-dashboard { display: flex; gap: 20rpx; margin-bottom: 40rpx; }
.dashboard-item { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 28rpx 12rpx; border-radius: 22rpx; background: var(--clean-mint); color: var(--clean-green); }
.dashboard-title { font-size: 28rpx; font-weight: 500; }
.section { margin-bottom: 36rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; }
.section-more { color: var(--clean-green); font-size: 26rpx; padding: 12rpx 0 12rpx 16rpx; }
.section-subtitle { color: var(--clean-muted); font-size: 24rpx; }
.order-list { background: var(--clean-soft); border-radius: 24rpx; padding: 0 24rpx; }
.order-item { padding: 28rpx 0; border-bottom: 2rpx solid var(--clean-line); }
.order-item:last-child { border-bottom: none; }
.order-header { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 20rpx; }
.order-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; overflow-wrap: break-word; word-break: break-all; }
.order-status { flex-shrink: 0; max-width: 45%; padding: 4rpx 12rpx; border-radius: 10rpx; font-size: 22rpx; background: var(--clean-mint); color: var(--clean-green); }
.status-pending { background: #faf4e9; color: var(--clean-warn); }
.status-cancelled, .status-closed { background: var(--clean-line); color: var(--clean-muted); }
.order-info, .order-rating { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 20rpx; }
.order-info { font-size: 24rpx; color: var(--clean-muted); }
.order-rating { margin-top: 16rpx; align-items: center; }
.rating-text { color: var(--clean-warn); font-size: 24rpx; }
.price-text { color: var(--clean-green); font-size: 30rpx; font-weight: 600; }
.nearby-order-list { display: flex; flex-direction: column; gap: 24rpx; }
.nearby-order-item { background: #fff; border: 2rpx solid var(--clean-line); border-radius: 24rpx; overflow: hidden; }
.order-card { padding: 28rpx 24rpx; }
.detail-row { display: flex; align-items: flex-start; gap: 12rpx; margin: 12rpx 0; font-size: 26rpx; }
.detail-label { flex-shrink: 0; color: var(--clean-muted); }
.detail-value { flex: 1; min-width: 0; word-break: break-all; }
.detail-value.price { color: var(--clean-green); font-weight: 500; }
.order-description { background: var(--clean-soft); border-radius: 16rpx; padding: 20rpx; margin-top: 24rpx; }
.description-text { font-size: 26rpx; overflow-wrap: break-word; }
.order-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.detail-btn, .take-order-btn { flex: 1; min-width: 0; }
.detail-btn { border-color: var(--clean-green); background: var(--clean-mint); color: var(--clean-green); }
.take-order-btn { background: var(--clean-green); color: #fff; }
.loading, .empty-state { text-align: center; padding: 56rpx 24rpx; background: var(--clean-soft); border-radius: 24rpx; color: var(--clean-muted); }
.empty-text { display: block; font-size: 28rpx; }
.empty-desc { display: block; margin-top: 12rpx; font-size: 24rpx; }
.home-public-content { background: #fff; }
.home-brand-footer { color: var(--clean-muted); font-size: 22rpx; padding: 40rpx 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); text-align: center; }
