@import "../../styles/clean-surfaces.wxss";

.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 32rpx 44rpx 48rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
}

.subtitle {
  font-size: 26rpx;
  color: #687a71;
  margin-top: 10rpx;
  display: block;
}

.stats-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 600;
  color: #16835c;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #687a71;
  margin-top: 10rpx;
  display: block;
}

.share-section, .rule-section {
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

.share-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e9efeb;
}

.share-item:last-child {
  border-bottom: none;
}

.share-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.share-content {
  flex: 1;
}

.share-title {
  font-size: 28rpx;
  color: #172d25;
  display: block;
}

.share-desc {
  font-size: 22rpx;
  color: #687a71;
  margin-top: 4rpx;
  display: block;
}

.share-arrow {
  font-size: 28rpx;
  color: #687a71;
}

.rule-item {
  display: flex;
  margin-bottom: 16rpx;
}

.rule-dot {
  color: #16835c;
  margin-right: 10rpx;
  font-size: 26rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #687a71;
  line-height: 1.6;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #687a71;
}


/* UI1.1：页面布局及状态精调。 */
.stats-card, .share-section, .rule-section { padding: 28rpx 24rpx; border-radius: 24rpx; margin-bottom: 24rpx; } .stat-row { gap: 16rpx; } .stat-item { min-width: 0; flex: 1; } .stat-number { word-break: break-all; } .share-item { gap: 20rpx; } .share-icon.ui-icon { margin-right: 0; } .share-content { min-width: 0; }
