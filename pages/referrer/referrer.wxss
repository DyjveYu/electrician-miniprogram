.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.stats-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #0F9D58;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.share-section, .rule-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.share-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.share-item:last-child {
  border-bottom: none;
}

.share-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.share-content {
  flex: 1;
}

.share-title {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.share-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.share-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.rule-item {
  display: flex;
  margin-bottom: 16rpx;
}

.rule-dot {
  color: #0F9D58;
  margin-right: 10rpx;
  font-size: 26rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
