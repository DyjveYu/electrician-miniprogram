<!--pages/referrer/apply/apply.wxml-->
<view class="page-container">

  <!-- 头部 -->
  <view class="header">
    <view class="header-title">推荐达人申请</view>
    <view class="header-desc">填写信息后提交，审核通过后使用手机号登录即为推荐达人</view>
  </view>

  <!-- 申请表单 -->
  <view class="apply-form">
    <!-- 姓名 -->
    <view class="form-group">
      <view class="form-label">姓名</view>
      <input
        class="form-input"
        placeholder="请输入真实姓名"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="20"
      />
    </view>

    <!-- 手机号 -->
    <view class="form-group">
      <view class="form-label">手机号</view>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号码"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <!-- 验证码 -->
    <view class="form-group">
      <view class="form-label">验证码</view>
      <view class="code-row">
        <input
          class="form-input code-input"
          type="number"
          placeholder="请输入验证码"
          value="{{code}}"
          bindinput="onCodeInput"
          maxlength="6"
        />
        <button
          class="send-code-btn {{canSendCode ? '' : 'disabled'}}"
          bindtap="sendCode"
          disabled="{{!canSendCode}}"
        >
          {{codeButtonText}}
        </button>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button
      class="submit-btn {{canSubmit ? '' : 'disabled'}}"
      bindtap="submitApply"
      disabled="{{!canSubmit}}"
      loading="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交申请'}}
    </button>

    <!-- 提示信息 -->
    <view class="tips" wx:if="{{errorMsg}}">
      <text class="error-msg">{{errorMsg}}</text>
    </view>
  </view>

  <!-- 成功提示弹窗 -->
  <view class="modal-mask" wx:if="{{showSuccessModal}}" bindtap="closeSuccessModal">
    <view class="modal-dialog" catchtap="">
      <view class="modal-icon">✅</view>
      <view class="modal-title">申请已提交</view>
      <view class="modal-desc">您的推荐达人申请已提交，请等待审核</view>
      <button class="modal-btn" bindtap="closeSuccessModal">我知道了</button>
    </view>
  </view>

</view>
