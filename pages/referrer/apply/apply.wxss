@import "../../../styles/clean-surfaces.wxss";

/* pages/referrer/apply/apply.wxss */

.page-container {
  min-height: 100vh;
  background-color: #fff;
  padding: 0 32rpx;
  padding-bottom: 60rpx;
}

/* ─── 头部 ─── */
.header {
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #687a71;
  line-height: 1.6;
}

/* ─── 表单 ─── */
.apply-form {
  background: #fff;
  border-radius: 22rpx;
  padding: 40rpx 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #172d25;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  background: #f5f7f5;
  border-radius: 22rpx;
  font-size: 28rpx;
  color: #172d25;
  box-sizing: border-box;
}

/* 验证码行 */
.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: auto;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 22rpx;
  border: none;
  text-align: center;
  flex-shrink: 0;
}

.send-code-btn.disabled {
  background: #ccc;
  color: #687a71;
}

.send-code-btn::after {
  border: none;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: auto;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.submit-btn::after {
  border: none;
}

/* ─── 提示信息 ─── */
.tips {
  margin-top: 24rpx;
  text-align: center;
}

.error-msg {
  color: #b74434;
  font-size: 26rpx;
}

/* ─── 成功弹窗 ─── */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(7,29,23,.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2100;
}

.modal-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #687a71;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.modal-btn {
  width: 100%;
  height: auto;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 22rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}


/* UI1.1：页面布局及状态精调。 */
.page-container { padding: 32rpx 44rpx; } .header { padding: 0; text-align: left; margin-bottom: 32rpx; } .apply-form { padding: 0; border: none; background: #fff; } .form-input { height: 96rpx; padding: 20rpx 24rpx; } .send-code-btn, .submit-btn, .modal-btn { height: auto; min-height: 88rpx; padding: 20rpx 24rpx; line-height: 1.6; border-radius: 22rpx; } .code-row .send-code-btn { min-width: 200rpx; flex-shrink: 0; background: #eff7f1; color: #16835c; border: 2rpx solid #16835c; } .modal-dialog { box-sizing: border-box; width: calc(100% - 64rpx); padding: 40rpx 32rpx; border-radius: 40rpx; max-height: 80vh; overflow-y: auto; }
