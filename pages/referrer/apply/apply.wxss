/* pages/referrer/apply/apply.wxss */

.page-container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 0 32rpx;
  padding-bottom: 60rpx;
}

/* ─── 头部 ─── */
.header {
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* ─── 表单 ─── */
.apply-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 验证码行 */
.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background: #0F9D58;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  text-align: center;
  flex-shrink: 0;
}

.send-code-btn.disabled {
  background: #ccc;
  color: #999;
}

.send-code-btn::after {
  border: none;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  margin-top: 20rpx;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  border: none;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.submit-btn::after {
  border: none;
}

/* ─── 提示信息 ─── */
.tips {
  margin-top: 24rpx;
  text-align: center;
}

.error-msg {
  color: #e74c3c;
  font-size: 26rpx;
}

/* ─── 成功弹窗 ─── */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2100;
}

.modal-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background: #0F9D58;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}
