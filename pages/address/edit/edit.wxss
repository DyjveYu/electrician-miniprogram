@import "../../../styles/clean-surfaces.wxss";
/* pages/address/edit/edit.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 表单区域 */
.form-section {
  padding: 20rpx;
}

.form-group {
  background-color: #fff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #e9efeb;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #172d25;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #172d25;
}

.textarea {
  flex: 1;
  font-size: 28rpx;
  color: #172d25;
  min-height: 100rpx;
}

/* 地区选择 */
.region-selector {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.region-text {
  font-size: 26rpx;
  color: #687a71;
}

.placeholder {
  font-size: 28rpx;
  color: #687a71;
}

.arrow {
  font-size: 28rpx;
  color: #687a71;
}

/* 开关项 */
.switch-item {
  justify-content: space-between;
}

/* 保存按钮 */
.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #fff;
  border-top: 2rpx solid #e9efeb;
}

.save-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn.disabled {
  background-color: #ccc;
  color: #687a71;
}

.save-btn::after {
  border: none;
}

/* 新增样式 */
.location-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.location-name {
  font-weight: 600;
  font-size: 32rpx;
  color: #172d25;
  margin-bottom: 4rpx;
}

/* UI1.1：页面布局及状态精调。 */
.section, .form-section { padding: 0; } .form-item { gap: 16rpx; align-items: flex-start; flex-wrap: wrap; } .form-item .label { width: 140rpx; padding-top: 20rpx; color: #687a71; } .form-item .input, .form-item .textarea, .form-item .value, .region-selector { flex: 1; min-width: 200rpx; box-sizing: border-box; } .save-section { padding: 24rpx 0; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); } .save-btn { width: 100%; } .switch-item { align-items: center; }
