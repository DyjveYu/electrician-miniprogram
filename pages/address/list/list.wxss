@import "../../../styles/clean-surfaces.wxss";
/* pages/address/list/list.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 地址列表 */
.address-list {
  padding: 20rpx;
}

.address-item {
  background-color: #fff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: none;
}

.address-content {
  flex: 1;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.contact-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
  margin-right: 20rpx;
}

.contact-phone {
  font-size: 26rpx;
  color: #687a71;
  margin-right: 15rpx;
}

.default-badge {
  background-color: #16835c;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #687a71;
  line-height: 1.4;
}

/* 操作按钮 */
.address-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-left: 20rpx;
}

.action-btn {
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  text-align: center;
  min-width: 80rpx;
}

.action-btn.edit {
  background-color: #eff7f1;
  color: #16835c;
}

.action-btn.delete {
  background-color: #faf0ed;
  color: #b74434;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #687a71;
  margin-bottom: 30rpx;
}

.add-first-btn {
  background-color: #16835c;
  color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  border: none;
}

.add-first-btn::after {
  border: none;
}

/* 添加按钮 */
.add-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #fff;
  border-top: 2rpx solid #e9efeb;
}

.add-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn::after {
  border: none;
}

/* UI1.1：页面布局及状态精调。 */
.container { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); } .address-list { padding: 0; } .address-item { align-items: flex-start; flex-wrap: wrap; gap: 20rpx; border: 2rpx solid #e9efeb; padding: 28rpx 24rpx; } .address-content { min-width: 220rpx; } .address-header { flex-wrap: wrap; gap: 8rpx 12rpx; } .contact-name, .contact-phone { margin: 0; word-break: break-all; } .address-detail { word-break: break-all; } .address-actions { flex-direction: row; margin: 0; flex-wrap: wrap; gap: 16rpx; } .action-btn { min-height: 76rpx; box-sizing: border-box; padding: 16rpx 24rpx; font-size: 26rpx; } .add-section { padding: 20rpx 44rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); } .add-btn { width: 100%; }
