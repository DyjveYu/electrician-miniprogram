@import "../../styles/clean-surfaces.wxss";
/* pages/service-types/service-types.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding: 32rpx 44rpx 48rpx;
}

/* 服务列表 */
.service-list {
  margin-bottom: 30rpx;
}

.service-item {
  background-color: #fff;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: none;
  transition: all 0.3s;
}

.service-item:active {
  transform: scale(0.98);
  box-shadow: none;
}

.service-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.service-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background-color: #e9efeb;
  border-radius: 50%;
  margin-right: 20rpx;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 8rpx;
}

.service-price {
  font-size: 26rpx;
  color: #16835c;
  font-weight: 500;
}

.arrow {
  font-size: 28rpx;
  color: #687a71;
}

.service-desc {
  font-size: 26rpx;
  color: #687a71;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.service-features {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.feature-tag {
  background-color: #eff7f1;
  color: #16835c;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

/* 说明区域 */
.tips-section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 22rpx;
  box-shadow: none;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e9efeb;
}

.tips-content {
  /* 提示内容样式 */
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #687a71;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.service-list { padding: 0; } .service-item { border: 2rpx solid #e9efeb; border-radius: 24rpx; } .service-icon { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; flex-shrink: 0; background: #eff7f1; border-radius: 24rpx; } .service-info { min-width: 0; }
