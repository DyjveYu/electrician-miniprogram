@import "../../styles/clean-surfaces.wxss";

.container {
  padding: 32rpx 44rpx 48rpx;
  background: #fff;
  min-height: 100vh;
}

.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
  color: #687a71;
  font-size: 28rpx;
}

/* 合作伙伴信息卡片 */
.partner-card {
  background: #eff7f1;
  border-radius: 22rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  color: #fff;
  color: #172d25;
  color: #172d25;
}

.partner-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.partner-rate {
  font-size: 28rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}

.partner-areas {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.area-label {
  font-size: 26rpx;
  opacity: 0.8;
}

.area-tag {
  background: rgba(255,255,255,0.25);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 统计区域 */
.stats-section {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #172d25;
}

.month-picker {
  font-size: 26rpx;
  color: #16835c;
  padding: 8rpx 20rpx;
  border: 1rpx solid #16835c;
  border-radius: 22rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-card {
  width: 50%;
  padding: 20rpx 0;
  text-align: center;
  box-sizing: border-box;
}

.stat-card:nth-child(odd) {
  border-right: 1px solid #e9efeb;
}

.stat-card:nth-child(-n+2) {
  border-bottom: 1px solid #e9efeb;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
}

.stat-card.highlight .stat-num {
  color: #16835c;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #687a71;
  margin-top: 8rpx;
}

/* 电工列表 */
.electrician-section {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
}

.electrician-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f5f7f5;
}

.electrician-item:last-child {
  border-bottom: none;
}

.elec-info {
  display: flex;
  flex-direction: column;
}

.elec-name {
  font-size: 30rpx;
  color: #172d25;
  font-weight: 500;
}

.elec-district {
  font-size: 24rpx;
  color: #687a71;
  margin-top: 4rpx;
}

.elec-detail {
  text-align: right;
}

.elec-phone {
  font-size: 26rpx;
  color: #687a71;
  display: block;
}

.elec-wn {
  font-size: 24rpx;
  color: #687a71;
  margin-top: 4rpx;
  display: block;
}

.empty-tip {
  text-align: center;
  color: #687a71;
  padding: 40rpx 0;
  font-size: 26rpx;
}


/* UI1.1：页面布局及状态精调。 */
.partner-card { background: #eff7f1; color: #172d25; border-radius: 26rpx; padding: 32rpx 28rpx; } .partner-rate, .area-label { color: #687a71; opacity: 1; } .area-tag { color: #16835c; background: #fff; } .stats-section, .electrician-section { border: 2rpx solid #e9efeb; border-radius: 24rpx; } .section-header, .electrician-item { flex-wrap: wrap; gap: 16rpx; } .elec-info, .elec-detail { min-width: 0; } .stat-num, .elec-name, .elec-phone { word-break: break-all; }
