.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 合作伙伴信息卡片 */
.partner-card {
  background: linear-gradient(135deg, #0F9D58, #81C784);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.partner-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.partner-rate {
  font-size: 28rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}

.partner-areas {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.area-label {
  font-size: 26rpx;
  opacity: 0.8;
}

.area-tag {
  background: rgba(255,255,255,0.25);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 统计区域 */
.stats-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.month-picker {
  font-size: 26rpx;
  color: #0F9D58;
  padding: 8rpx 20rpx;
  border: 1rpx solid #0F9D58;
  border-radius: 8rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-card {
  width: 50%;
  padding: 20rpx 0;
  text-align: center;
  box-sizing: border-box;
}

.stat-card:nth-child(odd) {
  border-right: 1px solid #f0f0f0;
}

.stat-card:nth-child(-n+2) {
  border-bottom: 1px solid #f0f0f0;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.stat-card.highlight .stat-num {
  color: #0F9D58;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 电工列表 */
.electrician-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.electrician-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f5f5f5;
}

.electrician-item:last-child {
  border-bottom: none;
}

.elec-info {
  display: flex;
  flex-direction: column;
}

.elec-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.elec-district {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.elec-detail {
  text-align: right;
}

.elec-phone {
  font-size: 26rpx;
  color: #666;
  display: block;
}

.elec-wn {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 26rpx;
}
