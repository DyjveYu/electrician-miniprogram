@import "../../../styles/clean-surfaces.wxss";
/* pages/profile/switch-role/switch-role.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding: 32rpx 44rpx 48rpx;
}

/* 当前角色 */
.current-role {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 22rpx;
  margin-bottom: 30rpx;
  text-align: center;
  box-shadow: none;
}

.current-text {
  font-size: 28rpx;
  color: #687a71;
  margin-right: 10rpx;
}

.role-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #16835c;
}

/* 角色选择区域 */
.roles-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 角色卡片 */
.role-card {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
  box-shadow: none;
}

.role-card.active {
  border-color: #16835c;
  box-shadow: none;
}

.role-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.role-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background-color: #e9efeb;
  border-radius: 50%;
  margin-right: 20rpx;
}

.role-info {
  flex: 1;
}

.role-title {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.role-title .role-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-right: 15rpx;
}

.current-badge {
  background-color: #16835c;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.role-desc {
  font-size: 26rpx;
  color: #687a71;
  line-height: 1.4;
}

/* 功能特性 */
.role-features {
  margin-bottom: 20rpx;
}

.feature-item {
  margin-bottom: 8rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #687a71;
  line-height: 1.5;
}

/* 认证要求 */
.certification-requirement {
  background-color: #f5f7f5;
  padding: 20rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
}

.requirement-text {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 26rpx;
  color: #687a71;
}

.requirement-icon {
  margin-right: 8rpx;
}

.certification-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.status-icon {
  margin-right: 6rpx;
}

.status.certified {
  color: #16835c;
}

.status.uncertified {
  color: #956321;
}

.go-certification {
  color: #16835c;
  font-size: 24rpx;
  margin-left: 20rpx;
}

/* 角色操作 */
.role-action {
  text-align: center;
}

.current-role-btn {
  background-color: #e9efeb;
  color: #687a71;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  display: inline-block;
}

.switch-btn {
  background-color: #16835c;
  color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  display: inline-block;
  transition: background-color 0.3s;
}

.switch-btn:active {
  background-color: #16835c;
}

/* 提示区域 */
.tips-section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 22rpx;
  box-shadow: none;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 15rpx;
}

.tips-content {
  /* 提示内容样式 */
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #687a71;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.tip-item:last-child {
  margin-bottom:0;
}

.role-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; background: #eff7f1; border-radius: 24rpx; }
.role-info { min-width: 0; } .role-header, .role-title { flex-wrap: wrap; gap: 12rpx; } .role-card { border-radius: 24rpx; }
