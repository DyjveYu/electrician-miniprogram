<!--pages/profile/profile/profile.wxml-->
<view class="container">
  <!-- 冻结提示 -->
  <view class="frozen-tip" wx:if="{{isFrozen && currentRole === 'electrician'}}">
    <view class="frozen-content">
      <text class="frozen-icon">❄️</text>
      <view class="frozen-text">
        <text class="frozen-title">账号已被冻结</text>
        <text class="frozen-desc">因连续6个月未接单，您的账号已被冻结</text>
      </view>
    </view>
    <button class="unfreeze-btn" bindtap="applyUnfreeze" loading="{{unfreezing}}">申请解冻</button>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <view class="avatar-section" bindtap="navigateToEdit">
        <image class="avatar" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" />
       
        <view class="role-badge {{currentRole}}">
          {{currentRole === 'enterprise' ? '企业' : (currentRole === 'electrician' ? '电工' : '用户')}}
        </view>
      </view>
      
      <view class="user-info">
     
         <text class="nickname">{{displayName}}</text>
        <text wx:if="{{currentRole === 'electrician' && electricianInfo && electricianInfo.work_no}}" class="work-no">工号：{{electricianInfo.work_no}}</text>
       <!-- 电工认证状态：对所有用户可见，用 certificationStatusText 显示当前状态 -->
 
      </view>
    </view>
    
    <!-- 统计数据 -->
    <view class="stats-section">
      <view class="stat-item">
        <text class="stat-number">{{stats.totalOrders}}</text>
        <text class="stat-label">{{currentRole === 'electrician' ? '接单数' : '下单数'}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.completedOrders}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-item" wx:if="{{currentRole === 'electrician'}}">
        <text class="stat-number">{{stats.rating || '0.0'}}</text>
        <text class="stat-label">评分</text>
      </view>
      <view class="stat-item" wx:if="{{currentRole === 'user' || currentRole === 'enterprise'}}">
        <text class="stat-number">¥{{stats.totalAmount || '0'}}</text>
        <text class="stat-label">总消费</text>
      </view>
    </view>
  </view>

  <!-- 电工信息卡片 
  <view class="electrician-card" wx:if="{{currentRole === 'electrician' && electricianInfo}}">
    <view class="card-title">电工信息</view>
    <view class="electrician-info">
      <view class="info-row">
        <text class="label">真实姓名：</text>
        <text class="value">{{electricianInfo.realName}}</text>
      </view>
      <view class="info-row">
        <text class="label">电工证号：</text>
        <text class="value">{{electricianInfo.certificateNumber}}</text>
      </view>
      <view class="info-row">
        <text class="label">证书有效期：</text>
        <text class="value">{{electricianInfo.certificateExpiry}}</text>
      </view>
      <view class="info-row">
        <text class="label">服务区域：</text>
        <text class="value">{{electricianInfo.serviceArea}}</text>
      </view>
    </view>
  </view>
-->
  <!-- 菜单列表 -->
  <view class="menu-section">
    <!-- 下单入口 - 仅企业角色显示 -->
    <view
      wx:if="{{currentRole === 'enterprise'}}"
      class="menu-item"
      bindtap="navigateToCreateOrder"
    >
      <view class="menu-icon">📋</view>
      <view class="menu-content">
        <text class="menu-title">我要下单</text>
        <text class="menu-desc">单日快修，快速下单</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- 地址管理 -->
    <view 
      class="menu-item"
      wx:if="{{currentRole === 'user'}}"
      data-item="{{menuItems[0]}}"
      bindtap="onMenuItemTap"
    >
      <view class="menu-icon">📍</view>
      <view class="menu-content">
        <text class="menu-title">地址管理</text>
        <text class="menu-desc">管理常用地址</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- 收入金额 - 仅电工角色显示 -->
    <view 
      wx:if="{{currentRole === 'electrician'}}"
      class="menu-item"
      bindtap="navigateToWallet"
    >
      <view class="menu-icon">💰</view>
      <view class="menu-content">
        <text class="menu-title">收入金额</text>
        <text class="menu-desc">可提现: ¥{{wallet.available_balance || '0.00'}}</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- 电工认证 - 仅电工角色显示 -->
    <view
      wx:if="{{currentRole === 'electrician'}}"
      class="menu-item"
      bindtap="handleCertification"
    >
      <view class="menu-icon">🔧</view>
      <view class="menu-content">
        <text class="menu-title">电工认证</text>
        <text class="menu-desc">{{userInfo.isElectrician ? '查看认证信息' : '申请成为电工'}}</text>
      </view>
      <view class="certification-badge">
       <text class="badge-text {{userInfo.certificationStatus === 'approved' ? 'certified' : (userInfo.certificationStatus === 'pending' ? 'pending' : 'uncertified')}}">{{certificationStatusText}}</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- 押金管理 - 仅电工角色显示 -->
    <view
      wx:if="{{currentRole === 'electrician'}}"
      class="menu-item"
      bindtap="navigateToDeposit"
    >
      <view class="menu-icon">💵</view>
      <view class="menu-content">
        <text class="menu-title">押金管理</text>
        <text class="menu-desc">{{depositStatus === 'paid' ? '已缴纳押金' : (depositStatus === 'refunded' ? '已退款' : '未缴纳')}}</text>
      </view>
      <view class="certification-badge">
        <text class="badge-text {{depositStatus === 'paid' ? 'certified' : (depositStatus === 'refunding' ? 'pending' : 'uncertified')}}">{{depositStatus === 'paid' ? '已缴纳' : (depositStatus === 'refunding' ? '退款中' : '未缴纳')}}</text>
      </view>
      <text class="menu-arrow">></text>
    </view>


  </view>

  <!-- 其他功能 -->
  <view class="menu-section">
    <view 
      class="menu-item"
      bindtap="navigateToSettings"
    >
      <view class="menu-icon">⚙️</view>
      <view class="menu-content">
       <text class="menu-title">设置</text> 
        <text class="menu-desc">通知、隐私等设置</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view
      class="menu-item"
      bindtap="navigateToAbout"
    >
      <view class="menu-icon">ℹ️</view>
      <view class="menu-content">
        <text class="menu-title">关于我们</text>
        <text class="menu-desc">版本信息、联系方式</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- 企业认证入口 - 仅企业角色显示 -->
    <view
      wx:if="{{currentRole === 'enterprise'}}"
      class="menu-item"
      bindtap="handleEnterpriseCertification"
    >
      <view class="menu-icon">🏢</view>
      <view class="menu-content">
        <text class="menu-title">企业认证</text>
        <text class="menu-desc">{{enterpriseCertStatusText || '申请企业认证'}}</text>
      </view>
      <view class="certification-badge" wx:if="{{enterpriseCertStatusText}}">
        <text class="badge-text {{enterpriseCertStatus === 'approved' ? 'certified' : 'pending'}}">{{enterpriseCertStatusText}}</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <!-- 合作伙伴入口 - 仅活跃合作伙伴显示 -->
    <view
      wx:if="{{isPartner}}"
      class="menu-item partner-entry"
      bindtap="navigateToPartner"
    >
      <view class="menu-icon">🤝</view>
      <view class="menu-content">
        <text class="menu-title">合作伙伴</text>
        <text class="menu-desc">查看区域数据统计</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">
      退出登录
    </button>
  </view>
</view>