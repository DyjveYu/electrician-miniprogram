@import "../../../styles/clean-page.wxss";
.container { box-sizing: border-box; padding: 32rpx 44rpx 48rpx; background: #fff; min-height: 100vh; }
.user-card { background: var(--clean-mint); padding: 32rpx 28rpx; border-radius: 26rpx; margin-bottom: 32rpx; }
.user-header { display: flex; align-items: center; gap: 24rpx; padding-bottom: 32rpx; }
.avatar-section { position: relative; flex-shrink: 0; }
.avatar { display: block; width: 112rpx; height: 112rpx; border-radius: 36rpx; background: #fff; border: 4rpx solid #fff; }
.role-badge { position: absolute; right: -8rpx; bottom: -8rpx; background: var(--clean-green); color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border: 4rpx solid var(--clean-mint); border-radius: 12rpx; }
.user-info { flex: 1; min-width: 0; }
.nickname { display: block; font-size: 36rpx; line-height: 1.5; font-weight: 600; word-break: break-all; }
.work-no { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--clean-muted); }
.stats-section { display: flex; padding-top: 28rpx; border-top: 2rpx solid #d9e8dd; gap: 12rpx; }
.stat-item { flex: 1; min-width: 0; text-align: center; }
.stat-number { display: block; font-size: 32rpx; color: var(--clean-green); font-weight: 600; word-break: break-all; }
.stat-label { display: block; margin-top: 8rpx; color: var(--clean-muted); font-size: 24rpx; }
.menu-section { border-bottom: 16rpx solid var(--clean-soft); margin: 0 -44rpx; padding: 0 44rpx; }
.menu-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; min-height: 84rpx; border-bottom: 2rpx solid var(--clean-line); }
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--clean-soft); }
.menu-icon { flex-shrink: 0; }
.menu-content { flex: 1; min-width: 0; }
.menu-title { display: block; font-size: 28rpx; font-weight: 500; }
.menu-desc { display: block; margin-top: 6rpx; font-size: 24rpx; line-height: 1.7; color: var(--clean-muted); overflow-wrap: break-word; }
.menu-arrow { color: var(--clean-muted); font-size: 32rpx; flex-shrink: 0; }
.certification-badge { max-width: 120rpx; flex-shrink: 0; }
.badge-text { display: inline-block; font-size: 22rpx; padding: 4rpx 10rpx; border-radius: 10rpx; color: var(--clean-warn); background: #faf4e9; }
.badge-text.certified { color: var(--clean-green); background: var(--clean-mint); }
.logout-section { margin-top: 36rpx; padding-bottom: env(safe-area-inset-bottom); }
.logout-btn { width: 100%; border-color: var(--clean-line); background: #fff; color: var(--clean-muted); }
.logout-btn:active { background: var(--clean-soft); }
.frozen-tip { padding: 24rpx; border-radius: 24rpx; background: #faf0ed; color: var(--clean-danger); margin-bottom: 28rpx; }
.frozen-content { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 20rpx; }
.frozen-icon { font-size: 30rpx; flex-shrink: 0; }
.frozen-text { flex: 1; min-width: 0; }
.frozen-title { display: block; font-size: 30rpx; font-weight: 600; }
.frozen-desc { display: block; font-size: 24rpx; margin-top: 8rpx; }
.unfreeze-btn { width: 100%; border-color: var(--clean-danger); color: var(--clean-danger); background: #fff; }
