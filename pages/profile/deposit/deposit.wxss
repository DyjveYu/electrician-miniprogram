/* pages/profile/deposit/deposit.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.deposit-card {
  background: linear-gradient(135deg, #0F9D58 0%, #A5D6A7 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.deposit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.deposit-title {
  font-size: 32rpx;
}

.deposit-amount {
  font-size: 48rpx;
  font-weight: bold;
}

.deposit-status {
  display: flex;
  justify-content: center;
}

.status-badge {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.status-badge.paid {
  background-color: rgba(76, 175, 80, 0.8);
}

.status-badge.pending {
  background-color: rgba(255, 152, 0, 0.8);
}

.status-badge.refunded {
  background-color: rgba(158, 158, 158, 0.8);
}

.status-badge.refunding {
  background-color: rgba(255, 152, 0, 0.8);
}

.status-text {
  font-size: 28rpx;
  color: #fff;
}

.info-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.detail-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #999;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  max-width: 400rpx;
  word-break: break-all;
}

.transaction-id {
  font-size: 24rpx;
  color: #666;
}

.action-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.pay-btn {
  background: linear-gradient(135deg, #0F9D58 0%, #4caf50 100%);
  color: #fff;
}

.pay-btn:active {
  opacity: 0.9;
}

.refund-btn {
  background-color: #fff;
  color: #ff9800;
  border: 2rpx solid #ff9800;
}

.refund-btn:active {
  background-color: #fff3e0;
}

.tips-section {
  margin-top: 30rpx;
  padding: 20rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
