@import "../../../styles/clean-surfaces.wxss";
/* pages/profile/deposit/deposit.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding: 32rpx 44rpx 48rpx;
}

.deposit-card {
  background: #eff7f1;
  border-radius: 22rpx;
  padding: 40rpx 30rpx;
  color: #fff;
  margin-bottom: 20rpx;
  color: #172d25;
  color: #172d25;
}

.deposit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.deposit-title {
  font-size: 32rpx;
}

.deposit-amount {
  font-size: 48rpx;
  font-weight: 600;
}

.deposit-status {
  display: flex;
  justify-content: center;
}

.status-badge {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.status-badge.paid {
  background-color: rgba(76, 175, 80, 0.8);
}

.status-badge.pending {
  background-color: rgba(255, 152, 0, 0.8);
}

.status-badge.refunded {
  background-color: rgba(158, 158, 158, 0.8);
}

.status-badge.refunding {
  background-color: rgba(255, 152, 0, 0.8);
}

.status-badge.expired {
  background-color: rgba(244, 67, 54, 0.8);
}

.status-text {
  font-size: 28rpx;
  color: #fff;
}

.info-card {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-item {
  font-size: 28rpx;
  color: #687a71;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.detail-card {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #e9efeb;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #687a71;
}

.detail-value {
  font-size: 28rpx;
  color: #172d25;
  max-width: 400rpx;
  word-break: break-all;
}

.transaction-id {
  font-size: 24rpx;
  color: #687a71;
}

.action-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.btn {
  width: 100%;
  height: auto;
  border-radius: 22rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.pay-btn {
  background: #16835c;
  color: #fff;
}

.pay-btn:active {
  opacity: 0.9;
}

.refund-btn {
  background-color: #fff;
  color: #956321;
  border: 2rpx solid #956321;
}

.refund-btn:active {
  background-color: #faf4e9;
}

.tips-section {
  margin-top: 30rpx;
  padding: 20rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #687a71;
  line-height: 1.6;
}


/* UI1.1：页面布局及状态精调。 */
.deposit-card { background: #eff7f1; color: #172d25; } .deposit-header { flex-wrap: wrap; gap: 16rpx; } .deposit-amount { color: #16835c; font-size: 48rpx; } .status-badge { border-radius: 12rpx; background: #fff; } .status-text { color: inherit; } .status-badge.paid { background: #fff; color: #16835c; } .status-badge.pending, .status-badge.refunding { background: #faf4e9; color: #956321; } .status-badge.refunded { background: #fff; color: #687a71; } .status-badge.expired { background: #faf0ed; color: #b74434; } .detail-row { align-items: flex-start; gap: 20rpx; } .detail-value { flex: 1; min-width: 0; text-align: right; } .action-section { padding: 0; } .refund-btn { color: #16835c; background: #eff7f1; border-color: #16835c; }
