@import "../../../styles/clean-surfaces.wxss";
/* pages/profile/edit/edit.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

/* 头像设置 */
.avatar-section {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid #e9efeb;
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(7,29,23,.65);
  color: #fff;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 0 0 100rpx 100rpx;
}

.upload-text {
  font-size: 24rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #e9efeb;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #172d25;
  flex-shrink: 0;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #172d25;
}

.value.readonly {
  color: #687a71;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #172d25;
}

/* 保存按钮 */
.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #fff;
  border-top: 2rpx solid #e9efeb;
}

.save-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn.disabled {
  background-color: #ccc;
  color: #687a71;
}

.save-btn::after {
  border: none;
}

/* UI1.1：页面布局及状态精调。 */
.section, .form-section { padding: 0; } .form-item { gap: 16rpx; align-items: flex-start; flex-wrap: wrap; } .form-item .label { width: 140rpx; padding-top: 20rpx; color: #687a71; } .form-item .input, .form-item .textarea, .form-item .value, .region-selector { flex: 1; min-width: 200rpx; box-sizing: border-box; } .save-section { padding: 24rpx 0; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); } .save-btn { width: 100%; } .switch-item { align-items: center; }
