@import "../../../../styles/clean-surfaces.wxss";
/* pages/profile/certification/notice/notice.wxss */
.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 32rpx 44rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 16rpx;
}

.notice-content {
  flex: 1;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
}

.content-text {
  font-size: 30rpx;
  color: #172d25;
  line-height: 1.8;
}

.bottom-bar {
  padding-bottom: 40rpx;
}

.confirm-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: none;
}

.confirm-btn::after {
  border: none;
}

/* UI1.1：页面布局及状态精调。 */
.container { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); } .notice-content { background: #f5f7f5; border-radius: 24rpx; } .bottom-bar { padding: 20rpx 44rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); border-color: #e9efeb; } .confirm-btn { height: auto; min-height: 96rpx; line-height: 1.6; padding: 20rpx; border-radius: 22rpx; }
