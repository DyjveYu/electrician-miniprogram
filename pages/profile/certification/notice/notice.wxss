/* pages/profile/certification/notice/notice.wxss */
.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.notice-content {
  flex: 1;
  background-color: #f8f9fc;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.bottom-bar {
  padding-bottom: 40rpx;
}

.confirm-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(90deg, #0F9D58 0%, #81C784 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(15, 157, 88, 0.25);
}

.confirm-btn::after {
  border: none;
}