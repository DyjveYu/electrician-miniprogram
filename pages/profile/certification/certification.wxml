<!-- pages/profile/certification/certification.wxml -->
<view class="container">
  <view class="header">
    <view class="title">电工认证</view>
    <view class="subtitle" wx:if="{{mode === 'apply'}}">请填写真实信息，审核通过后可接单</view>
    <view class="subtitle" wx:if="{{mode === 'view'}}">
      <text class="status-tag {{certificationStatus === 'approved' ? 'approved' : certificationStatus === 'rejected' ? 'rejected' : 'pending'}}">
        {{certificationStatus === 'approved' ? '已认证' : certificationStatus === 'rejected' ? '已拒绝' : '认证中'}}
      </text>
    </view>
  </view>

  <!-- 查看模式下的拒绝原因 -->
  <view class="reject-reason" wx:if="{{mode === 'view' && certificationStatus === 'rejected'}}">
    <view class="reason-title">拒绝原因：</view>
    <view class="reason-content">{{rejectReason || '未提供拒绝原因'}}</view>
    <button class="reapply-btn" bindtap="reapplyCertification">重新申请</button>
  </view>

  <!-- 申请表单 -->
  <view class="form-container" wx:if="{{mode === 'apply' || mode === 'view'}}">
    <view wx:if="{{!detailsStep}}">
      <view class="upload-section">
        <view class="upload-title">基本信息</view>
        <view class="cert-upload-item" bindtap="navigateToIdentity">
          <view class="cert-info">
            <view class="cert-name">{{mode === 'view' && certificationStatus !== 'approved' ? '查看身份证件' : '身份证上传'}}</view>
            <view class="cert-status {{idCardDraft || (idCardFrontPath && idCardBackPath) ? 'done' : ''}}">
              {{idCardDraft ? '已识别' : (idCardFrontPath && idCardBackPath ? '已上传' : '未上传')}}
            </view>
          </view>
          <view class="arrow">></view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">姓名</view>
        <view class="form-input readonly-value">{{idCardDraft ? idCardDraft.name : (formData.realName || '待识别')}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">身份证号</view>
        <view class="form-input readonly-value">{{idCardDraft ? idCardDraft.id : (formData.idCard || '待识别')}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">年龄（周岁）</view>
        <view class="form-input readonly-value">{{idCardDraft ? idCardDraft.age : (savedIdCard.age == null ? '—' : savedIdCard.age)}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">性别</view>
        <view class="form-input readonly-value">{{(idCardDraft ? idCardDraft.gender : savedIdCard.gender) || '—'}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">身份证到期日期</view>
        <view class="form-input readonly-value">{{(idCardDraft ? idCardDraft.longTerm : savedIdCard.longTerm) ? '长期有效' : ((idCardDraft ? idCardDraft.expiresOn : savedIdCard.expiresOn) || '未记录')}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">手机号</view>
        <view class="form-input readonly-value">{{formData.phone}}</view>
      </view>
      <view class="tips">
        <view>请保证信息真实准确，仔细核对识别结果与身份证是否一致。如需更新基本信息，请重新上传身份证。</view>
        <view>接单用户对所填写的信息，按照国家法律法规填写人对信息的真实性承担法律责任。</view>
      </view>
      <button class="submit-btn" wx:if="{{mode === 'apply'}}" bindtap="nextCertificationStep" disabled="{{!idCardDraft && !reapply}}">继续填写</button>
      <button class="reapply-btn" wx:if="{{mode === 'view' && certificationLoaded && certificationStatus !== 'none' && !idCardDraft}}" bindtap="nextCertificationStep">查看其他认证资料</button>
      <block wx:if="{{mode === 'view' && certificationStatus === 'approved' && idCardDraft}}">
        <view class="tips" wx:if="{{!idCardUpdateMatches}}">识别出的姓名或身份证号与原认证资料不一致，无法自助保存。</view>
        <button class="submit-btn" bindtap="saveIdCardUpdate" loading="{{submitting}}" disabled="{{submitting || !idCardUpdateMatches}}">确认保存基本信息</button>
        <button class="reapply-btn" bindtap="cancelIdCardUpdate" disabled="{{submitting}}">取消更新</button>
      </block>
    </view>
    <view wx:if="{{detailsStep}}">
      <button class="reapply-btn" bindtap="previousCertificationStep" disabled="{{submitting}}">返回基本信息</button>
    <!-- 从事工作类型 -->
    <view class="form-group">
      <view class="form-label">我要兼职的工作（可全选）</view>
      <checkbox-group class="checkbox-group" bindchange="onWorkTypesChange">
        <label class="checkbox-item">
          <checkbox value="maintenance" checked="{{isMaintenanceChecked}}" disabled="{{mode === 'view' && certificationStatus !== 'approved'}}"  color="#16835c"/>
          <text>维修电工</text>
        </label>
        <label class="checkbox-item">
          <checkbox value="installation" checked="{{isInstallationChecked}}" disabled="{{mode === 'view' && certificationStatus !== 'approved'}}"  color="#16835c"/>
          <text>安装电工</text>
        </label>
      </checkbox-group>
    </view>

    <view class="form-group">
      <view class="form-label">电工证号</view>
      <input class="form-input" placeholder="输入身份证号后自动生成" value="{{formData.certificateNumber}}" disabled />
    </view>

    <view class="form-group">
      <view class="form-label">证书开始日期</view>
      <picker mode="date" value="{{formData.certificateStartDate}}" start="2000-01-01" end="2050-12-31" bindchange="bindDateChange" data-field="certificateStartDate" disabled="{{mode === 'view' && certificationStatus !== 'approved'}}">
        <view class="form-input {{formData.certificateStartDate ? '' : 'placeholder'}}">
          {{formData.certificateStartDate || '请选择开始日期'}}
        </view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">证书截止日期</view>
      <picker mode="date" value="{{formData.certificateEndDate}}" start="2000-01-01" end="2050-12-31" bindchange="bindDateChange" data-field="certificateEndDate" disabled="{{mode === 'view' && certificationStatus !== 'approved'}}">
        <view class="form-input {{formData.certificateEndDate ? '' : 'placeholder'}}">
          {{formData.certificateEndDate || '请选择截止日期'}}
        </view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">服务区域 <text class="required">*</text></view>
      <view class="location-wrapper">
        <picker mode="region" value="{{region}}" custom-item="{{customItem}}" bindchange="bindRegionChange" disabled="{{mode === 'view' && certificationStatus !== 'approved'}}">
          <view class="form-input region-input {{region[0] && region[1] && region[2] ? '' : 'placeholder'}}">
            {{region[0] && region[1] && region[2] ? region[0] + region[1] + region[2] : '请选择服务区域'}}
          </view>
        </picker>
        <view class="location-btn" bindtap="getLocation" wx:if="{{mode === 'apply' || (mode === 'view' && certificationStatus === 'approved')}}">
          <image class="location-icon ui-icon" src="/images/content-ui/map-pin.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
    </view>

    <!-- 特种作业操作证类型 -->
    <view class="form-group">
      <view class="form-label">特种作业操作证 <text class="required">*</text></view>
      <radio-group class="cert-type-group" bindchange="onCertTypeChange">
        <label class="cert-type-item {{formData.specialOperationCertType === 'low_voltage' ? 'selected' : ''}}">
          <radio value="low_voltage" checked="{{formData.specialOperationCertType === 'low_voltage'}}"  color="#16835c"/>
          <text>低压电工证</text>
        </label>
        <view class="cert-type-gap"></view>
        <label class="cert-type-item {{formData.specialOperationCertType === 'high_voltage' ? 'selected' : ''}}">
          <radio value="high_voltage" checked="{{formData.specialOperationCertType === 'high_voltage'}}"  color="#16835c"/>
          <text>高压电工证</text>
        </label>
      </radio-group>
    </view>

    <view class="upload-section">
      <view class="upload-title">证件照片</view>

      <view class="cert-upload-item" bindtap="navigateToElectricianCert">
        <view class="cert-info">
          <view class="cert-name">电工证件</view>
          <view class="cert-status {{certificatePath ? 'done' : ''}}">
            {{certificatePath ? '已上传' : '未上传'}}
          </view>
        </view>
        <view class="arrow">></view>
      </view>
    </view>

    <view class="tips">
      <view class="tips-title">温馨提示</view>
      <view class="tips-content">
        <text>1. 请确保填写的信息真实有效</text>
        <text>2. 电工证必须在有效期内</text>
        <text>3. 审核通过后即可接单</text>
      </view>
    </view>

    <!-- 认证须知勾选 -->
    <view class="cert-notice-agreement" wx:if="{{mode === 'apply'}}">
      <checkbox-group bindchange="onNoticeAgreementChange">
        <label class="notice-label">
          <checkbox value="agreed" checked="{{noticeAgreed}}"  color="#16835c"/>
          <text>我已阅读并同意</text>
          <text class="notice-link" bindtap="goToCertificationNotice">《认证须知》</text>
        </label>
      </checkbox-group>
    </view>

    <button class="submit-btn {{submitDisabled ? 'disabled' : ''}}" bindtap="submitCertification" disabled="{{submitDisabled}}" wx:if="{{mode === 'apply' && certificationStatus !== 'pending'}}">{{reapply ? '重新认证' : '提交认证'}}</button>
    <button class="reapply-btn {{submitting ? 'disabled' : ''}}" wx:if="{{mode === 'view' && certificationStatus === 'approved'}}" bindtap="reapplyCertification" disabled="{{submitting}}">重新认证</button>

    </view>
  </view>
  <!-- 审核中状态 -->
  <view class="pending-container" wx:if="{{mode === 'view' && certificationStatus === 'pending'}}">
    <view class="pending-title">认证审核中</view>
    <view class="pending-desc">您的电工认证申请已提交，通常需要1-3个工作日，审核结果将通过消息通知您</view>
  </view>
</view>
