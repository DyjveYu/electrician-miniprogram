<!-- pages/profile/certification/certification.wxml -->
<view class="container">
  <view class="certification-result {{certificationStatus === 'pending' ? 'is-pending' : ''}}" wx:if="{{mode === 'view' && (certificationStatus === 'approved' || (certificationStatus === 'pending' && regionChangePending))}}">
    <image class="pending-icon ui-icon" src="{{certificationStatus === 'approved' ? '/images/content-ui/check-circle.svg' : '/images/content-ui/alert-circle.svg'}}" mode="aspectFit" aria-hidden="true" />
    <view class="pending-title">{{certificationStatus === 'approved' ? '认证已通过' : '区域变更待审核'}}</view>
  </view>
  <view class="header" wx:else>
    <view class="title">电工认证</view>
    <view class="subtitle" wx:if="{{mode === 'apply'}}">请按顺序填写并提交认证</view>
    <view class="subtitle" wx:if="{{mode === 'view' && (certificationStatus === 'rejected' || certificationStatus === 'pending')}}">
      <text class="status-tag {{certificationStatus === 'rejected' ? 'rejected' : 'pending'}}">
        {{certificationStatus === 'rejected' ? '未通过' : (regionChangePending ? '区域变更待审核' : '待补充资料')}}
      </text>
    </view>
  </view>

  <!-- 查看模式下的拒绝原因 -->
  <view class="reject-reason" wx:if="{{mode === 'view' && certificationStatus === 'rejected'}}">
    <view class="reason-title">未通过原因：</view>
    <view class="reason-content">{{rejectReason || '未提供拒绝原因'}}</view>
    <button class="reapply-btn" wx:if="{{!regionChangePending}}" bindtap="reapplyCertification">重新申请</button>
  </view>
  <view class="{{regionChangePending ? 'region-review-hint' : 'reject-reason'}}" wx:if="{{mode === 'view' && certificationStatus === 'pending'}}">
    <view class="reason-content">{{regionChangePending ? '接单区域变更正在人工审核，请在接单区域页查看申请。' : '请补齐资料后提交认证'}}</view>
    <button class="reapply-btn" wx:if="{{!regionChangePending}}" bindtap="reapplyCertification">继续认证</button>
  </view>

  <!-- 申请表单 -->
  <view class="form-container" wx:if="{{mode === 'apply' || mode === 'view'}}">
    <view class="certification-tabs">
      <button wx:for="{{steps}}" wx:key="*this" class="certification-tab {{activeStep === index ? 'current' : ''}}"
        data-step="{{index}}" bindtap="selectStep" disabled="{{submitting || (mode === 'apply' && index > unlockedStep)}}">{{item}}</button>
    </view>
    <view class="tips" wx:if="{{certificationLoadError}}">
      <view>{{certificationLoadError}}</view>
      <button class="reapply-btn" bindtap="loadCertificationInfo">重新加载</button>
    </view>
    <view wx:if="{{activeStep === 0}}">
      <view class="upload-section">
        <view class="upload-title">基本信息</view>
        <view class="cert-upload-item" bindtap="navigateToIdentity">
          <view class="cert-info">
            <view class="cert-name">{{mode === 'view' && certificationStatus !== 'approved' ? '查看身份证件' : '身份证上传'}}</view>
            <view class="cert-status {{idCardDraft || (idCardFrontPath && idCardBackPath) ? 'done' : ''}}">
              {{idCardDraft ? '已识别' : (idCardFrontPath && idCardBackPath ? '已上传' : '未上传')}}
            </view>
          </view>
          <view class="arrow">></view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">姓名</view>
        <view class="form-input readonly-value">{{idCardDraft ? idCardDraft.name : (formData.realName || '待识别')}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">身份证号</view>
        <view class="form-input readonly-value">{{idCardDraft ? idCardDraft.id : (formData.idCard || '待识别')}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">年龄（周岁）</view>
        <view class="form-input readonly-value">{{idCardDraft ? idCardDraft.age : (savedIdCard.age == null ? '—' : savedIdCard.age)}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">性别</view>
        <view class="form-input readonly-value">{{(idCardDraft ? idCardDraft.gender : savedIdCard.gender) || '—'}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">身份证到期日期</view>
        <view class="form-input readonly-value">{{(idCardDraft ? idCardDraft.longTerm : savedIdCard.longTerm) ? '长期有效' : ((idCardDraft ? idCardDraft.expiresOn : savedIdCard.expiresOn) || '未记录')}}</view>
      </view>
      <view class="form-group">
        <view class="form-label">手机号</view>
        <view class="form-input readonly-value">{{formData.phone}}</view>
      </view>
      <view class="tips">
        <view>请保证信息真实准确，仔细核对识别结果与身份证是否一致。如需更新基本信息，请重新上传身份证。</view>
        <view>接单用户对所填写的信息，按照国家法律法规填写人对信息的真实性承担法律责任。</view>
      </view>
      <button class="submit-btn" wx:if="{{mode === 'apply'}}" bindtap="nextCertificationStep" disabled="{{!certificationLoaded || (!idCardDraft && !sameIdentity)}}">继续填写</button>
      <block wx:if="{{mode === 'view' && certificationStatus === 'approved' && idCardDraft}}">
        <view class="tips" wx:if="{{!idCardUpdateMatches}}">识别出的姓名或身份证号与原认证资料不一致，无法自助保存。</view>
        <button class="submit-btn" bindtap="saveIdCardUpdate" loading="{{submitting}}" disabled="{{submitting || !idCardUpdateMatches}}">确认保存基本信息</button>
        <button class="reapply-btn" bindtap="cancelIdCardUpdate" disabled="{{submitting}}">取消更新</button>
      </block>
    </view>
    <view wx:if="{{activeStep === 1}}">
      <view class="upload-title">业务信息</view>
      <view class="form-group">
        <view class="form-label">我要兼职的工作（可全选）</view>
        <checkbox-group class="checkbox-group" bindchange="onWorkTypesChange">
          <label class="checkbox-item"><checkbox value="maintenance" checked="{{isMaintenanceChecked}}" disabled="{{mode === 'view'}}" />维修电工</label>
          <label class="checkbox-item"><checkbox value="installation" checked="{{isInstallationChecked}}" disabled="{{mode === 'view'}}" />安装电工</label>
        </checkbox-group>
      </view>
      <view class="form-group" wx:if="{{(mode === 'apply' || editing)}}">
        <view class="form-label">电工证类型</view>
        <checkbox-group class="license-options" bindchange="selectLicenses">
          <label class="checkbox-item" wx:for="{{licenseOptions}}" wx:key="license_type">
            <checkbox value="{{item.license_type}}" checked="{{item.checked}}" color="#16835c" disabled="{{submitting}}" />
            <text>{{item.label}}</text>
          </label>
        </checkbox-group>
        <view class="tips">请保证所填信息的真实性，系统自动校验证书有效期。</view>
      </view>
      <view class="license-card" wx:for="{{licenses}}" wx:key="license_type">
        <view class="form-label">{{item.label}}</view>
        <input wx:if="{{(mode === 'apply' || editing)}}" class="form-input" maxlength="50" placeholder="请输入证件上的真实证号" value="{{item.certificate_number}}" data-index="{{index}}" data-field="certificate_number" bindinput="editLicense" />
        <view wx:else class="form-input readonly-value">{{item.certificate_number || '证号未记录'}}</view>
        <view class="license-dates">
          <picker mode="date" value="{{item.start_date}}" disabled="{{(mode === 'view' && !editing) || submitting}}" data-index="{{index}}" data-field="start_date" bindchange="editLicense">
            <view class="form-input readonly-value">{{item.start_date || '选择起始日'}}</view>
          </picker>
          <picker mode="date" value="{{item.end_date}}" disabled="{{(mode === 'view' && !editing) || submitting}}" data-index="{{index}}" data-field="end_date" bindchange="editLicense">
            <view class="form-input readonly-value">{{item.end_date || '选择截止日'}}</view>
          </picker>
        </view>
        <view class="tips" wx:if="{{(mode === 'apply' || editing) && item.start_date && item.end_date && item.end_date <= item.start_date}}">证书截止日期必须晚于起始日期。</view>
        <view class="license-photo-card" data-type="{{item.license_type}}" data-url="{{item.previewUrl || item.photo_url}}" bindtap="tapLicensePhoto">
          <image wx:if="{{item.localPhoto || item.previewUrl}}" class="license-photo" src="{{item.localPhoto || item.previewUrl}}" mode="aspectFit" />
          <block wx:else>
            <image class="license-photo-icon" src="/images/content-ui/camera.svg" mode="aspectFit" />
            <text>{{item.photo_url ? '证书照片' : ((mode === 'apply' || editing) ? '点击上传照片' : '暂无照片')}}</text>
          </block>
          <text class="license-photo-caption" wx:if="{{(mode === 'apply' || editing) && (item.localPhoto || item.photo_url)}}">点击更换</text>
        </view>
      </view>
      <view class="form-group">
        <view class="form-label">从业时间</view>
        <picker mode="date" fields="month" value="{{careerMonth || currentMonth}}" end="{{currentMonth}}" disabled="{{(mode === 'view' && !editing) || submitting}}" bindchange="editCareerMonth">
          <view class="form-input readonly-value">{{careerMonth || (mode === 'view' ? '未填写' : '请选择开始从业年月')}}</view>
        </picker>
        <view class="career-summary" wx:if="{{careerMonth}}">从 {{careerLabel}} 开始从事电工工作{{careerYears != null ? '，从业 ' + careerYears + ' 年' : ''}}</view>
        <view class="tips" wx:if="{{careerError}}">{{careerError}}</view>
      </view>
      <view class="tips">接单用户对所填写的信息，按照国家法律法规填写人对信息的真实性承担法律责任。</view>
      <button class="submit-btn" wx:if="{{mode === 'apply'}}" bindtap="nextRegionStep">继续填写</button>
    </view>
    <view wx:if="{{activeStep === 2}}">
      <view class="form-group">
        <view class="form-label">接单区域 <text class="required">*</text></view>
        <view class="location-wrapper">
          <picker mode="region" value="{{region}}" custom-item="{{customItem}}" bindchange="bindRegionChange" disabled="{{mode === 'view'}}">
            <view class="form-input region-input {{region[0] && region[1] && region[2] ? '' : 'placeholder'}}">
              {{region[0] && region[1] && region[2] ? region[0] + region[1] + region[2] : (mode === 'view' ? '未填写' : '请选择接单区域')}}
            </view>
          </picker>
          <view class="location-btn" bindtap="getLocation" wx:if="{{mode === 'apply'}}">
            <image class="location-icon ui-icon" src="/images/content-ui/map-pin.svg" mode="aspectFit" aria-hidden="true" />
          </view>
        </view>
      </view>
      <view class="tips" wx:if="{{mode === 'view' && certificationStatus === 'approved'}}">接单区域选择提交后 6 个月内变更，须填写「变更接单区域申请」。</view>
      <view class="region-change-panel" wx:if="{{mode === 'view'}}">
        <view class="region-history" wx:if="{{serviceRegions.length}}">
          <view>已增加的接单区域</view>
          <view wx:for="{{serviceRegions}}" wx:key="id">{{item.province}}{{item.city}}{{item.district}}</view>
        </view>
        <view class="tips" wx:if="{{pendingRegionRequest.operation === 'add'}}">新增区域待审核，现有认证资格及接单区域保留。</view>
        <view wx:if="{{regionInfoLoading}}">正在读取区域变更信息…</view>
        <view class="tips" wx:if="{{regionInfoError}}">{{regionInfoError}}</view>
        <button class="reapply-btn" wx:if="{{!regionInfo || regionInfoError}}" bindtap="loadRegionChangeStatus" disabled="{{regionInfoLoading}}">重新读取区域变更信息</button>
        <block wx:if="{{regionInfo}}">
          <view class="tips">{{regionInfo.can_apply ? (regionInfo.can_self_change ? '可自主变更接单区域' : '本次变更需提交人工审核') : regionInfo.explanation}}</view>
          <view wx:if="{{regionInfo.nextTimeLabel}}">满足六个月间隔的时间（北京时间）{{regionInfo.nextTimeLabel}}</view>
          <view class="region-history" wx:if="{{regionInfo.latest}}">
            <view>{{regionInfo.latest.source === 'self' ? '信息自行变更' : (regionInfo.latest.status === 'pending' ? '区域变更待审核' : (regionInfo.latest.status === 'approved' ? '区域变更审核通过' : '区域变更申请未通过'))}}</view>
            <view>目标区域 {{regionInfo.latest.province}}{{regionInfo.latest.city}}{{regionInfo.latest.district}}</view>
            <view wx:if="{{regionInfo.latest.reject_reason}}">{{regionInfo.latest.reject_reason}}，请与客服联系。</view>
          </view>
          <view class="region-history" wx:if="{{regionInfo.notification_result && regionInfo.notification_result.id !== regionInfo.latest.id}}">
            <view>本条通知对应的申请{{regionInfo.notification_result.status === 'approved' ? '已通过' : (regionInfo.notification_result.status === 'rejected' ? '未通过' : '待审核')}}</view>
            <view>{{regionInfo.notification_result.province}}{{regionInfo.notification_result.city}}{{regionInfo.notification_result.district}}</view>
            <view wx:if="{{regionInfo.notification_result.reject_reason}}">{{regionInfo.notification_result.reject_reason}}，请与客服联系。</view>
          </view>
          <button class="submit-btn region-secondary-btn" wx:if="{{regionInfo.can_apply}}" bindtap="openRegionChange" disabled="{{submitting}}">{{regionInfo.can_self_change ? '自主变更接单区域' : '变更接单区域表单'}}</button>
        </block>
        <view class="region-addition-section">
          <view wx:if="{{regionAdditionLoading}}">正在读取新增区域信息…</view>
          <view class="tips" wx:if="{{regionAdditionError}}">{{regionAdditionError}}</view>
          <button class="reapply-btn region-secondary-btn" wx:if="{{regionAdditionError}}" bindtap="loadRegionAdditionStatus">重新读取新增区域信息</button>
          <block wx:if="{{regionAdditionInfo}}">
            <view class="tips">{{regionAdditionInfo.explanation}}</view>
            <view class="region-history" wx:if="{{regionAdditionInfo.latest}}">
              <view>{{regionAdditionInfo.latest.status === 'pending' ? '新增区域待审核' : (regionAdditionInfo.latest.status === 'approved' ? '新增区域审核通过' : '新增区域申请未通过')}}</view>
              <view>目标区域 {{regionAdditionInfo.latest.province}}{{regionAdditionInfo.latest.city}}{{regionAdditionInfo.latest.district}}</view>
              <view wx:if="{{regionAdditionInfo.latest.reject_reason}}">{{regionAdditionInfo.latest.reject_reason}}，如果需要继续增加，请与客服联系。</view>
            </view>
            <view class="region-history" wx:if="{{regionAdditionInfo.notification_result && regionAdditionInfo.notification_result.id !== regionAdditionInfo.latest.id}}">
              <view>本条通知对应的新增申请{{regionAdditionInfo.notification_result.status === 'approved' ? '已通过' : (regionAdditionInfo.notification_result.status === 'rejected' ? '未通过' : '待审核')}}</view>
              <view>{{regionAdditionInfo.notification_result.province}}{{regionAdditionInfo.notification_result.city}}{{regionAdditionInfo.notification_result.district}}</view>
              <view wx:if="{{regionAdditionInfo.notification_result.reject_reason}}">{{regionAdditionInfo.notification_result.reject_reason}}，如果需要继续增加，请与客服联系。</view>
            </view>
            <button class="submit-btn region-secondary-btn" wx:if="{{regionAdditionInfo.can_apply}}" bindtap="openRegionAddition" disabled="{{submitting}}">增加接单区域表单</button>
          </block>
        </view>
      </view>
      <view class="tips">接单用户对所填写的信息，按照国家法律法规填写人对信息的真实性承担法律责任。</view>
      <button class="submit-btn" wx:if="{{mode === 'apply'}}" bindtap="nextFeeStep" loading="{{checkingRegion}}" disabled="{{checkingRegion}}">继续填写</button>
    </view>

    <view wx:if="{{activeStep === 3}}">
      <view class="upload-title">工费信息</view>
      <view class="form-group">
        <view class="form-label">小时工费（元/小时）</view>
        <input wx:if="{{mode === 'apply' || editing}}" type="digit" class="form-input" value="{{hourlyRate}}" placeholder="18.2–1000" maxlength="7" data-field="hourlyRate" bindinput="editRate" disabled="{{submitting}}" />
        <view wx:else class="form-input readonly-value">{{hourlyRate || '未填写'}}</view>
        <view wx:if="{{mode === 'apply'}}" class="tips">请输入 18.2–1000 元/小时。</view>
      </view>
      <view class="form-group">
        <view class="form-label">日工工费（元/日）</view>
        <input wx:if="{{mode === 'apply' || editing}}" type="digit" class="form-input" value="{{dailyRate}}" placeholder="145.6–8000" maxlength="7" data-field="dailyRate" bindinput="editRate" disabled="{{submitting}}" />
        <view wx:else class="form-input readonly-value">{{dailyRate || '未填写'}}</view>
        <view wx:if="{{mode === 'apply'}}" class="tips">请输入 145.6–8000 元/日。</view>
      </view>
      <view class="notice-link wage-reference-link" bindtap="openWageReference">点击查看非全日制工作小时最低工资标准参考</view>
      <view class="form-group">
        <view class="form-label">上门费（北京时间）</view>
        <view class="callout-fee-list" wx:if="{{calloutFees.length === 3}}">
          <view class="readonly-value form-input">05:00–17:00　{{calloutFees[0]}} 元</view>
          <view class="readonly-value form-input">17:00–22:00　{{calloutFees[1]}} 元</view>
          <view class="readonly-value form-input">22:00–次日 05:00　{{calloutFees[2]}} 元</view>
        </view>
        <view wx:else class="form-input readonly-value">{{calloutFeesUnavailable ? '上门费配置暂不可用' : '未填写'}}</view>
      </view>
      <view class="tips">接单用户对所填写的信息，按照国家法律法规填写人对信息的真实性承担法律责任。</view>
    <!-- 认证须知勾选 -->
    <view class="cert-notice-agreement" wx:if="{{mode === 'apply'}}">
      <checkbox-group bindchange="onNoticeAgreementChange">
        <label class="notice-label">
          <checkbox value="agreed" checked="{{noticeAgreed}}"  color="#16835c"/>
          <text>我已阅读并同意</text>
          <text class="notice-link" bindtap="goToCertificationNotice">《认证须知》</text>
        </label>
      </checkbox-group>
    </view>

    <button class="submit-btn" bindtap="submitCertification" loading="{{submitting}}" disabled="{{submitDisabled || submitting}}" wx:if="{{mode === 'apply'}}">提交认证</button>

    </view>
  </view>
  <button class="submit-btn" wx:if="{{editing && activeStep < 3}}" bindtap="nextEditStep" disabled="{{submitting}}">继续填写</button>
  <view class="modification-actions" wx:if="{{editing && activeStep === 3}}">
    <button class="submit-btn" bindtap="submitInformation" loading="{{submitting}}" disabled="{{submitting}}">提交修改</button>
    <button class="reapply-btn" bindtap="cancelEditing" disabled="{{submitting}}">取消修改</button>
  </view>
  <view class="region-modal-mask" wx:if="{{regionEditorOpen}}">
    <scroll-view class="region-modal" scroll-y>
      <view class="upload-title">{{regionOperation === 'add' ? '增加接单区域表单' : (regionEditorInfo.can_self_change ? '自主变更接单区域' : '变更接单区域表单')}}</view>
      <view class="form-label">目标接单区域</view>
      <picker mode="region" value="{{targetRegion}}" bindchange="selectTargetRegion" disabled="{{submitting}}">
        <view class="form-input">{{targetRegion[0] ? targetRegion[0] + targetRegion[1] + targetRegion[2] : '请选择目标省市区'}}</view>
      </picker>
      <view class="tips" wx:if="{{targetRegionChecking}}">正在读取目标区域上门费…</view>
      <view class="tips" wx:if="{{targetRegionError}}">{{targetRegionError}}</view>
      <view wx:if="{{targetRegionFees.length === 3}}">上门费（北京时间）</view>
      <view class="tips" wx:if="{{targetRegionFees.length === 3}}">
        <view>05:00–17:00　{{targetRegionFees[0]}} 元</view>
        <view>17:00–22:00　{{targetRegionFees[1]}} 元</view>
        <view>22:00–次日 05:00　{{targetRegionFees[2]}} 元</view>
      </view>
      <view class="form-label">{{regionOperation === 'add' ? '增加原因' : '变更原因'}}{{regionEditorInfo.can_self_change ? '（选填）' : '（必填）'}}</view>
      <textarea class="form-input region-change-reason" value="{{regionChangeReason}}" bindinput="editRegionChangeReason" maxlength="500" disabled="{{submitting}}" placeholder="{{regionOperation === 'add' ? '请填写增加原因' : '请填写变更原因'}}" />
      <view class="tips region-change-notice" wx:if="{{!regionEditorInfo.can_self_change}}">① 该申请将由人工复核，复核时间 5 个工作日；② 同意微信订阅后可收到审核结果通知，也可在站内信及本页查看结果。</view>
      <view class="modification-actions">
        <button class="submit-btn region-secondary-btn" bindtap="submitRegionChange" loading="{{submitting}}" disabled="{{submitting || targetRegionChecking}}">提交</button>
        <button class="reapply-btn region-cancel-btn" bindtap="closeRegionChange" disabled="{{submitting}}">取消</button>
      </view>
    </scroll-view>
  </view>
</view>
