@import "../../../../styles/clean-surfaces.wxss";
/* pages/profile/certification/identity/identity.wxss */
.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 32rpx 44rpx 48rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 16rpx;
}

.highlight {
  color: #16835c; /* Orange highlight as seen in screenshot */
}

.subtitle {
  font-size: 26rpx;
  color: #687a71;
}

.upload-section {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.upload-card {
  position: relative;
  width: 100%;
  height: 360rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  border: 2rpx dashed #e9efeb;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.1;
  pointer-events: none;
}

.placeholder-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.camera-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* Fallback for camera icon if image not present */
.camera-icon:empty::before {
  content: '📷';
  font-size: 60rpx;
  color: #687a71;
}

.placeholder-content text {
  font-size: 28rpx;
  color: #687a71;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.re-upload-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(7,29,23,.65);
  padding: 10rpx 0;
  text-align: center;
}

.re-upload-mask text {
  color: #fff;
  font-size: 24rpx;
}

.security-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
  margin-bottom: 40rpx;
}

.shield-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}
.shield-icon:empty::before {
  content: '🛡️';
  font-size: 28rpx;
  color: #687a71;
}


.security-tip text {
  font-size: 24rpx;
  color: #687a71;
}

.footer {
  margin-top: auto;
  padding-bottom: 40rpx;
}

.confirm-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: none;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.disabled {
  background: #d1d5db;
  color: #687a71;
  box-shadow: none;
}

.privacy-tip {
  font-size: 22rpx;
  color: #687a71;
  text-align: center;
}


/* UI1.1：页面布局及状态精调。 */
.header { margin-bottom: 32rpx; } .upload-card { box-sizing: border-box; border-radius: 24rpx; background: #f5f7f5; } .camera-icon { opacity: 1; width: 64rpx; height: 64rpx; } .camera-icon:empty::before, .shield-icon:empty::before { content: none; } .security-tip text, .privacy-tip { color: #687a71; } .example-list { flex-wrap: wrap; gap: 20rpx; } .example-item { flex: 1; min-width: 120rpx; } .confirm-btn { height: auto; padding: 20rpx 24rpx; line-height: 1.6; background: #16835c; color: #fff; border-radius: 22rpx; } .confirm-btn.disabled { background: #16835c; color: #fff; opacity: .5; }
