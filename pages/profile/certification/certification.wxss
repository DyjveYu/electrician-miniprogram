/* pages/profile/certification/certification.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-tag.approved {
  background-color: #07c160;
}

.status-tag.rejected {
  background-color: #fa5151;
}

.status-tag.pending {
  background-color: #ffc300;
  color: #333;
}

.form-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

/* 多选框组样式 */
.checkbox-group {
  display: flex;
  gap: 30rpx;
  padding: 10rpx 0;
}

.checkbox-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.checkbox-item checkbox {
  margin-right: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.readonly-value {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
}

.license-options,
.license-dates {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.license-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #dce5de;
  border-radius: 22rpx;
}

.license-dates {
  margin-top: 16rpx;
}

.license-photo-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 220rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f5f7f5;
  color: #687a71;
  font-size: 26rpx;
}

.license-photo {
  width: 100%;
  height: 100%;
}

.license-photo-icon {
  width: 52rpx;
  height: 52rpx;
}

.license-photo-caption {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 22rpx;
}

.license-dates picker {
  flex: 1;
  min-width: 220rpx;
}

.placeholder {
  color: #999;
}

.location-wrapper {
  display: flex;
  align-items: center;
}

.region-input {
  flex: 1;
}

.location-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  margin-left: 20rpx;
}

.location-icon {
  font-size: 40rpx;
}

.tips {
  background-color: #f0f9ff;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #1890ff;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tips-content {
  font-size: 24rpx;
  color: #666;
}

.tips-content text {
  display: block;
  margin-bottom: 6rpx;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(to right, #1890ff, #0076e4);
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
  font-weight: 500;
}

.submit-btn.disabled {
  background: linear-gradient(to right, #ccc, #999);
  color: #fff;
}

.reject-reason {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.reason-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.reason-content {
  font-size: 28rpx;
  color: #fa5151;
  padding: 20rpx;
  background-color: #fff2f0;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.reapply-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(to right, #1890ff, #0076e4);
  color: #fff;
  font-size: 32rpx;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 500;
}
.reapply-btn.disabled {
  background: linear-gradient(to right, #ccc, #999);
  color: #fff;
}


.pending-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 60rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.pending-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.pending-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.pending-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}


/* 新增：证件上传列表 */
.cert-upload-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f8f9fa;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.cert-info {
  display: flex;
  align-items: center;
}

.cert-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
}

.cert-status {
  font-size: 24rpx;
  color: #999;
  background-color: #eee;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.cert-status.done {
  color: #52c41a;
  background-color: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.arrow {
  font-family: "SimSun", sans-serif; /* Use font that supports > well or simple arrow icon */
  color: #ccc;
  font-weight: bold;
}

/* 特种作业操作证单选组样式 */
.cert-type-group {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.cert-type-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.cert-type-item radio {
  margin-right: 8rpx;
}

.cert-type-gap {
  width: 60rpx;
}

/* 认证须知勾选样式 */
.cert-notice-agreement {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.notice-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.notice-label checkbox {
  margin-right: 10rpx;
}

.notice-link {
  color: #1890ff;
  margin-left: 6rpx;
}

.certification-result {
  margin-bottom: 32rpx;
  padding: 16rpx 0;
  text-align: center;
}
.certification-result .pending-title {
  color: #16835c;
  margin-bottom: 0;
}
.certification-result.is-pending .pending-title {
  color: #956321;
}
.region-review-hint {
  margin-bottom: 32rpx;
  color: #687a71;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}
.certification-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: var(--clean-soft);
}
.certification-tab {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 20rpx 8rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--clean-muted);
  background: transparent;
}
.certification-tab::after {
  border: 0;
}
.certification-tab[disabled] {
  color: var(--clean-muted);
  background: transparent;
  opacity: .55;
}
.certification-tab.current,
.certification-tab.current[disabled] {
  color: var(--clean-green);
  background: #fff;
  font-weight: 600;
  opacity: 1;
}
.career-summary {
  margin-top: 12rpx;
  color: var(--clean-muted);
  font-size: 26rpx;
  line-height: 1.6;
}
.form-hint {
  margin: 12rpx 0 24rpx;
  padding: 0;
  color: var(--clean-muted);
  font-size: 26rpx;
  line-height: 1.6;
  background: transparent;
  border: 0;
  border-radius: 0;
}
.wage-reference-link {
  margin-bottom: 20rpx;
}
.callout-fee-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.modification-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.modification-actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
}
.region-change-panel {
  margin: 24rpx 0;
  line-height: 1.7;
}
.region-history {
  margin-top: 24rpx;
  color: var(--clean-muted);
  font-size: 26rpx;
}
.region-history-title {
  margin-bottom: 12rpx;
  color: #172d25;
  font-size: 28rpx;
  font-weight: 700;
}
.region-display {
  margin-top: 12rpx;
}
.region-addition-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #dce8df;
}
.region-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.region-modal {
  height: 80vh;
  width: 100%;
  background: #fff;
  box-sizing: border-box;
  border-radius: 24rpx;
  padding: 32rpx;
}
.region-change-reason {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
}
.region-change-notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.7;
}
.region-secondary-btn,
.region-secondary-btn[disabled] {
  background: #eff7f1;
  color: #16835c;
  border: 2rpx solid #cfe5d8;
}
.region-cancel-btn,
.region-cancel-btn[disabled],
.cancel-edit-btn,
.cancel-edit-btn[disabled] {
  background: #fff;
  color: #16835c;
  border: 2rpx solid #cfe5d8;
}
