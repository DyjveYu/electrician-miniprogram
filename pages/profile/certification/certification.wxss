@import "../../../styles/clean-surfaces.wxss";
/* pages/profile/certification/certification.wxss */
.container {
  padding: 32rpx 44rpx 48rpx;
  background-color: #fff;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #687a71;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-tag.approved {
  background-color: #16835c;
}

.status-tag.rejected {
  background-color: #b74434;
}

.status-tag.pending {
  background-color: #956321;
  color: #172d25;
}

.form-container {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: none;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #172d25;
  margin-bottom: 10rpx;
  font-weight: 500;
}

/* 多选框组样式 */
.checkbox-group {
  display: flex;
  gap: 30rpx;
  padding: 10rpx 0;
}

.checkbox-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #172d25;
}

.checkbox-item checkbox {
  margin-right: 10rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #172d25;
  box-sizing: border-box;
}

.readonly-value {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
}

.placeholder {
  color: #687a71;
}

.location-wrapper {
  display: flex;
  align-items: center;
}

.region-input {
  flex: 1;
}

.location-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f7f5;
  border-radius: 22rpx;
  margin-left: 20rpx;
}

.location-icon {
  font-size: 40rpx;
}

.tips {
  background-color: #eff7f1;
  padding: 20rpx;
  border-radius: 22rpx;
  margin-bottom: 40rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #16835c;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tips-content {
  font-size: 24rpx;
  color: #687a71;
}

.tips-content text {
  display: block;
  margin-bottom: 6rpx;
}

.submit-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
  font-weight: 500;
}

.submit-btn.disabled {
  background: #16835c;
  color: #fff;
  opacity: .5;
}

.reject-reason {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: none;
}

.reason-title {
  font-size: 28rpx;
  color: #172d25;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.reason-content {
  font-size: 28rpx;
  color: #b74434;
  padding: 20rpx;
  background-color: #faf0ed;
  border-radius: 22rpx;
  margin-bottom: 30rpx;
}

.reapply-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  border-radius: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 500;
}
.reapply-btn.disabled {
  background: #16835c;
  color: #fff;
  opacity: .5;
}


.pending-container {
  background-color: #fff;
  border-radius: 22rpx;
  padding: 60rpx 30rpx;
  box-shadow: none;
  text-align: center;
}

.pending-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.pending-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

.pending-desc {
  font-size: 28rpx;
  color: #687a71;
  margin-bottom: 30rpx;
}


/* 新增：证件上传列表 */
.cert-upload-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f5f7f5;
  padding: 30rpx;
  border-radius: 22rpx;
  margin-bottom: 20rpx;
}

.cert-info {
  display: flex;
  align-items: center;
}

.cert-name {
  font-size: 30rpx;
  color: #172d25;
  font-weight: 500;
  margin-right: 20rpx;
}

.cert-status {
  font-size: 24rpx;
  color: #687a71;
  background-color: #e9efeb;
  padding: 4rpx 12rpx;
  border-radius: 22rpx;
}

.cert-status.done {
  color: #16835c;
  background-color: #eff7f1;
  border: 1rpx solid #e9efeb;
}

.arrow {
  font-family: "SimSun", sans-serif; /* Use font that supports > well or simple arrow icon */
  color: #687a71;
  font-weight: 600;
}

/* 特种作业操作证单选组样式 */
.cert-type-group {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.cert-type-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #172d25;
}

.cert-type-item radio {
  margin-right: 8rpx;
}

.cert-type-gap {
  width: 60rpx;
}

/* 认证须知勾选样式 */
.cert-notice-agreement {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.notice-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #687a71;
}

.notice-label checkbox {
  margin-right: 10rpx;
}

.notice-link {
  color: #16835c;
  margin-left: 6rpx;
}


/* UI1.1：页面布局及状态精调。 */
.container { padding: 32rpx 44rpx 48rpx; } .form-container, .reject-reason { border: none; padding: 0; box-shadow: none; } .form-group { margin-bottom: 28rpx; } .header { text-align: left; margin-bottom: 32rpx; } .region-input { height: auto; min-height: 96rpx; padding: 20rpx 24rpx; } .location-wrapper { align-items: stretch; gap: 16rpx; } .location-wrapper picker { flex: 1; min-width: 0; } .location-btn { width: 88rpx; min-height: 96rpx; height: auto; margin: 0; border-radius: 22rpx; background: #eff7f1; flex-shrink: 0; } .location-icon.ui-icon { width: 36rpx; height: 36rpx; } .checkbox-group, .cert-type-group { flex-wrap: wrap; gap: 16rpx 24rpx; } .cert-type-gap { display: none; } .cert-upload-item, .license-upload { box-sizing: border-box; border: 2rpx solid #e9efeb; border-radius: 22rpx; } .cert-info { flex-wrap: wrap; gap: 8rpx; min-width: 0; } .cert-name { margin: 0; font-size: 28rpx; } .tips { border-radius: 22rpx; background: #f5f7f5; } .tips-title { color: #172d25; } .submit-btn, .reapply-btn { height: auto; min-height: 96rpx; padding: 20rpx 24rpx; line-height: 1.6; font-size: 30rpx; border-radius: 22rpx; background: #16835c; color: #fff; } .submit-btn.disabled, .reapply-btn.disabled { background: #16835c; opacity: .5; } .upload-icon.ui-icon { width: 56rpx; height: 56rpx; margin: 0 auto 16rpx; }
