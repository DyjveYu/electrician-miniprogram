@import "../../../styles/clean-surfaces.wxss";

.about-container {
  min-height: 100vh;
  background-color: #fff;
  padding-bottom: 40rpx;
}

/* 品牌区 */
.brand-section {
  background: #eff7f1;
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #172d25;
  color: #172d25;
}

.brand-logo {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: #687a71;
}

/* 内容卡片 */
.content-card {
  background-color: #ffffff;
  margin: 24rpx 30rpx;
  border-radius: 22rpx;
  box-shadow: none;
  padding: 36rpx 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #16835c;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: #16835c;
  border-radius: 22rpx;
}

.card-body {
  line-height: 1.8;
}

.body-text {
  font-size: 28rpx;
  color: #172d25;
  line-height: 1.8;
}

/* 使用流程步骤条 */
.workflow {
  padding-top: 10rpx;
}

.step-item {
  display: flex;
  align-items: stretch;
}

.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60rpx;
  flex-shrink: 0;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #16835c;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-line {
  width: 2rpx;
  flex: 1;
  min-height: 20rpx;
  background-color: #e9efeb;
  margin: 6rpx 0;
}

.step-right {
  padding-left: 24rpx;
  padding-bottom: 36rpx;
  display: flex;
  align-items: center;
}

.step-label {
  font-size: 28rpx;
  color: #172d25;
}

/* 底部版本信息 */
.footer-info {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #687a71;
}


/* UI1.1：页面布局及状态精调。 */
.about-container { padding: 32rpx 44rpx; } .brand-section { margin: 0 0 32rpx; padding: 40rpx 28rpx; border-radius: 26rpx; background: #eff7f1; color: #172d25; } .brand-name { color: #172d25; } .content-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; } .body-text { font-size: 28rpx; line-height: 1.9; } .step-right { min-width: 0; } .step-circle { background: #16835c; color: #fff; }
