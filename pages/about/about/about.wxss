.about-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 品牌区 */
.brand-section {
  background: linear-gradient(135deg, #0F9D58 0%, #0bb84d 100%);
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.brand-logo {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 内容卡片 */
.content-card {
  background-color: #ffffff;
  margin: 24rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 36rpx 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F9D58;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: #0F9D58;
  border-radius: 3rpx;
}

.card-body {
  line-height: 1.8;
}

.body-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

/* 使用流程步骤条 */
.workflow {
  padding-top: 10rpx;
}

.step-item {
  display: flex;
  align-items: stretch;
}

.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60rpx;
  flex-shrink: 0;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #0F9D58;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-line {
  width: 2rpx;
  flex: 1;
  min-height: 20rpx;
  background-color: #e0e0e0;
  margin: 6rpx 0;
}

.step-right {
  padding-left: 24rpx;
  padding-bottom: 36rpx;
  display: flex;
  align-items: center;
}

.step-label {
  font-size: 28rpx;
  color: #333333;
}

/* 底部版本信息 */
.footer-info {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
}
