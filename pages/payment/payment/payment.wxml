  <!-- 支付金额 -->
  <view class="amount-section">
    <view class="amount-label">{{projectPrepay ? (offsitePayment && order.pricing_mode !== 'fixed_price' ? '工程订单押金' : '工程总费用（含15%平台使用费）') : '支付金额'}}</view>
    <view class="amount-value">¥{{payAmount || 0}}</view>
  </view>

  <!-- 自动拉起提示 -->
  <view class="payment-section">
    <view class="section-title">微信支付</view>
    <view class="auto-tip">{{loadError || (personalPrepay ? (unknownResult ? '支付结果尚未确认，请查询原订单，不要重复付款。' : '请阅读预付款协议并主动勾选同意后付款。') : '请在弹出的支付框中完成操作。如支付失败，可在订单详情页重新支付。')}}</view>
  </view>

  <!-- 支付按钮 -->
  <view class="pay-section">
    <button 
      class="pay-btn {{paying ? 'disabled' : ''}}"
      bindtap="startPayment"
      disabled="{{paying}}"
    >
      {{paying ? '处理中...' : (unknownResult ? '查询支付结果' : (orderLoaded ? '去支付' : '重新加载订单'))}}
    </button>
  </view>
  <view class="pay-section" wx:if="{{unknownResult}}">
    <button bindtap="goToOrder">查看原订单</button>
  </view>
</view>
<order-prepay project-price="{{order.project_billing}}" pricing-mode="{{order.pricing_mode}}" offsite="{{offsitePayment}}" visible="{{showPrepay}}" order-id="{{orderId}}" amount="{{prepayDisplayAmount}}" project="{{projectPrepay}}" bind:confirm="confirmPrepay" bind:close="goToOrder" />
