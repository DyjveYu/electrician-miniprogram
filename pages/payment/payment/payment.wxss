@import "../../../styles/clean-surfaces.wxss";
/* pages/payment/payment/payment.wxss */
.container {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #172d25;
  margin-bottom: 20rpx;
}

/* 订单信息 */
.order-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 22rpx;
}

.order-info {
  border-top: 2rpx solid #e9efeb;
  padding-top: 20rpx;
}

.order-row {
  display: flex;
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

.order-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #687a71;
  width: 160rpx;
}

.value {
  color: #172d25;
  flex: 1;
}

/* 支付金额 */
.amount-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 40rpx 30rpx;
  border-radius: 22rpx;
  text-align: center;
}

.amount-label {
  font-size: 28rpx;
  color: #687a71;
  margin-bottom: 15rpx;
}

.amount-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #16835c;
}

/* 支付方式 */
.payment-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 22rpx;
}

.payment-methods {
  border-top: 2rpx solid #e9efeb;
  padding-top: 20rpx;
}

.payment-method {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 2rpx solid #f5f7f5;
  transition: background-color 0.3s;
}

.payment-method:last-child {
  border-bottom: none;
}

.payment-method.selected {
  background-color: #eff7f1;
}

.method-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: 28rpx;
  color: #172d25;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.method-desc {
  font-size: 24rpx;
  color: #687a71;
}

.method-radio {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #e9efeb;
  border-radius: 50%;
  transition: all 0.3s;
}

.radio.checked {
  border-color: #16835c;
  background-color: #16835c;
  position: relative;
}

.radio.checked::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background-color: #fff;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 支付按钮 */
.pay-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #fff;
  border-top: 2rpx solid #e9efeb;
}

.pay-btn {
  width: 100%;
  height: auto;
  background: #16835c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-btn.disabled {
  background-color: #bdbdbd;
  color: #687a71;
}

.pay-btn::after {
  border: none;
}

/* 自动拉起提示文案 */
.auto-tip {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #687a71;
}

/* UI1.1：页面布局及状态精调。 */
.amount-section { background: #eff7f1; border-radius: 26rpx; padding: 48rpx 24rpx; margin-bottom: 28rpx; } .amount-value { color: #16835c; word-break: break-all; } .payment-section, .order-section { margin: 0 0 24rpx; padding: 28rpx 24rpx; } .auto-tip { color: #687a71; line-height: 1.9; } .pay-section { padding: 20rpx 0; } .pay-btn { width: 100%; height: auto; border-radius: 22rpx; line-height: 1.6; padding: 20rpx 24rpx; background: #16835c; color: #fff; }
